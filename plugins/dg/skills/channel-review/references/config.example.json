{
	"env": { "default": "dev" },
	"envs": {
		"dev": {
			"baseUrl": "https://relay.example.test/api",
			"awsProfile": "example-dev",
			"botName": "Review Bot (Dev)"
		},
		"prod": {
			"baseUrl": "https://relay.example.test/prod/api",
			"awsProfile": "example-prod",
			"botName": "Review Bot"
		}
	},
	"chats": [{ "topic": "Team Reviews" }, { "id": "19:aaa@thread.v2" }],
	"owner": {
		"token": "!owner",
		"email": "owner@example.com",
		"senderIds": []
	},
	"relay": {
		"appName": "review-bot",
		"secret": {
			"id": "relay/chat",
			"key": "RELAY__CHAT__SECRET",
			"region": "us-east-1"
		}
	},
	"runner": { "default": "claude" },
	"hosts": { "github": [], "gitlab": [] },
	"errorWatch": {
		"enabled": false,
		"pollMinutes": 5,
		"providers": {
			"datadog": { "enabled": false, "services": { "include": ["example-api"] } },
			"sentry": { "enabled": false, "projects": { "include": ["example-project"] } }
		},
		"repos": {
			"example-api": { "repo": "github.com/example-org/example-api" }
		},
		"autoFix": { "enabled": true, "maxPerHour": 2 }
	},
	"deps": {
		"enabled": false,
		"cooldownDays": 7,
		"schedule": { "every": "week", "day": "mon", "window": "02:00-05:00" },
		"repos": [{ "repo": "github.com/example-org/example-api" }]
	}
}
