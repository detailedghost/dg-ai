---

interface Props {
  variants: string[];
  current: string;
  prototypeName: string;
  /** Human descriptions for each variant key — shown in the bar and notes panel. */
  labels?: Record<string, string>;
  /** App basePath prefixed to the confirm and reload-token fetch URLs. */
  basePath?: string;
  /** Quick-pick reasons shown as chips in the (required) reject-note popup. */
  rejectReasons?: string[];
}

const DEFAULT_REJECT_REASONS = [
  "Doesn't fit the use case",
  "Too cluttered / busy",
  "Wrong layout or hierarchy",
  "None of these — go more radical",
  "Close, but needs tweaks",
];

const {
  variants,
  current,
  prototypeName,
  labels = {},
  basePath = "",
  rejectReasons = DEFAULT_REJECT_REASONS,
} = Astro.props;

if (import.meta.env.PROD) {
  return;
}
---

<div id="prototype-switcher"></div>

<script is:inline define:vars={{ variants, current, prototypeName, labels, basePath, rejectReasons }}>
  (function () {

    var css = `
      @keyframes ps-burst { 0%{transform:translate(0,0) rotate(0);opacity:1} 100%{transform:translate(var(--dx),var(--dy)) rotate(var(--rot));opacity:0} }
      @keyframes ps-glow { 0%,100%{box-shadow:0 0 0 8px rgba(34,197,94,.16),0 10px 40px rgba(34,197,94,.35)} 50%{box-shadow:0 0 0 14px rgba(34,197,94,.06),0 10px 60px rgba(34,197,94,.6)} }
      @keyframes ps-pop { 0%{transform:scale(.3);opacity:0} 100%{transform:scale(1);opacity:1} }
      @keyframes ps-draw { to { stroke-dashoffset:0 } }
      #ps-bar {
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
        z-index: 9999; display: flex; align-items: center; gap: 8px;
        background: linear-gradient(135deg,#1b2440 0%,#241a3a 55%,#3a1730 100%);
        color: #fff; border-radius: 16px; border: 1px solid rgba(120,140,255,.35);
        padding: 8px 16px; box-shadow: 0 6px 28px rgba(60,40,120,.55);
        font-family: system-ui, sans-serif; font-size: 14px;
        user-select: none; white-space: nowrap;
      }
      #ps-bar button {
        background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.2);
        color: #fff; border-radius: 8px; padding: 4px 10px;
        cursor: pointer; font-size: 14px; line-height: 1;
        transition: filter .15s ease, transform .15s ease;
      }
      #ps-bar button:hover { filter: brightness(1.18); transform: translateY(-1px); }
      #ps-prev, #ps-next {
        background: linear-gradient(135deg,#4c8dff,#6f5cff); border-color: transparent; font-weight: 700;
      }
      #ps-label {
        border-radius: 999px; padding: 4px 12px;
      }
      #ps-notes-btn { margin-left: 8px; font-weight: 600; border-color: transparent; background: linear-gradient(135deg,#f59e0b,#f97316); }
      #ps-notes-btn.has-notes { background: linear-gradient(135deg,#0d9488,#14b8a6); box-shadow: 0 0 0 2px rgba(20,184,166,.55), 0 0 14px rgba(20,184,166,.4); }
      #ps-notes-btn.active { outline: 2px solid rgba(255,255,255,.5); }
      #ps-approve-btn { background: linear-gradient(135deg,#16a34a,#22c55e); border-color: transparent; font-weight: 700; }
      #ps-reject-btn  { background: linear-gradient(135deg,#e11d48,#b45309); border-color: transparent; font-weight: 700; }
      .ps-confetti-particle {
        position: fixed; top: 38vh; left: 50%; width: 10px; height: 14px;
        border-radius: 2px; pointer-events: none; z-index: 10001;
        animation: ps-burst .9s ease-out forwards;
      }
      #ps-check-badge {
        width: 96px; height: 96px; border-radius: 50%;
        background: linear-gradient(135deg,#16a34a,#22c55e);
        display: flex; align-items: center; justify-content: center;
        animation: ps-pop .4s ease, ps-glow 2s ease-in-out .4s infinite;
      }
      #ps-check-badge path {
        stroke-dasharray: 48; stroke-dashoffset: 48; animation: ps-draw .5s .25s ease forwards;
      }
      #ps-overlay-notes {
        font-style: italic; border-left: 3px solid #22c55e; padding-left: 12px; text-align: left;
      }
      #ps-notes-panel {
        position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
        z-index: 9999; width: 420px; max-width: 90vw;
        background: #111; color: #fff; border-radius: 12px;
        padding: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.45);
        font-family: system-ui, sans-serif; font-size: 13px; display: none;
      }
      #ps-notes-panel.visible { display: block; }
      #ps-notes-panel textarea {
        width: 100%; box-sizing: border-box; background: #1b1b1b; color: #fff;
        border: 1px solid #333; border-radius: 6px; padding: 8px;
        font-family: system-ui, sans-serif; font-size: 13px; resize: vertical;
      }
      #ps-rework-banner {
        display: none; position: fixed; bottom: 80px; left: 50%;
        transform: translateX(-50%); z-index: 9999;
        width: 460px; max-width: 92vw;
        background: #3a2a0a; color: #fde68a; border: 1px solid #b45309;
        border-radius: 12px; padding: 10px 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,.45);
        font-family: system-ui, sans-serif; font-size: 13px; line-height: 1.4;
      }
      #ps-rework-banner.visible { display: block; }
      #ps-overlay {
        display: none; position: fixed; inset: 0; z-index: 10000;
        background: radial-gradient(120% 120% at 50% 0%, #10371f 0%, rgba(8,12,16,.98) 60%);
        color: #fff;
        flex-direction: column; align-items: center; justify-content: center;
        gap: 16px; font-family: system-ui, sans-serif;
      }
      #ps-overlay.visible { display: flex; }
      #ps-reject-panel {
        display: none; position: fixed; bottom: 80px; left: 50%;
        transform: translateX(-50%); z-index: 9999;
        width: 440px; max-width: 92vw;
        background: #111; color: #fff; border: 1px solid #b45309;
        border-radius: 12px; padding: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.45);
        font-family: system-ui, sans-serif; font-size: 13px;
      }
      #ps-reject-panel.visible { display: block; }
      #ps-reject-panel textarea {
        width: 100%; box-sizing: border-box; background: #1b1b1b; color: #fff;
        border: 1px solid #333; border-radius: 6px; padding: 8px;
        font-family: system-ui, sans-serif; font-size: 13px; resize: vertical;
      }
      .ps-chip {
        background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.25);
        color: #fff; border-radius: 999px; padding: 4px 10px;
        cursor: pointer; font-size: 12px; line-height: 1.2;
      }
    `;
    var style = document.createElement("style");
    style.textContent = css;
    document.head.appendChild(style);

    var root = document.getElementById("prototype-switcher");
    if (!root) return;

    root.innerHTML = `
      <div id="ps-reject-panel">
        <div id="ps-reject-header" style="margin-bottom:8px;font-weight:600;font-size:14px"></div>
        <div id="ps-reject-chips" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px"></div>
        <textarea id="ps-reject-area" rows="3"
          placeholder="Pick a reason above or type your own — e.g. 'omnibar is closest but keep Add as a real button'"
        ></textarea>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px">
          <button type="button" id="ps-reject-clear"
            style="background:transparent;border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px">
            Clear
          </button>
          <button type="button" id="ps-reject-cancel"
            style="background:transparent;border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px">
            Cancel
          </button>
          <button type="button" id="ps-reject-submit"
            style="background:#b45309;border:1px solid #d97706;color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px"
            disabled>
            Reject ⟲
          </button>
        </div>
        <div id="ps-reject-error" style="color:#f87171;margin-top:6px;font-size:12px;display:none"></div>
      </div>
      <div id="ps-notes-panel">
        <div id="ps-notes-header" style="margin-bottom:10px;font-weight:600;font-size:14px"></div>
        <label for="ps-notes-area" style="display:block;margin-bottom:4px;opacity:.7;font-size:12px">
          Optional — applies to whichever you click next, Approve or Reject
        </label>
        <textarea id="ps-notes-area" rows="3"
          placeholder="e.g. 'C outlines but keep Add filled like B', or for Reject: 'all too loud, try flatter neutral secondaries'"
        ></textarea>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:10px">
          <button type="button" id="ps-notes-clear">Clear</button>
          <button type="button" id="ps-notes-done">Done</button>
        </div>
      </div>
      <div id="ps-rework-banner">
        <span style="font-weight:600">⟲ Reworking options…</span>
        <span id="ps-rework-msg"></span>
        Keep this tab open — it refreshes when new options are ready.
        <button type="button" id="ps-rework-dismiss"
          style="background:transparent;border:1px solid rgba(255,255,255,.25);color:#fde68a;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px;margin-left:10px">
          Dismiss
        </button>
      </div>
      <div id="ps-bar">
        <button type="button" id="ps-mode" title="Toggle light/dark"></button>
        <span style="width:1px;height:18px;background:rgba(255,255,255,.2)"></span>
        <button type="button" id="ps-prev" title="Previous variant">←</button>
        <span id="ps-label" style="min-width:90px;max-width:280px;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
        <button type="button" id="ps-next" title="Next variant">→</button>
        <span style="width:1px;height:18px;background:rgba(255,255,255,.2);margin-left:4px"></span>
        <button type="button" id="ps-notes-btn" title="Add notes for your decision">📝 Notes</button>
        <button type="button" id="ps-approve-btn" title="Approve this variant">Approve ✓</button>
        <button type="button" id="ps-reject-btn" title="Reject all — ask for new options (note required)">Reject ⟲</button>
        <span id="ps-error" style="color:#f87171;margin-left:8px;font-size:12px;display:none"></span>
      </div>
      <div id="ps-overlay">
        <div id="ps-check-badge">
          <svg viewBox="0 0 52 52" width="52" height="52" aria-hidden="true">
            <path fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" d="M14 27 l8 8 l16 -18"/>
          </svg>
        </div>
        <div id="ps-overlay-msg" style="font-size:24px;font-weight:700"></div>
        <div id="ps-overlay-notes" style="font-size:14px;opacity:.85;max-width:420px;display:none"></div>
        <div style="font-size:16px;opacity:.7">You may close this tab.</div>
        <button type="button" id="ps-close"
          style="background:transparent;border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;font-size:14px">
          Close tab
        </button>
      </div>
    `;

    var labelEl        = document.getElementById("ps-label");
    var errorEl        = document.getElementById("ps-error");
    var overlay        = document.getElementById("ps-overlay");
    var overlayMsg     = document.getElementById("ps-overlay-msg");
    var overlayNotes   = document.getElementById("ps-overlay-notes");
    var reworkBanner   = document.getElementById("ps-rework-banner");
    var reworkMsg      = document.getElementById("ps-rework-msg");
    var notesPanel     = document.getElementById("ps-notes-panel");
    var notesHeader    = document.getElementById("ps-notes-header");
    var notesArea      = document.getElementById("ps-notes-area");
    var notesClear     = document.getElementById("ps-notes-clear");
    var notesDone      = document.getElementById("ps-notes-done");
    var notesBtnEl     = document.getElementById("ps-notes-btn");
    var approveBtn     = document.getElementById("ps-approve-btn");
    var rejectBtn      = document.getElementById("ps-reject-btn");
    var modeBtn        = document.getElementById("ps-mode");
    var rejectPanel    = document.getElementById("ps-reject-panel");
    var rejectHeader   = document.getElementById("ps-reject-header");
    var rejectChips    = document.getElementById("ps-reject-chips");
    var rejectArea     = document.getElementById("ps-reject-area");
    var rejectClear    = document.getElementById("ps-reject-clear");
    var rejectCancel   = document.getElementById("ps-reject-cancel");
    var rejectSubmit   = document.getElementById("ps-reject-submit");
    var rejectErrorEl  = document.getElementById("ps-reject-error");

    var activeCurrent = current;
    var notesOpen = false;
    var rejectOpen = false;
    var submitting = false;

    var VARIANT_HUES = ["#4c8dff", "#a855f7", "#22c55e", "#f59e0b", "#f43f5e", "#14b8a6"];
    var CONFETTI_COLORS = ["#22c55e", "#4c8dff", "#a855f7", "#f59e0b", "#f43f5e", "#14b8a6"];

    function hueForKey(key) {
      var idx = variants.indexOf(key);
      var n = VARIANT_HUES.length;
      return VARIANT_HUES[((idx % n) + n) % n];
    }

    var FAVICON_EMOJI = { waiting: "⏳", processing: "🔄", done: "✅" };

    function faviconHref(state) {
      var emoji = FAVICON_EMOJI[state];
      return (
        "data:image/svg+xml," +
        encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">' +
          '<text x="50" y="54" font-size="80" text-anchor="middle" dominant-baseline="central">' +
          emoji +
          "</text></svg>"
        )
      );
    }

    function setFavicon(state) {
      var link = document.querySelector("link[rel='icon']");
      if (!link) {
        link = document.createElement("link");
        link.rel = "icon";
        document.head.appendChild(link);
      }
      link.href = faviconHref(state);
    }

    setFavicon("waiting");

    function readMode() {
      return new URLSearchParams(window.location.search).get("mode") === "dark" ? "dark" : "light";
    }

    function syncMode() {
      var m = readMode();
      document.documentElement.classList.toggle("dark", m === "dark");
      if (modeBtn) modeBtn.textContent = m === "dark" ? "☀ Light" : "☾ Dark";
    }

    syncMode();
    window.addEventListener("popstate", syncMode);

    if (modeBtn) {
      modeBtn.addEventListener("click", function () {
        var next = readMode() === "dark" ? "light" : "dark";
        var url = new URL(window.location.href);
        url.searchParams.set("mode", next);
        history.replaceState(null, "", url.toString());
        window.dispatchEvent(new PopStateEvent("popstate"));
      });
    }

    function renderLabel(key) {
      if (!labelEl) return;
      var desc = labels && labels[key];
      var hue = hueForKey(key);
      labelEl.style.background = hue + "22";
      labelEl.style.border = "1px solid " + hue;
      var html =
        '<span style="opacity:.6">' + prototypeName + "</span>" +
        '<span style="margin:0 6px;opacity:.4">·</span>' +
        "<strong>" + key + "</strong>";
      if (desc) {
        html +=
          '<span style="opacity:.55;font-weight:400;margin-left:6px;font-size:12px">— ' +
          desc + "</span>";
      }
      labelEl.innerHTML = html;
    }

    function renderNotesHeader(key) {
      if (!notesHeader) return;
      var desc = labels && labels[key];
      var html = "Notes for variant <strong>" + key + "</strong>";
      if (desc) {
        html += '<span style="font-weight:400;opacity:.75"> — ' + desc + "</span>";
      }
      notesHeader.innerHTML = html;
    }

    function renderNotesBtn() {
      if (!notesBtnEl || !notesArea) return;
      var hasNotes = notesArea.value.trim().length > 0;
      notesBtnEl.textContent = hasNotes ? "📝 Note added ✓" : "📝 Notes";
      notesBtnEl.classList.toggle("has-notes", hasNotes);
      notesBtnEl.classList.toggle("active", notesOpen);
    }

    function renderRejectHeader(key) {
      if (!rejectHeader) return;
      rejectHeader.innerHTML =
        "Why reject variant <strong>" + key + "</strong>?" +
        ' <span style="font-weight:400;color:#fca5a5">(required — it\'s how I rework)</span>';
    }

    function syncRejectSubmit() {
      if (!rejectSubmit || !rejectArea) return;
      rejectSubmit.disabled = rejectArea.value.trim().length === 0;
    }

    function addReason(r) {
      if (!rejectArea) return;
      var lines = rejectArea.value.split("\n").map(function (s) { return s.trim(); });
      if (lines.indexOf(r) !== -1) return;
      rejectArea.value = rejectArea.value ? rejectArea.value + "\n" + r : r;
      syncRejectSubmit();
    }

    function buildChips() {
      if (!rejectChips) return;
      rejectChips.innerHTML = "";
      rejectReasons.forEach(function (r) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "ps-chip";
        btn.textContent = "+ " + r;
        btn.addEventListener("click", function () { addReason(r); });
        rejectChips.appendChild(btn);
      });
    }

    function openRejectPanel() {
      notesOpen = false;
      if (notesPanel) notesPanel.classList.remove("visible");
      renderNotesBtn();

      rejectOpen = true;
      renderRejectHeader(activeCurrent);
      buildChips();
      if (notesArea && rejectArea && !rejectArea.value && notesArea.value.trim()) {
        rejectArea.value = notesArea.value;
      }
      syncRejectSubmit();
      if (rejectPanel) rejectPanel.classList.add("visible");
      if (rejectArea) rejectArea.focus();
    }

    function closeRejectPanel() {
      rejectOpen = false;
      if (rejectPanel) rejectPanel.classList.remove("visible");
    }

    renderLabel(activeCurrent);
    renderNotesHeader(activeCurrent);
    renderRejectHeader(activeCurrent);
    buildChips();
    renderNotesBtn();

    function getIdx() {
      return variants.indexOf(activeCurrent);
    }

    function go(key) {
      activeCurrent = key;
      renderLabel(key);
      renderNotesHeader(key);
      renderRejectHeader(key);
      var url = new URL(window.location.href);
      url.searchParams.set("variant", key);
      history.replaceState(null, "", url.toString());
      window.dispatchEvent(new PopStateEvent("popstate"));
    }

    document.getElementById("ps-prev").addEventListener("click", function () {
      var idx = getIdx();
      go(variants[(idx - 1 + variants.length) % variants.length]);
    });

    document.getElementById("ps-next").addEventListener("click", function () {
      var idx = getIdx();
      go(variants[(idx + 1) % variants.length]);
    });

    document.addEventListener("keydown", function (e) {
      var tag = e.target.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || e.target.isContentEditable) return;
      if (e.key === "ArrowLeft") {
        var idx = getIdx();
        go(variants[(idx - 1 + variants.length) % variants.length]);
      }
      if (e.key === "ArrowRight") {
        var idx = getIdx();
        go(variants[(idx + 1) % variants.length]);
      }
    });

    if (notesArea) {
      notesArea.addEventListener("input", function () { renderNotesBtn(); });
    }

    if (notesBtnEl) {
      notesBtnEl.addEventListener("click", function () {
        notesOpen = !notesOpen;
        if (notesOpen) {
          closeRejectPanel();
        }
        if (notesPanel) {
          if (notesOpen) {
            notesPanel.classList.add("visible");
          } else {
            notesPanel.classList.remove("visible");
          }
        }
        renderNotesBtn();
        if (notesOpen && notesArea) notesArea.focus();
      });
    }

    if (notesClear) {
      notesClear.addEventListener("click", function () {
        if (notesArea) notesArea.value = "";
        renderNotesBtn();
      });
    }

    if (notesDone) {
      notesDone.addEventListener("click", function () {
        notesOpen = false;
        if (notesPanel) notesPanel.classList.remove("visible");
        renderNotesBtn();
      });
    }

    function closeTab() {
      try { window.open("", "_self"); } catch (_) {}
      window.close();
    }

    function confettiBurst() {
      for (var i = 0; i < 28; i++) {
        var angle = (2 * Math.PI * i) / 28 + (i % 3) * 0.12;
        var dist = 160 + (i % 5) * 44;
        var dx = Math.cos(angle) * dist;
        var dy = Math.sin(angle) * dist - 40;
        var rot = i * 47;
        var el = document.createElement("div");
        el.className = "ps-confetti-particle";
        el.style.setProperty("--dx", dx + "px");
        el.style.setProperty("--dy", dy + "px");
        el.style.setProperty("--rot", rot + "deg");
        el.style.background = CONFETTI_COLORS[i % CONFETTI_COLORS.length];
        el.style.animationDelay = (i % 6) * 0.03 + "s";
        document.body.appendChild(el);
        (function (particle) {
          setTimeout(function () { particle.remove(); }, 1200);
        })(el);
      }
    }

    function showConfirmOverlay() {
      var notes = notesArea ? notesArea.value.trim() : "";
      if (overlayMsg) overlayMsg.textContent = "Selected variant " + activeCurrent;
      if (overlayNotes) {
        if (notes) {
          overlayNotes.textContent = "“" + notes + "”";
          overlayNotes.style.display = "";
        } else {
          overlayNotes.style.display = "none";
        }
      }
      if (overlay) overlay.classList.add("visible");
      confettiBurst();
    }

    function showReworkBanner(hadNotes) {
      if (reworkMsg) {
        reworkMsg.textContent = hadNotes
          ? " Your reject was sent with notes. "
          : " Your reject was sent. ";
      }
      if (reworkBanner) reworkBanner.classList.add("visible");
    }

    function setDecisionBtns(disabled) {
      if (approveBtn) {
        approveBtn.textContent = disabled ? "…" : "Approve ✓";
        approveBtn.disabled = disabled;
      }
      if (rejectBtn) {
        rejectBtn.textContent = disabled ? "…" : "Reject ⟲";
        rejectBtn.disabled = disabled;
      }
    }

    function onSuccess(action, hadNotes, closeAfter) {
      if (action === "confirm") {
        setFavicon("done");
        showConfirmOverlay();
        if (closeAfter) setTimeout(closeTab, 2200);
      } else {
        setFavicon("processing");
        showReworkBanner(hadNotes);
      }
    }

    function submit(action) {
      if (submitting) return;
      submitting = true;
      if (errorEl) { errorEl.style.display = "none"; errorEl.textContent = ""; }
      setDecisionBtns(true);

      var notes = notesArea ? notesArea.value : "";
      var hadNotes = notes.trim().length > 0;
      var closeAfter = action === "confirm" && !hadNotes;

      var url = window.location.origin + basePath + "/prototype-confirm";
      var payload = JSON.stringify({
        name: prototypeName,
        variant: activeCurrent,
        variants: variants,
        notes: notes,
        action: action,
      });

      var queued = false;
      try {
        queued =
          typeof navigator.sendBeacon === "function" &&
          navigator.sendBeacon(url, new Blob([payload], { type: "application/json" }));
      } catch (_) {
        queued = false;
      }

      if (queued) {
        submitting = false;
        setDecisionBtns(false);
        onSuccess(action, hadNotes, closeAfter);
        return;
      }

      fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: payload })
        .then(function (res) {
          if (!res.ok) {
            return res.json().catch(function () { return {}; }).then(function (body) {
              if (errorEl) {
                errorEl.textContent = body.error || "HTTP " + res.status;
                errorEl.style.display = "";
              }
              submitting = false;
              setDecisionBtns(false);
            });
          }
          submitting = false;
          setDecisionBtns(false);
          onSuccess(action, hadNotes, closeAfter);
        })
        .catch(function (err) {
          if (errorEl) {
            errorEl.textContent = (err && err.message) || "Network error";
            errorEl.style.display = "";
          }
          submitting = false;
          setDecisionBtns(false);
        });
    }

    if (approveBtn) approveBtn.addEventListener("click", function () { submit("confirm"); });

    if (rejectBtn) {
      rejectBtn.addEventListener("click", function () {
        if (rejectOpen) { closeRejectPanel(); } else { openRejectPanel(); }
      });
    }

    if (rejectArea) {
      rejectArea.addEventListener("input", function () { syncRejectSubmit(); });
    }

    if (rejectClear) {
      rejectClear.addEventListener("click", function () {
        if (rejectArea) rejectArea.value = "";
        syncRejectSubmit();
      });
    }

    if (rejectCancel) {
      rejectCancel.addEventListener("click", function () { closeRejectPanel(); });
    }

    if (rejectSubmit) {
      rejectSubmit.addEventListener("click", function () {
        if (rejectErrorEl) { rejectErrorEl.style.display = "none"; rejectErrorEl.textContent = ""; }
        if (notesArea && rejectArea) notesArea.value = rejectArea.value;
        submit("reject");
        closeRejectPanel();
      });
    }

    var closeBtn = document.getElementById("ps-close");
    if (closeBtn) closeBtn.addEventListener("click", function () { closeTab(); });

    var dismissBtn = document.getElementById("ps-rework-dismiss");
    if (dismissBtn) {
      dismissBtn.addEventListener("click", function () {
        if (reworkBanner) reworkBanner.classList.remove("visible");
      });
    }

    var reloadUrl = window.location.origin + basePath + "/prototype-reload";
    var lastToken = null;
    var pollActive = true;

    function pollReload() {
      if (!pollActive) return;
      fetch(reloadUrl, { method: "GET", cache: "no-store" })
        .then(function (res) {
          if (!res.ok) {
            pollActive = false;
            return null;
          }
          return res.text();
        })
        .then(function (token) {
          if (token === null || !pollActive) return;
          var t = token.trim();
          if (lastToken === null) {
            lastToken = t;
          } else if (t !== lastToken) {
            pollActive = false;
            location.reload();
          }
        })
        .catch(function () {
          pollActive = false;
        });
    }

    pollReload();
    var reloadTimer = setInterval(function () {
      if (!pollActive) { clearInterval(reloadTimer); return; }
      pollReload();
    }, 2000);
  })();
</script>
