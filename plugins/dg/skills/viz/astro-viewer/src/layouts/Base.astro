---
import Icon from '../components/Icon.astro'
import type { TocItem, WaitingItem } from '../types'

interface Props {
  title: string
  subtitle?: string
  template?: string
  date?: string
  toc?: TocItem[]
  waiting?: WaitingItem[]
  sessionId?: string
  /** Review boards own full-bleed chrome with no "caught up" concept — hide the Activity rail. */
  hideWaiting?: boolean
  /** Same reason as hideWaiting: review boards end at the verdict bar, so no page footer under it. */
  hideFooter?: boolean
  /** Read-only explainer/diagnosis boards (payload.static === true) — skip the live-refresh poller. */
  isStatic?: boolean
}
const {
  title,
  subtitle,
  template,
  date,
  toc = [],
  waiting = [],
  sessionId,
  hideWaiting = false,
  hideFooter = false,
  isStatic = false,
} = Astro.props

function waitingKindLabel(w: WaitingItem): string {
  if (w.kind === 'open_question') return 'Open question'
  if (w.kind === 'approval') return 'Gate'
  if (w.kind === 'permission') return 'Permissions'
  if (w.kind === 'recommendation') return 'Triage'
  if (w.kind === 'next_steps') return 'Next steps'
  if (w.inDiscussion) return 'Decision · discussing'
  return 'Decision'
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script is:inline>
      // Resolve theme before first paint to prevent FOUC.
      (function () {
        var stored = localStorage.getItem('viz-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-ground font-body text-ink antialiased">
    <div id="viz-top" class="px-4 py-6 sm:px-6 sm:py-10">
      <header class="mb-8 sm:mb-10">
        <div class="mb-3 flex items-center gap-3">
          {template !== 'system' && (
            <a
              href="/"
              title="Back to all boards"
              class="text-xs text-mid no-underline transition-colors hover:text-accent"
            >
              ← Boards
            </a>
          )}
          {template && (
            <span class="font-mono text-[0.68rem] font-bold uppercase tracking-[0.13em] text-accent">
              {template}
            </span>
          )}
          {date && <span class="text-xs text-mid">· {date}</span>}
          {sessionId && (
            <button
              id="viz-session-copy"
              type="button"
              data-resume={`claude --resume ${sessionId}`}
              title={`Copy resume command for session ${sessionId}`}
              class="cursor-pointer font-mono text-[10px] text-mid underline-offset-2 transition-colors hover:text-accent hover:underline"
            >
              · session {sessionId.slice(0, 8)}
            </button>
          )}
          <button
            id="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Theme: follow system"
            title="Theme: follow system"
            class="ml-auto rounded p-1 text-mid transition-colors hover:bg-panel-2 hover:text-ink"
          >
            <span class="theme-icon-system hidden"><Icon name="computer-desktop" class="h-4 w-4" /></span>
            <span class="theme-icon-sun hidden"><Icon name="sun" class="h-4 w-4" /></span>
            <span class="theme-icon-moon hidden"><Icon name="moon" class="h-4 w-4" /></span>
          </button>
        </div>
        <h1 class="font-display text-[clamp(1.9rem,4vw,2.75rem)] font-extrabold leading-[1.05] tracking-[-0.02em] text-ink text-balance">{title}</h1>
        {subtitle && (
          <p class="mt-3 max-w-[68ch] text-base leading-relaxed text-ink-2 text-pretty sm:text-lg">{subtitle}</p>
        )}
      </header>

      <div class="flex gap-12">
        {toc.length > 0 && (
          <aside class="hidden w-60 shrink-0 lg:block">
            <div class="sticky top-8 space-y-6">
              <nav>
                <p class="mb-3 font-mono text-[0.68rem] font-bold uppercase tracking-[0.13em] text-mid">
                  Contents
                </p>
                <ol class="flex flex-col">
                  {toc.map((item, i) => (
                    <li class="border-t border-rule-soft first:border-t-0">
                      <a
                        href={`#${item.id}`}
                        class="grid grid-cols-[1.6rem_1fr] gap-1 py-2 font-display text-sm leading-tight text-ink-2 no-underline transition-colors hover:text-accent"
                      >
                        <span class="pt-0.5 font-mono text-[0.7rem] font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
                        <span>{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>

              <div class="border-t border-rule-soft pt-3">
                <div class="overflow-hidden rounded border border-rule">
                  <div class="flex">
                    <a
                      href="#viz-top"
                      aria-label="Scroll to top"
                      class="flex flex-1 items-center justify-center gap-1 py-1.5 text-xs text-mid transition-colors hover:bg-accent-soft hover:text-accent"
                    >
                      <Icon name="chevron-up" class="h-3 w-3" /> Top
                    </a>
                    <span class="w-px self-stretch bg-rule" aria-hidden="true" />
                    <a
                      href="#viz-bottom"
                      aria-label="Scroll to bottom"
                      class="flex flex-1 items-center justify-center gap-1 py-1.5 text-xs text-mid transition-colors hover:bg-accent-soft hover:text-accent"
                    >
                      <Icon name="chevron-down" class="h-3 w-3" /> Bottom
                    </a>
                  </div>
                  <span class="block h-px bg-rule" aria-hidden="true" />
                  <button
                    type="button"
                    data-theme-toggle
                    class="flex w-full items-center justify-center gap-1.5 py-1.5 text-xs text-mid transition-colors hover:bg-accent-soft hover:text-accent"
                  >
                    <span class="theme-icon-system hidden"><Icon name="computer-desktop" class="h-3 w-3" /></span>
                    <span class="theme-icon-sun hidden"><Icon name="sun" class="h-3 w-3" /></span>
                    <span class="theme-icon-moon hidden"><Icon name="moon" class="h-3 w-3" /></span>
                    <span class="theme-mode-label"></span>
                  </button>
                </div>
              </div>
            </div>
          </aside>
        )}

        <main id="viz-main" class="min-w-0 flex-1" data-viz-static={String(isStatic)}>
          <slot />
        </main>

        {!hideWaiting && (
          <aside class="hidden w-60 shrink-0 xl:block">
            <div class="sticky top-8">
              <div id="viz-waiting">
                <p class="mb-3 flex items-center gap-1.5 font-mono text-[0.68rem] font-bold uppercase tracking-[0.13em] text-mid">
                  <Icon name="clock" class="h-3.5 w-3.5" /> Activity
                  {waiting.length > 0 && (
                    <span class="ml-auto font-normal normal-case tracking-normal text-mid">
                      {waiting.length} {waiting.length === 1 ? 'gate' : 'gates'}
                    </span>
                  )}
                </p>
                {waiting.length === 0 ? (
                  <div class="flex items-center gap-2 rounded border border-l-[3px] border-accent bg-accent-soft px-3 py-2 text-sm text-accent">
                    <Icon name="check-circle" class="h-4 w-4 shrink-0" /> All caught up
                  </div>
                ) : (
                  <ul class="space-y-2">
                    {waiting.map((w) => (
                      <li>
                        <a
                          href={`#${w.anchor ?? 'respond'}`}
                          data-answered="false"
                          class="block border-l-[3px] border-signal bg-signal-soft/50 px-3 py-2 transition-colors hover:bg-signal-soft"
                        >
                          <span class="flex items-center gap-1.5 font-mono text-[10px] font-bold uppercase tracking-wide text-signal">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-signal" />
                            {waitingKindLabel(w)}
                          </span>
                          <span class="mt-1 line-clamp-3 text-xs text-ink-2">{w.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </aside>
        )}
      </div>

      {hideFooter ? (
        <div id="viz-bottom" class="scroll-mt-8"></div>
      ) : (
      <footer id="viz-bottom" class="mt-16 scroll-mt-8 border-t-2 border-ink pt-4 text-center font-mono text-xs text-mid">
        rendered by /viz · with love from
        <span class="gh-wrap">
          <a href="https://github.com/detailedghost" target="_blank" rel="noopener noreferrer" class="font-medium text-accent transition-colors hover:underline">detailedghost</a>
          <span aria-hidden="true" class="gh-ghost gh-1">👻</span>
          <span aria-hidden="true" class="gh-ghost gh-2">👻</span>
          <span aria-hidden="true" class="gh-ghost gh-3">👻</span>
        </span>
      </footer>
      )}
    </div>
  </body>
</html>

<style>
  .gh-wrap {
    position: relative;
    display: inline-block;
  }
  .gh-ghost {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 0.7rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    will-change: transform, opacity;
  }
  .gh-wrap:hover .gh-ghost {
    opacity: 0.9;
  }
</style>

<script>
  import { FAVICON_CLEAR, FAVICON_WAITING, setFaviconHref } from '../lib/favicon.ts';

  // Loop-critical wiring is defined FIRST so a throw in the cosmetic code below
  // (theme, ghosts) can never leave window.vizRefresh undefined.

  const railEl = document.getElementById('viz-waiting');
  function syncFavicon() {
    const waiting = !!railEl && railEl.querySelector('[data-answered="false"]') !== null;
    setFaviconHref(waiting ? FAVICON_WAITING : FAVICON_CLEAR);
  }
  // Observe the rail so favicon auto-tracks every change without threading syncFavicon into each refresh path.
  if (railEl) new MutationObserver(syncFavicon).observe(railEl, { childList: true, subtree: true });

  const REGION_IDS = ['viz-main', 'viz-waiting'];
  async function refreshRegions(ids: string[]) {
    const res = await fetch(location.href, { cache: 'no-store' });
    if (!res.ok) return;
    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    for (const id of ids) {
      const next = doc.getElementById(id);
      const cur = document.getElementById(id);
      if (!next || !cur) continue;
      // A visible terminal overlay owns the viewport — swapping its DOM node replays the
      // entry animation. Leave the region alone; it syncs on dismiss or the next page load.
      if (cur.querySelector('.viz-done-overlay:not(.hidden)')) continue;
      if (next.innerHTML !== cur.innerHTML) cur.innerHTML = next.innerHTML;
    }
  }
  (window as unknown as { vizRefresh: (ids?: string[]) => Promise<void> }).vizRefresh = (ids) =>
    refreshRegions(ids ?? REGION_IDS);

  syncFavicon();

  // Read-only explainer/diagnosis boards opt out of the poller entirely (payload.static === true).
  const isStaticBoard = document.getElementById('viz-main')?.dataset.vizStatic === 'true';

  const slugMatch = location.pathname.match(/\/viz\/([^/]+)/);
  if (!isStaticBoard && slugMatch) {
    const slug = slugMatch[1];
    let lastRev: number | null = null;
    let lastAwaiting: boolean | null = null;
    let lastStale: boolean | null = null;
    setInterval(async () => {
      try {
        const res = await fetch(`/api/status?slug=${encodeURIComponent(slug)}`, { cache: 'no-store' });
        if (!res.ok) return;
        const { rev, awaiting, stale } = await res.json();
        if (lastRev === null) {
          lastRev = rev; lastAwaiting = awaiting; lastStale = stale;
          return;
        }
        /**
         * A board that client-builds #viz-main (ReviewSection) sets __vizOwnsMain. An innerHTML
         * region-swap would replace its live, script-bound DOM with an empty SSR shell whose
         * <script> never re-runs — blanking the board. Reload instead: it re-executes the module
         * script and rebuilds the board fully bound against the new payload. Only fires on a real
         * rev change vs the seeded baseline, so there's no reload loop.
         */
        const ownsMain = (window as unknown as { __vizOwnsMain?: boolean }).__vizOwnsMain;
        if (rev !== lastRev) {
          const w = window as unknown as { __vizSuppressNextRefresh?: boolean };
          if (w.__vizSuppressNextRefresh) {
            w.__vizSuppressNextRefresh = false;
            // Submit bumped rev; the board already shows the correct post-submit state — skip reload/swap.
          } else if (ownsMain) {
            location.reload(); return;
          } else {
            await refreshRegions(REGION_IDS);
          }
        } else if (awaiting !== lastAwaiting || stale !== lastStale) {
          await refreshRegions(['viz-waiting']);
        }
        lastRev = rev; lastAwaiting = awaiting; lastStale = stale;
      } catch {
        // server momentarily unreachable — try again next tick
      }
    }, 2500);
  }

  // ---- Cosmetic only below this line ----
  type ThemeMode = 'system' | 'light' | 'dark';
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  // 'system' is stored as the absence of a key, so a board opened in a fresh browser
  // follows the OS. The cycle below is what makes 'system' reachable again after an
  // explicit pick — a two-state toggle pinned the first choice forever.
  function readMode(): ThemeMode {
    const stored = localStorage.getItem('viz-theme');
    return stored === 'light' || stored === 'dark' ? stored : 'system';
  }

  const MODE_ICON: Record<ThemeMode, string> = {
    system: 'theme-icon-system',
    light: 'theme-icon-sun',
    dark: 'theme-icon-moon',
  };

  function applyMode(mode: ThemeMode) {
    const dark = mode === 'dark' || (mode === 'system' && mq.matches);
    document.documentElement.classList.toggle('dark', dark);

    const label =
      mode === 'system' ? `Theme: follow system (${dark ? 'dark' : 'light'})` : `Theme: ${mode}`;
    const shortLabel = mode === 'system' ? 'System' : mode === 'light' ? 'Light' : 'Dark';

    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      for (const [name, cls] of Object.entries(MODE_ICON)) {
        btn.querySelector<HTMLElement>('.' + cls)?.classList.toggle('hidden', name !== mode);
      }
      const text = btn.querySelector<HTMLElement>('.theme-mode-label');
      if (text) text.textContent = shortLabel;
    });
  }

  applyMode(readMode());

  mq.addEventListener('change', () => {
    if (readMode() === 'system') applyMode('system');
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-theme-toggle]')) return;
    const order: ThemeMode[] = ['system', 'light', 'dark'];
    const next = order[(order.indexOf(readMode()) + 1) % order.length];
    if (next === 'system') localStorage.removeItem('viz-theme');
    else localStorage.setItem('viz-theme', next);
    applyMode(next);
  });

  const sessionCopyBtn = document.getElementById('viz-session-copy');
  sessionCopyBtn?.addEventListener('click', async () => {
    const cmd = sessionCopyBtn.dataset.resume ?? '';
    if (!cmd) return;
    try {
      await navigator.clipboard.writeText(cmd);
    } catch {
      return;
    }
    const original = sessionCopyBtn.textContent;
    sessionCopyBtn.textContent = '· resume copied ✓';
    setTimeout(() => { sessionCopyBtn.textContent = original; }, 1500);
  });

  // Generic copy: any [data-copy-text] button. Delegated so it survives region swaps.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-text]');
    if (!btn) return;
    const text = btn.dataset.copyText ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      return;
    }
    const original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.textContent = original; }, 1500);
  });

  const ghWrap = document.querySelector('.gh-wrap');
  if (ghWrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ghosts = [...ghWrap.querySelectorAll<HTMLElement>('.gh-ghost')];
    const orbits = ghosts.map((_, i) => ({
      rx: 58 + i * 12,
      ry: 22 + i * 5,
      speed: 0.7 + Math.random() * 0.5,
      phase: (i * 2 * Math.PI) / ghosts.length + Math.random(),
      dir: i % 2 === 0 ? 1 : -1,
    }));
    let raf = 0;
    const tick = (now: number) => {
      const t = now / 1000;
      ghosts.forEach((g, i) => {
        const o = orbits[i];
        const a = o.dir * t * o.speed + o.phase;
        const x = Math.cos(a) * o.rx;
        const y = Math.sin(a) * o.ry;
        const wobble = Math.sin(t * 2 + o.phase) * 10;
        g.style.transform = `translate(calc(-50% + ${x.toFixed(1)}px), calc(-50% + ${y.toFixed(1)}px)) rotate(${wobble.toFixed(1)}deg)`;
      });
      raf = requestAnimationFrame(tick);
    };
    ghWrap.addEventListener('mouseenter', () => { if (!raf) raf = requestAnimationFrame(tick); });
    ghWrap.addEventListener('mouseleave', () => {
      cancelAnimationFrame(raf);
      raf = 0;
      for (const g of ghosts) g.style.transform = '';
    });
  }
</script>

<style is:global>
  @import "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  @theme {
    --color-ground: #f7f8fa;
    --color-panel: #ffffff;
    --color-panel-2: #eef0f4;
    --color-ink: #16191f;
    --color-ink-2: #3b424e;
    --color-mid: #5c6470;
    --color-rule: #d8dce4;
    --color-rule-soft: #e6e9ef;
    --color-accent: #1f6f6b;
    --color-accent-soft: #e3efee;
    --color-signal: #97610c;
    --color-signal-soft: #f9efdc;
    --color-risk: #a33a2e;
    --color-risk-soft: #f8e6e3;
    --color-progress: #3d5a99;
    --color-progress-soft: #e4e9f4;

    --color-on-fill: var(--color-ground);

    --font-display: "Bricolage Grotesque", "Helvetica Neue", Arial, sans-serif;
    --font-body: "Source Serif 4", Georgia, "Times New Roman", serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .dark {
    --color-ground: #12141a;
    --color-panel: #1a1d25;
    --color-panel-2: #22262f;
    --color-ink: #eef0f4;
    --color-ink-2: #c2c8d2;
    --color-mid: #949cab;
    --color-rule: #2c313b;
    --color-rule-soft: #23272f;
    --color-accent: #5cb8b1;
    --color-accent-soft: #17302f;
    --color-signal: #dfa441;
    --color-signal-soft: #2f2617;
    --color-risk: #e0796a;
    --color-risk-soft: #331d19;
    --color-progress: #7d95d1;
    --color-progress-soft: #1f2637;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Keep section headings clear of sticky progress bar on anchor jump */
  section[id] {
    scroll-margin-top: 6rem;
  }

  /* Shiki <pre> padding — the Code component doesn't add any by default */
  .astro-code {
    padding: 1rem 1.25rem;
  }

  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
