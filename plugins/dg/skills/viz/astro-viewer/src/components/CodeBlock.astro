---
import { Code } from 'astro:components'

interface Props {
  code: string
  lang?: string
  title?: string
  caption?: string
}
const { code, lang = 'text', title, caption } = Astro.props
---

<div class="my-3 overflow-hidden rounded border border-rule">
  {title && (
    <div class="flex items-center justify-between border-b border-gray-700 bg-gray-800 px-4 py-2">
      <span class="font-mono text-xs font-medium text-gray-300">{title}</span>
      <span class="font-mono text-xs text-gray-500">{lang}</span>
    </div>
  )}
  <div class="overflow-x-auto">
    <Code code={code} lang={lang as any} theme="github-dark" />
  </div>
  {caption && (
    <div class="border-t border-gray-700 bg-gray-800 px-4 py-2">
      <p class="text-xs italic text-gray-400">{caption}</p>
    </div>
  )}
</div>
