---
import DecisionOption from './DecisionOption.astro'
import { roleName, threadBubbleClass, threadDotClass, threadLabelClass } from '../lib/thread'
import type { PendingDecision } from '../types'

interface SavedAnswer {
  type: string
  index: number
  answer: string
}

interface Props {
  slug: string
  openQuestions: string[]
  pendingDecisions: PendingDecision[]
  savedAnswers?: SavedAnswer[]
}

const { slug, openQuestions, pendingDecisions, savedAnswers = [] } = Astro.props
const hasItems = openQuestions.length > 0 || pendingDecisions.length > 0

const savedAnswer = (type: string, index: number): string | undefined =>
  savedAnswers.find((a) => a.type === type && a.index === index)?.answer
---

{hasItems && (
  <section id="respond" class="mt-12 rounded border-2 border-dashed border-accent bg-accent-soft/30 px-6 py-6">
    <h2 class="mb-1 font-display text-lg font-semibold text-accent">Your input needed</h2>
    <p class="mb-6 text-sm text-mid">
      Pick your answers and confirm.
    </p>

    <form id="viz-response-form" data-slug={slug} class="space-y-8">

      {pendingDecisions.map((d) => {
        const thread = d.thread ?? []
        const hasOptions = !!d.options && d.options.length > 0
        const multiple = !!d.multiple && hasOptions
        const saved = savedAnswer('decision', d.index)
        // Multi-select answers are stored newline-joined; split to restore checks.
        const savedParts = saved !== undefined ? saved.split('\n') : []
        const savedSet = new Set(savedParts)
        const savedCustomLines = hasOptions ? savedParts.filter((p) => !d.options?.includes(p)) : []
        const optionChecked = (opt: string) => (multiple ? savedSet.has(opt) : saved === opt)
        const savedIsCustom = saved !== undefined && hasOptions && !d.options?.includes(saved)
        const savedHasCustom = multiple ? savedCustomLines.length > 0 : savedIsCustom
        let customText = ''
        if (multiple) customText = savedCustomLines.join('\n')
        else if (savedIsCustom && saved !== undefined) customText = saved
        const savedQuestion = savedAnswer('decision_question', d.index)
        return (
          <div data-decision-item={String(d.index)}>
            <p class="mb-1 font-mono text-xs font-bold uppercase tracking-[0.11em] text-accent">
              {d.inDiscussion ? 'Decision · in discussion' : 'Decision'}
            </p>
            <p class="mb-3 text-sm font-medium text-ink">{d.question}</p>

            <div class="relative">
              <span
                class="absolute left-[8px] top-2 bottom-2 w-px -translate-x-1/2 bg-rule"
                aria-hidden="true"
              />

              {thread.map((msg) => (
                <div class="relative flex gap-3 pb-3">
                  <span class="relative z-10 flex w-4 shrink-0 justify-center">
                    <span class={`mt-1 h-3 w-3 rounded-full ring-4 ring-panel ${threadDotClass(msg.role)}`} />
                  </span>
                  <div class={`min-w-0 flex-1 rounded px-3 py-2 ${threadBubbleClass(msg.role)}`}>
                    <p class={`mb-0.5 font-mono text-xs font-semibold ${threadLabelClass(msg.role)}`}>{roleName(msg.role)}</p>
                    <p class="text-sm text-ink-2">{msg.text}</p>
                  </div>
                </div>
              ))}

              <div data-decide-panel={String(d.index)} class={savedQuestion ? 'hidden' : undefined}>
                {hasOptions ? (
                  <div role={multiple ? 'group' : 'radiogroup'} data-radio-group={String(d.index)}>
                    {multiple && (
                      <p class="mb-2 ml-7 text-xs italic text-mid">Select all that apply</p>
                    )}
                    {d.options?.map((opt) => (
                      <div class="relative flex gap-3 pb-2">
                        <span class="relative z-10 flex w-4 shrink-0 justify-center">
                          <span class="mt-3 h-2 w-2 rounded-full bg-accent ring-4 ring-panel" />
                        </span>
                        <div class="min-w-0 flex-1">
                          <DecisionOption index={d.index} value={opt} label={opt} multiple={multiple} checked={optionChecked(opt)} />
                        </div>
                      </div>
                    ))}

                    <div class="relative flex gap-3 pb-2">
                      <span class="relative z-10 flex w-4 shrink-0 justify-center">
                        <span class="mt-3 h-2 w-2 rounded-full bg-accent ring-4 ring-panel" />
                      </span>
                      <div class="min-w-0 flex-1">
                        <DecisionOption index={d.index} value="__other__" label="Other / custom…" isOther multiple={multiple} checked={savedHasCustom} />
                      </div>
                    </div>

                    <div data-other-box={String(d.index)} class={savedHasCustom ? 'ml-7' : 'ml-7 hidden'}>
                      <textarea
                        data-type="decision"
                        data-index={String(d.index)}
                        data-is-custom="true"
                        rows={3}
                        placeholder={multiple ? 'Add custom values, one per line…' : 'Describe your answer…'}
                        class="w-full rounded border border-accent bg-panel px-3 py-2 text-sm text-ink placeholder-mid focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
                      >{customText}</textarea>
                    </div>
                  </div>
                ) : (
                  <div class="relative flex gap-3 pb-2">
                    <span class="relative z-10 flex w-4 shrink-0 justify-center">
                      <span class="mt-3 h-2 w-2 rounded-full bg-accent ring-4 ring-panel" />
                    </span>
                    <textarea
                      name={`decision-${d.index}`}
                      data-type="decision"
                      data-index={String(d.index)}
                      rows={3}
                      placeholder="Your answer…"
                      class="min-w-0 flex-1 rounded border border-rule bg-panel px-3 py-2 text-sm text-ink placeholder-mid focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
                    >{!hasOptions && saved ? saved : ''}</textarea>
                  </div>
                )}

                <button
                  type="button"
                  data-ask-toggle={String(d.index)}
                  class="ml-7 mt-1 text-xs text-mid underline-offset-2 hover:text-accent hover:underline"
                >
                  Ask a question instead →
                </button>
              </div>
            </div>

            <div data-question-panel={String(d.index)} class={savedQuestion ? 'ml-7 mt-3' : 'ml-7 mt-3 hidden'}>
              <textarea
                data-type="decision_question"
                data-index={String(d.index)}
                rows={3}
                placeholder="What would help you decide?"
                class="w-full rounded border border-progress bg-panel px-3 py-2 text-sm text-ink placeholder-mid focus:border-progress focus:outline-none focus:ring-2 focus:ring-progress/30"
              >{savedQuestion ?? ''}</textarea>
              <button
                type="button"
                data-decide-toggle={String(d.index)}
                class="mt-2 text-xs text-mid underline-offset-2 hover:text-accent hover:underline"
              >
                ← Back to options
              </button>
            </div>
          </div>
        )
      })}

      {openQuestions.map((q, i) => (
        <div>
          <p class="mb-1 font-mono text-xs font-bold uppercase tracking-[0.11em] text-progress">Open Question</p>
          <p class="mb-3 text-sm font-medium text-ink">{q}</p>
          <textarea
            id={`oq-${i}`}
            name={`oq-${i}`}
            data-type="open_question"
            data-index={String(i)}
            rows={3}
            placeholder="Your answer…"
            class="w-full rounded border border-rule bg-panel px-3 py-2 text-sm text-ink placeholder-mid focus:border-progress focus:outline-none focus:ring-2 focus:ring-progress/30"
          >{savedAnswer('open_question', i) ?? ''}</textarea>
        </div>
      ))}

      <div class="flex items-center gap-4 pt-1">
        <button
          type="submit"
          class="rounded bg-accent px-5 py-2 text-sm font-semibold text-on-fill transition-colors hover:bg-accent/90 active:bg-accent/80 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Confirm
        </button>
        <span id="viz-form-status" class="hidden text-sm text-mid" aria-live="polite" />
      </div>
    </form>

    <div id="viz-form-success" class="hidden pt-3">
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-accent"></span>
        <p class="font-display text-sm font-semibold text-accent">Saved — Claude will collect this automatically.</p>
        <button
          id="viz-edit-btn"
          type="button"
          class="ml-auto rounded border border-rule px-2.5 py-1 text-xs font-medium text-mid transition-colors hover:border-accent hover:text-accent"
        >
          Edit answer
        </button>
      </div>
      <p class="mb-2 text-xs text-mid">Your answer stays editable until it's merged. If Claude isn't in loop mode, you can also type:</p>
      <div class="flex items-center gap-2">
        <code id="viz-fallback-cmd" class="rounded bg-panel-2 px-2 py-1 font-mono text-xs text-ink-2">
          /dg:viz responses ready for {slug}
        </code>
        <button
          id="viz-copy-btn"
          type="button"
          title="Copy to clipboard"
          class="flex items-center gap-1 rounded px-2 py-1 text-xs text-mid transition-colors hover:bg-panel-2 hover:text-ink"
        >
          <svg id="viz-copy-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-3.5 w-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.688a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
          </svg>
          <svg id="viz-check-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="hidden h-3.5 w-3.5 text-accent">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          <span id="viz-copy-label">Copy</span>
        </button>
      </div>
    </div>
  </section>
)}

<script>
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'
  import { burstConfetti } from '../lib/confetti.ts'

  // Accent tones matching the picker's selected state — a celebratory flourish on pick.
  const PICKER_CONFETTI = ['#1f6f6b', '#5cb8b1', '#8fd0ca', '#c3e6e2', '#ffffff']

  // Listeners are delegated on `document` (not the form element) so they survive
  // a viz-main region swap from the live refresh — the form may be replaced wholesale.
  const getForm = () => document.getElementById('viz-response-form') as HTMLFormElement | null
  const { nonce } = readVizMeta()

  function setFormDisabled(form: HTMLFormElement, disabled: boolean) {
    form
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('input, textarea, button')
      .forEach((el) => {
        el.disabled = disabled
      })
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement

    if (target.closest('#viz-copy-btn')) {
      const text = document.getElementById('viz-fallback-cmd')?.textContent?.trim() ?? ''
      navigator.clipboard.writeText(text).then(() => {
        const copyIcon = document.getElementById('viz-copy-icon')
        const checkIcon = document.getElementById('viz-check-icon')
        const label = document.getElementById('viz-copy-label')
        copyIcon?.classList.add('hidden')
        checkIcon?.classList.remove('hidden')
        if (label) label.textContent = 'Copied!'
        setTimeout(() => {
          copyIcon?.classList.remove('hidden')
          checkIcon?.classList.add('hidden')
          if (label) label.textContent = 'Copy'
        }, 2000)
      })
      return
    }

    // Re-open a submitted-but-not-merged form for editing.
    if (target.closest('#viz-edit-btn')) {
      const form = getForm()
      if (form) setFormDisabled(form, false)
      document.getElementById('viz-form-success')?.classList.add('hidden')
      return
    }

    const form = target.closest('#viz-response-form') as HTMLFormElement | null
    if (!form) return
    const askEl = target.closest<HTMLElement>('[data-ask-toggle]')
    const decideEl = target.closest<HTMLElement>('[data-decide-toggle]')
    if (askEl) {
      const idx = askEl.dataset.askToggle
      form.querySelector(`[data-decide-panel="${idx}"]`)?.classList.add('hidden')
      const qp = form.querySelector(`[data-question-panel="${idx}"]`)
      qp?.classList.remove('hidden')
      qp?.querySelector('textarea')?.focus()
    } else if (decideEl) {
      const idx = decideEl.dataset.decideToggle
      form.querySelector(`[data-question-panel="${idx}"]`)?.classList.add('hidden')
      form.querySelector(`[data-decide-panel="${idx}"]`)?.classList.remove('hidden')
    }
  })

  // Other/custom textarea reveal on radio or checkbox change
  document.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement
    const form = target.closest('#viz-response-form') as HTMLFormElement | null
    if (!form) return
    if (target.type !== 'radio' && target.type !== 'checkbox') return

    // Celebratory flash on pick: pop the chosen card + a confetti flourish.
    if (target.checked) {
      const label = target.closest('label')
      if (label) {
        label.classList.remove('viz-pop')
        void (label as HTMLElement).offsetWidth // reflow so the animation retriggers
        label.classList.add('viz-pop')
      }
      burstConfetti({ count: 70, colors: PICKER_CONFETTI, durationMs: 1500 })
    }

    const idx = target.dataset.index
    const otherBox = form.querySelector<HTMLElement>(`[data-other-box="${idx}"]`)
    if (!otherBox) return
    // Radios: only __other__ shows the box. Checkboxes: box stays while its own __other__ is checked.
    let showOther = target.value === '__other__'
    if (target.type === 'checkbox') {
      const otherCb = form.querySelector<HTMLInputElement>(`input[type="checkbox"][data-index="${idx}"][data-is-other]`)
      showOther = !!otherCb?.checked
    }
    otherBox.classList.toggle('hidden', !showOther)
    if (showOther) otherBox.querySelector('textarea')?.focus()
  })

  document.addEventListener('submit', async (e) => {
    const form = (e.target as HTMLElement).closest('#viz-response-form') as HTMLFormElement | null
    if (!form) return
    e.preventDefault()
    const statusEl = document.getElementById('viz-form-status')
    const slug = form.dataset.slug ?? ''
    const answers: { type: string; index: number; answer: string }[] = []

    // Checked radios in visible decide panels — resolve __other__ to textarea value
    form.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach((radio) => {
      const panel = radio.closest<HTMLElement>('[data-decide-panel]')
      if (!panel || panel.classList.contains('hidden')) return
      const idx = Number(radio.dataset.index ?? 0)
      let answer = radio.value
      if (answer === '__other__') {
        const box = form.querySelector<HTMLElement>(`[data-other-box="${idx}"]`)
        answer = box?.querySelector<HTMLTextAreaElement>('textarea')?.value.trim() ?? ''
      }
      answers.push({ type: 'decision', index: idx, answer })
    })

    // Checked multi-select checkboxes — group by index, join values newline-separated
    const multiByIndex = new Map<number, string[]>()
    form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-multiple]:checked').forEach((cb) => {
      const panel = cb.closest<HTMLElement>('[data-decide-panel]')
      if (!panel || panel.classList.contains('hidden')) return
      const idx = Number(cb.dataset.index ?? 0)
      const values = multiByIndex.get(idx) ?? []
      if (cb.value === '__other__') {
        const box = form.querySelector<HTMLElement>(`[data-other-box="${idx}"]`)
        const custom = box?.querySelector<HTMLTextAreaElement>('textarea')?.value.trim() ?? ''
        custom.split('\n').map((l) => l.trim()).filter(Boolean).forEach((l) => values.push(l))
      } else {
        values.push(cb.value)
      }
      multiByIndex.set(idx, values)
    })
    multiByIndex.forEach((values, idx) => {
      answers.push({ type: 'decision', index: idx, answer: values.join('\n') })
    })

    // Textareas — skip hidden panels and custom-answer boxes
    form.querySelectorAll<HTMLTextAreaElement>('textarea:not([data-is-custom])').forEach((ta) => {
      const panel = ta.closest<HTMLElement>('[data-decide-panel], [data-question-panel]')
      if (panel?.classList.contains('hidden')) return
      answers.push({
        type: ta.dataset.type ?? 'unknown',
        index: Number(ta.dataset.index ?? 0),
        answer: ta.value.trim(),
      })
    })

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    if (submitBtn) submitBtn.disabled = true
    if (statusEl) {
      statusEl.textContent = 'Saving…'
      statusEl.classList.remove('hidden')
    }

    try {
      const hmac = await signAnswers(slug, answers)
      const res = await respond(slug, nonce, hmac, answers)
      if (!res.ok) throw new Error(`${res.status}`)
      // Keep the answer visible but locked; the Edit button re-opens it until merge.
      setFormDisabled(form, true)
      if (statusEl) statusEl.classList.add('hidden')
      document.getElementById('viz-form-success')?.classList.remove('hidden')
      // Refresh the activity rail so it shows the answered/awaiting state.
      const w = (window as unknown as { vizRefresh?: (ids?: string[]) => Promise<void> }).vizRefresh
      if (w) w(['viz-waiting'])
    } catch (err) {
      if (statusEl) statusEl.textContent = 'Error saving — check console'
      if (submitBtn) submitBtn.disabled = false
      console.error('[viz] response submit failed', err)
    }
  })
</script>

<style is:global>
  @keyframes viz-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.04); box-shadow: 0 8px 20px rgba(31, 111, 107, 0.38); }
    100% { transform: scale(1); }
  }
  .viz-pop { animation: viz-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @media (prefers-reduced-motion: reduce) {
    .viz-pop { animation: none; }
  }
</style>
