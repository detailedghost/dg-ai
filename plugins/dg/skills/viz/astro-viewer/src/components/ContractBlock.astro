---
import { Code } from 'astro:components'
import Icon from './Icon.astro'

interface Endpoint {
  method: string
  path: string
  auth?: string
}

interface RequestField {
  field: string
  type: string
  required: boolean
  assumed?: boolean
}

interface SuccessResponse {
  status: number
  body?: string
}

interface ErrorResponse {
  status: number
  body: string
  trigger: string
}

interface Interface {
  signature: string
  params?: string
  returns?: string
  exceptions?: string
}

interface Props {
  slice: string
  endpoints: Endpoint[]
  requestFields?: RequestField[]
  successResponse?: SuccessResponse
  errorResponses?: ErrorResponse[]
  interfaces?: Interface[]
  anchorId?: string
  sliceHref?: string
}

const { slice, endpoints, requestFields = [], successResponse, errorResponses = [], interfaces = [], anchorId, sliceHref } = Astro.props

const methodColor: Record<string, string> = {
  GET:    'bg-progress-soft text-progress',
  POST:   'bg-accent-soft text-accent',
  PUT:    'bg-signal-soft text-signal',
  PATCH:  'bg-panel-2 text-ink-2',
  DELETE: 'bg-risk-soft text-risk',
}
---

<div id={anchorId} class='my-3 scroll-mt-8 rounded border border-rule bg-panel'>
  <div class='flex items-center gap-2 border-b border-rule-soft px-4 py-3'>
    <Icon name='server' class='h-4 w-4 shrink-0 text-accent' />
    <span class='font-display text-sm font-semibold text-ink'>{slice}</span>
    {sliceHref ? (
      <a href={sliceHref} class='ml-auto inline-flex items-center gap-1 text-xs text-mid transition-colors hover:text-accent'>
        <Icon name='queue-list' class='h-3 w-3' /> slice
      </a>
    ) : (
      <span class='ml-auto font-mono text-xs text-mid'>contract</span>
    )}
  </div>

  <div class='space-y-1.5 px-4 py-3'>
    {endpoints.map((ep) => (
      <div class='flex items-center gap-2 font-mono text-sm'>
        <span class={`shrink-0 rounded px-1.5 py-0.5 text-xs font-bold uppercase ${methodColor[ep.method.toUpperCase()] ?? 'bg-panel-2 text-mid'}`}>
          {ep.method}
        </span>
        <span class='flex-1 text-ink-2'>{ep.path}</span>
        {ep.auth && (
          <span class='flex shrink-0 items-center gap-1 text-xs text-mid'>
            <Icon name='lock-closed' class='h-3 w-3' />
            {ep.auth}
          </span>
        )}
      </div>
    ))}
  </div>

  {requestFields.length > 0 && (
    <div class='border-t border-rule-soft'>
      <p class='px-4 pt-2.5 pb-1 font-mono text-[0.66rem] font-bold uppercase tracking-[0.11em] text-mid'>Request</p>
      <table class='w-full text-sm'>
        <thead>
          <tr class='text-left font-mono text-[0.66rem] uppercase tracking-wide text-mid'>
            <th class='px-4 pb-1 font-medium'>Field</th>
            <th class='px-2 pb-1 font-medium'>Type</th>
            <th class='px-2 pb-1 font-medium'>Required</th>
          </tr>
        </thead>
        <tbody>
          {requestFields.map((f) => (
            <tr class='border-t border-rule-soft'>
              <td class='px-4 py-1.5 font-mono text-ink-2'>
                {f.field}
                {f.assumed && (
                  <span
                    title='Assumed — not confirmed in source'
                    class='ml-1.5 rounded bg-signal-soft px-1 py-0.5 text-xs font-semibold text-signal'
                  >
                    assumed
                  </span>
                )}
              </td>
              <td class='px-2 py-1.5 font-mono text-xs text-accent'>{f.type}</td>
              <td class='px-2 py-1.5'>
                {f.required ? (
                  <Icon name='check-circle' class='h-4 w-4 text-accent' />
                ) : (
                  <span class='text-xs text-mid'>—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {(successResponse || errorResponses.length > 0) && (
    <div class='border-t border-rule-soft'>
      <p class='px-4 pt-2.5 pb-1 font-mono text-[0.66rem] font-bold uppercase tracking-[0.11em] text-mid'>Responses</p>
      <div class='space-y-1 px-4 pb-3'>
        {successResponse && (
          <div class='rounded bg-accent-soft px-3 py-1.5'>
            <span class='shrink-0 font-mono text-xs font-bold text-accent'>{successResponse.status}</span>
            {successResponse.body && (
              <div class='contract-ts-code mt-1 overflow-x-auto text-[11px] leading-relaxed'>
                <Code code={successResponse.body} lang='ts' themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
              </div>
            )}
          </div>
        )}
        {errorResponses.map((er) => (
          <div class='flex items-start gap-2 rounded bg-risk-soft px-3 py-1.5'>
            <span class='mt-0.5 shrink-0 font-mono text-xs font-bold text-risk'>{er.status}</span>
            <span class='font-mono text-xs text-ink-2'>{er.body}</span>
            <span class='ml-auto shrink-0 text-xs italic text-mid'>{er.trigger}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {interfaces.length > 0 && (
    <details class='group border-t border-rule-soft'>
      <summary class='flex cursor-pointer select-none items-center gap-2 px-4 py-2 text-xs text-mid transition-colors hover:text-ink'>
        <Icon name='chevron-right' class='h-3 w-3 transition-transform duration-150 group-open:rotate-90' />
        <Icon name='code-bracket' class='h-3 w-3' />
        Interfaces · {interfaces.length}
      </summary>
      <div class='space-y-3 px-4 pb-3'>
        {interfaces.map((iface) => (
          <div class='rounded border border-rule-soft bg-panel-2 px-3 py-2'>
            <code class='block font-mono text-xs font-semibold text-accent'>{iface.signature}</code>
            {iface.params && (
              <p class='mt-1 text-xs text-mid'><span class='font-medium text-ink-2'>params: </span>{iface.params}</p>
            )}
            {iface.returns && (
              <p class='mt-0.5 text-xs text-mid'><span class='font-medium text-ink-2'>returns: </span>{iface.returns}</p>
            )}
            {iface.exceptions && (
              <p class='mt-0.5 text-xs text-mid'><span class='font-medium text-ink-2'>throws: </span>{iface.exceptions}</p>
            )}
          </div>
        ))}
      </div>
    </details>
  )}
</div>

<style is:global>
  /*
   * Shiki dual-theme (defaultColor=false) emits --shiki-light/--shiki-dark
   * custom properties per span instead of baking one theme's hex colors in —
   * these rules pick the active one off the board's existing .dark toggle.
   * Scoped to .contract-ts-code so it never touches the always-dark
   * single-theme <Code> usage in CodeSamplesSection/CodeBlock.astro.
   */
  .contract-ts-code .astro-code {
    margin: 0;
    padding: 0.375rem 0.5rem;
    background-color: transparent !important;
  }
  .contract-ts-code .astro-code,
  .contract-ts-code .astro-code span {
    color: var(--shiki-light);
  }
  .dark .contract-ts-code .astro-code,
  .dark .contract-ts-code .astro-code span {
    color: var(--shiki-dark) !important;
  }
</style>
