---
import Icon from './Icon.astro'

interface Props {
  status: 'draft' | 'in-progress' | 'complete' | 'deferred' | 'blocked' | 'abandoned'
  version?: string
  date?: string
  feature?: string
}

const { status, version, date, feature } = Astro.props

type StatusConfig = { pill: string; icon: string; label: string }
const statusMap: Record<Props['status'], StatusConfig> = {
  draft:     { pill: 'bg-panel-2 text-mid',           icon: 'clock',        label: 'Draft' },
  'in-progress': { pill: 'bg-progress-soft text-progress', icon: 'arrow-path',   label: 'In Progress' },
  complete:  { pill: 'bg-accent-soft text-accent',    icon: 'check-circle', label: 'Complete' },
  deferred:  { pill: 'bg-signal-soft text-signal',    icon: 'pause-circle', label: 'Deferred' },
  blocked:   { pill: 'bg-risk-soft text-risk',        icon: 'exclamation-triangle', label: 'Blocked' },
  abandoned: { pill: 'bg-risk text-on-fill',            icon: 'x-circle',     label: 'Abandoned' },
}

const cfg = statusMap[status]
---

<div class='flex flex-wrap items-center gap-3 py-2'>
  <span
    class={`inline-flex items-center gap-1.5 rounded px-2.5 py-0.5 font-mono text-xs font-bold uppercase tracking-wide ${cfg.pill}`}
  >
    <Icon name={cfg.icon} class='h-3.5 w-3.5' />
    {cfg.label}
  </span>

  {(version || date || feature) && (
    <span class='font-mono text-xs text-mid'>
      {[version && `v${version}`, date, feature].filter(Boolean).join(' · ')}
    </span>
  )}
</div>
