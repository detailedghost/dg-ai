---
interface Props {
  index: number
  value: string
  label: string
  isOther?: boolean
  checked?: boolean
  multiple?: boolean
}
const { index, value, label, isOther = false, checked = false, multiple = false } = Astro.props

const border = isOther ? 'border-dashed border-rule' : 'border-rule'
const labelText = isOther
  ? 'text-sm italic text-mid transition-colors duration-150 peer-checked:text-on-fill'
  : 'text-sm text-ink-2 transition-colors duration-150 peer-checked:text-on-fill'
---

<label
  class={`relative flex cursor-pointer items-start gap-3 overflow-hidden rounded border bg-panel px-4 py-3 transition-all duration-150 hover:-translate-y-px hover:border-accent hover:bg-accent-soft/60 has-[:checked]:border-accent has-[:checked]:bg-accent has-[:checked]:shadow-lg has-[:checked]:ring-2 has-[:checked]:ring-accent/40 has-[:checked]:ring-offset-1 ring-offset-panel ${border}`}
>
  <input
    type={multiple ? 'checkbox' : 'radio'}
    name={multiple ? `decision-${index}-${value}` : `decision-${index}`}
    value={value}
    data-type="decision"
    data-index={String(index)}
    data-multiple={multiple ? 'true' : undefined}
    data-is-other={isOther ? 'true' : undefined}
    checked={checked}
    class="sr-only peer"
  />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="mt-0.5 h-4 w-4 shrink-0 scale-50 text-on-fill opacity-0 transition-all duration-200 peer-checked:scale-100 peer-checked:opacity-100"
  >
    <path
      fill-rule="evenodd"
      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
      clip-rule="evenodd"
    />
  </svg>
  <span class={labelText}>{label}</span>
</label>
