---
import Icon from './Icon.astro'

interface Props {
  items: Array<{ question: string; answer: string }>
}

const { items } = Astro.props
---

<div class='my-3 divide-y divide-rule-soft rounded border border-rule bg-panel'>
  {items.map((item, i) => (
    <details class='group' open={i === 0 || undefined}>
      <summary class='flex cursor-pointer select-none items-center gap-2 px-4 py-2.5 text-sm transition-colors hover:bg-panel-2'>
        <Icon name='check-circle' class='h-4 w-4 shrink-0 text-accent' />
        <span class='flex-1 font-display font-medium text-ink'>{item.question}</span>
        <Icon name='chevron-right' class='h-3.5 w-3.5 shrink-0 text-mid transition-transform duration-150 group-open:rotate-90' />
      </summary>
      <div class='border-t border-rule-soft bg-accent-soft/40 px-4 py-3'>
        <p class='text-sm text-ink-2'>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
