---
import CodeBlock from './CodeBlock.astro'
import Collapsible from './Collapsible.astro'
import Icon from './Icon.astro'

interface Finding {
  title: string
  severity?: 'critical' | 'high' | 'medium' | 'low' | 'info'
  body: string
  location?: string
  code?: string
  lang?: string
}

interface Props {
  label: string
  summary?: string
  findings: Finding[]
  open?: boolean
}
const { label, summary, findings, open = false } = Astro.props

const severityDot: Record<string, string> = {
  critical: 'bg-risk',
  high: 'bg-risk',
  medium: 'bg-signal',
  low: 'bg-progress',
  info: 'bg-mid',
}
const severityText: Record<string, string> = {
  critical: 'text-risk',
  high: 'text-risk',
  medium: 'text-signal',
  low: 'text-progress',
  info: 'text-mid',
}
---

<Collapsible title={label} count={findings.length} open={open}>
  {summary && <p class='mb-3 text-sm text-mid'>{summary}</p>}
  <div class='divide-y divide-rule-soft overflow-hidden rounded border border-rule-soft bg-panel'>
    {findings.map((f) => (
      <details class='group'>
        <summary class='flex cursor-pointer select-none items-center gap-2.5 px-3 py-2 hover:bg-panel-2'>
          <span class={`h-2 w-2 shrink-0 rounded-full ${severityDot[f.severity ?? 'info'] ?? 'bg-mid'}`} />
          <span class='min-w-0 flex-1 truncate text-sm font-medium text-ink'>{f.title}</span>
          {f.severity && (
            <span class={`shrink-0 font-mono text-[0.62rem] font-bold uppercase ${severityText[f.severity] ?? 'text-mid'}`}>
              {f.severity}
            </span>
          )}
          <Icon name='chevron-right' class='h-3 w-3 shrink-0 text-mid transition-transform group-open:rotate-90' />
        </summary>
        <div class='border-t border-rule-soft bg-panel-2 px-3 py-2.5 pl-[1.9rem]'>
          {f.location && <code class='block font-mono text-xs text-mid'>{f.location}</code>}
          <p class='mt-1 text-sm text-ink-2'>{f.body}</p>
          {f.code && (
            <div class='-mx-3 -mb-2.5 mt-2'>
              <CodeBlock code={f.code} lang={f.lang ?? 'text'} />
            </div>
          )}
        </div>
      </details>
    ))}
  </div>
</Collapsible>
