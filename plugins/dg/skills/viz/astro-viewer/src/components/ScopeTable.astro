---
import Icon from './Icon.astro'

interface Props {
  inScope: string[]
  outOfScope: string[]
  assumptions?: string[]
}

const { inScope, outOfScope, assumptions = [] } = Astro.props

const colBase = 'rounded border-l-[3px] p-4'
const inCol = `${colBase} border-accent bg-accent-soft`
const outCol = `${colBase} border-risk bg-risk-soft`
const assumeCol = `${colBase} border-signal bg-signal-soft`
---

<div class="my-4 grid grid-cols-1 gap-4">
  <div class={inCol}>
    <div class="mb-2 flex items-center gap-1.5">
      <Icon name="check-circle" class="h-4 w-4 text-accent" />
      <span class="font-mono text-xs font-bold uppercase tracking-[0.11em] text-accent">In Scope</span>
    </div>
    <ul class="space-y-1.5">
      {inScope.map((item) => (
        <li class="flex items-start gap-2 text-sm text-ink-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  <div class={outCol}>
    <div class="mb-2 flex items-center gap-1.5">
      <Icon name="x-circle" class="h-4 w-4 text-risk" />
      <span class="font-mono text-xs font-bold uppercase tracking-[0.11em] text-risk">Out of Scope</span>
    </div>
    <ul class="space-y-1.5">
      {outOfScope.map((item) => (
        <li class="flex items-start gap-2 text-sm text-ink-2">
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-risk"></span>
          {item}
        </li>
      ))}
    </ul>
  </div>

  {assumptions.length > 0 && (
    <div class={assumeCol}>
      <div class="mb-2 flex items-center gap-1.5">
        <Icon name="light-bulb" class="h-4 w-4 text-signal" />
        <span class="font-mono text-xs font-bold uppercase tracking-[0.11em] text-signal">Assumptions</span>
      </div>
      <ul class="space-y-1.5">
        {assumptions.map((item) => (
          <li class="flex items-start gap-2 text-sm text-ink-2">
            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-signal"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
