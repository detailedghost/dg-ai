---
/**
 * Shared full-screen "you're done" terminal overlay — the pattern PrototypeSwitcher's
 * #ps-overlay pioneered, reused here by PrDecisionSection and ReviewSection. Dark,
 * viewport-fixed, centered; never auto-hides on a timer. Show it via showDoneOverlay()
 * in ../lib/doneOverlay.ts; a dismissLabel wires its own hide button, no caller JS needed.
 *
 * PrototypeSwitcher keeps its own inline copy of this pattern on purpose — see the note
 * in ../lib/doneOverlay.ts for why.
 */
interface Props {
  id: string
  message?: string | null
  visible?: boolean
  /** Checkmark color — 'approve' for a genuine approval, 'neutral' for anything else (comment, PR actions, etc). */
  tone?: 'approve' | 'neutral'
  /** Omit to match PrDecisionSection's overlay (no way back once shown). Set to add a hide button. */
  dismissLabel?: string
  /** Optional clickable link (e.g. the opened PR URL) rendered as a primary button in the overlay. */
  link?: string
  linkLabel?: string
}
const { id, message = null, visible = false, tone = 'neutral', dismissLabel, link, linkLabel = 'View PR →' } = Astro.props
---

<div class={`viz-done-overlay${visible ? '' : ' hidden'}`} id={id} data-tone={tone}>
  <div class='viz-done-check'>✓</div>
  <div class='viz-done-msg' id={`${id}Msg`}>{message ?? ''}</div>
  {link && (
    <a class='viz-done-link' id={`${id}Link`} href={link} target='_blank' rel='noopener'>{linkLabel}</a>
  )}
  <div class='viz-done-hint'>You may close this tab.</div>
  {dismissLabel && (
    <button type='button' class='viz-done-dismiss' id={`${id}Dismiss`}>{dismissLabel}</button>
  )}
</div>

<script>
  // Delegated on document so one listener covers every DoneOverlay instance on the page.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.viz-done-dismiss')
    if (!btn) return
    btn.closest('.viz-done-overlay')?.classList.add('hidden')
  })
</script>

<style>
  .viz-done-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: system-ui, sans-serif;
    animation: viz-done-in 0.25s ease-out;
  }
  .viz-done-overlay.hidden { display: none; }
  @keyframes viz-done-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .viz-done-overlay { animation: none; }
  }

  /* Fixed hex, not host CSS vars — the overlay is deliberately theme-independent (always
     near-black), matching the existing approve-button greens used across these boards. */
  .viz-done-check { font-size: 48px; color: #9ca3af; }
  /* Approve tone → a slick green glowing orb (same green + glow language as the
     waiting-favicon orb and the boards-signal-dot), with the check centered inside. */
  .viz-done-overlay[data-tone='approve'] .viz-done-check {
    width: 104px;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    font-size: 52px;
    background: radial-gradient(circle at 50% 38%, #3fb950, #2ea043 72%);
    box-shadow:
      0 0 0 6px rgba(46, 160, 67, 0.18),
      0 0 34px 6px rgba(46, 160, 67, 0.55),
      inset 0 0 20px rgba(255, 255, 255, 0.25);
    animation: viz-orb-pulse 2.4s ease-in-out infinite;
  }
  @keyframes viz-orb-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 6px rgba(46, 160, 67, 0.18),
        0 0 34px 6px rgba(46, 160, 67, 0.55),
        inset 0 0 20px rgba(255, 255, 255, 0.25);
    }
    50% {
      box-shadow:
        0 0 0 11px rgba(46, 160, 67, 0.10),
        0 0 48px 12px rgba(46, 160, 67, 0.72),
        inset 0 0 22px rgba(255, 255, 255, 0.32);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viz-done-overlay[data-tone='approve'] .viz-done-check { animation: none; }
  }
  .viz-done-msg { font-size: 24px; font-weight: 700; }
  .viz-done-hint { font-size: 16px; opacity: 0.7; }

  /* Primary link (e.g. the opened PR) — green to match the approve orb, with a soft glow. */
  .viz-done-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #2ea043;
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-family: system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 0 18px rgba(46, 160, 67, 0.5);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .viz-done-link:hover {
    background: #3fb950;
    box-shadow: 0 0 26px rgba(46, 160, 67, 0.7);
  }

  .viz-done-dismiss {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    border-radius: 6px;
    padding: 6px 14px;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    cursor: pointer;
  }
  .viz-done-dismiss:hover { background: rgba(255, 255, 255, 0.1); }
</style>
