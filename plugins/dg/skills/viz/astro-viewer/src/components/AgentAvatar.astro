---
interface Props {
  name: string
  class?: string
}
const { name, class: className = 'h-7 w-7' } = Astro.props

const lucidePaths: Record<string, string> = {
  palette:
    '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>',
  terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  'square-terminal': '<path d="m7 11 2-2-2-2"/><path d="M11 13h4"/><rect width="18" height="18" x="3" y="3" rx="2"/>',
  braces:
    '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
  'git-branch': '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  'shield-check':
    '<path d="M20 13c0 5-3.5 7.5-7.5 9-.5.17-1.5.17-2 0C6.5 20.5 3 18 3 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C13.5 3.8 16 5 18 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  eye: '<path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/>',
  compass: '<path d="m16.24 7.76-1.8 5.41a2 2 0 0 1-1.27 1.27L7.76 16.24l1.8-5.41a2 2 0 0 1 1.27-1.27z"/><circle cx="12" cy="12" r="10"/>',
  'file-text':
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  'clipboard-list':
    '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
  'flask-conical':
    '<path d="M10 2v7.53a2 2 0 0 1-.21.9L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.07-10.13a2 2 0 0 1-.21-.89V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>',
  gauge: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
}

const byName: Record<string, string> = {
  design: 'palette',
  js: 'terminal',
  ts: 'terminal',
  shell: 'square-terminal',
  python: 'braces',
  csharp: 'braces',
  dba: 'database',
  devops: 'git-branch',
  security: 'shield-check',
  reviewer: 'eye',
  arch: 'compass',
  lore: 'file-text',
  foreman: 'clipboard-list',
  'qa-code': 'flask-conical',
  'qa-perf': 'gauge',
  'qa-devops': 'git-branch',
  explore: 'search',
}

function iconFor(agent: string): string | null {
  const n = (agent ?? '').toLowerCase().trim().replace(/^dg:/, '')
  if (byName[n]) return byName[n]
  if (n.includes('design')) return 'palette'
  if (n.includes('qa') || n.includes('test')) return 'flask-conical'
  if (n.includes('review')) return 'eye'
  if (n.includes('security')) return 'shield-check'
  if (n.includes('research') || n.includes('explore') || n.includes('discover')) return 'search'
  if (n.includes('doc') || n.includes('lore')) return 'file-text'
  if (n.includes('spec') || n.includes('plan')) return 'clipboard-list'
  if (n.includes('perf')) return 'gauge'
  if (n.includes('db') || n.includes('sql')) return 'database'
  if (n.includes('ops') || n.includes('ci')) return 'git-branch'
  if (n.includes('arch')) return 'compass'
  if (n.includes('js') || n.includes('ts') || n.includes('code') || n.includes('dev')) return 'terminal'
  return null
}

const icon = iconFor(name)
---

<span
  class={`inline-flex shrink-0 items-center justify-center rounded-full bg-panel-2 text-mid ${className}`}
  title={name}
>
  {icon ? (
    <svg
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='1.8'
      stroke-linecap='round'
      stroke-linejoin='round'
      class='h-[55%] w-[55%]'
      aria-hidden='true'
      set:html={lucidePaths[icon]}
    />
  ) : (
    <span class='font-mono text-[0.6rem] font-bold'>{(name ?? '?').slice(0, 2).toUpperCase()}</span>
  )}
</span>
