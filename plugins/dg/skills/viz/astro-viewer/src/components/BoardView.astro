---
import Callout from './Callout.astro'
import SpecStatusBadge from './SpecStatusBadge.astro'
import StartWorkBanner from './StartWorkBanner.astro'
import BlockersSection from '../sections/BlockersSection.astro'
import ErrorsSection from '../sections/ErrorsSection.astro'
import LinksSection from '../sections/LinksSection.astro'
import PullRequestsSection from '../sections/PullRequestsSection.astro'
import JiraTicketsSection from '../sections/JiraTicketsSection.astro'
import ChecklistSection from '../sections/ChecklistSection.astro'
import CodeSamplesSection from '../sections/CodeSamplesSection.astro'
import ContractsSection from '../sections/ContractsSection.astro'
import DecisionsSection from '../sections/DecisionsSection.astro'
import DiscoveriesSection from '../sections/DiscoveriesSection.astro'
import NextStepsSection from '../sections/NextStepsSection.astro'
import OpenQuestionsSection from '../sections/OpenQuestionsSection.astro'
import PhasesSection from '../sections/PhasesSection.astro'
import ResolvedQuestionsSection from '../sections/ResolvedQuestionsSection.astro'
import RisksSection from '../sections/RisksSection.astro'
import RoundtableSection from '../sections/RoundtableSection.astro'
import ScopeSection from '../sections/ScopeSection.astro'
import SlicesSection from '../sections/SlicesSection.astro'
import TracksSection from '../sections/TracksSection.astro'
import ApprovalSection from '../sections/ApprovalSection.astro'
import PrDecisionSection from '../sections/PrDecisionSection.astro'
import PermissionsSection from '../sections/PermissionsSection.astro'
import LineageSection from '../sections/LineageSection.astro'
import ReviewSection from '../sections/ReviewSection.astro'
import CytoscapeSection from '../sections/CytoscapeSection.astro'
import EvidenceSection from '../sections/EvidenceSection.astro'
import DocSection from '../sections/DocSection.astro'
import { isAnswered } from '../lib/payload.ts'
import { registry } from '../sections/registry.ts'

// Explicit id→component map — no dynamic imports, Astro can't glob SSR components.
const SECTION_COMPONENTS: Record<string, any> = {
  'scope': ScopeSection,
  'phases': PhasesSection,
  'slices': SlicesSection,
  'tracks': TracksSection,
  'contracts': ContractsSection,
  'discoveries': DiscoveriesSection,
  'risks': RisksSection,
  'blockers': BlockersSection,
  'errors': ErrorsSection,
  'links': LinksSection,
  'pull-requests': PullRequestsSection,
  'jira-tickets': JiraTicketsSection,
  'roundtable': RoundtableSection,
  'decisions': DecisionsSection,
  'checklist': ChecklistSection,
  'open-questions': OpenQuestionsSection,
  'resolved-questions': ResolvedQuestionsSection,
  'next-steps': NextStepsSection,
  'code-samples': CodeSamplesSection,
  'approval': ApprovalSection,
  'pr-decision': PrDecisionSection,
  'permissions': PermissionsSection,
  'lineage': LineageSection,
  'review': ReviewSection,
  'cytoscape': CytoscapeSection,
  'evidence': EvidenceSection,
  'doc': DocSection,
}

interface Props {
  payload: any
  mode: string
  startCommand?: string
  liveCommand?: string
}
const { payload, mode, startCommand, liveCommand } = Astro.props

const phases = payload.phases ?? []
const phaseWeight: Record<string, number> = { done: 1, partial: 0.5, in_progress: 0.5 }

const decisions = payload.decisions ?? []
const answeredDecisions = decisions.filter((d: any) => isAnswered(d.answer)).length
const openQs = payload.open_questions?.length ?? 0
const resolvedQs = payload.open_questions_resolved?.length ?? 0
const planningTotal = decisions.length + openQs + resolvedQs
const planningDone = answeredDecisions + resolvedQs
const inPlanning = decisions.length - answeredDecisions + openQs > 0

const implPct =
  phases.length > 0
    ? Math.round(
        (phases.reduce((sum: number, p: any) => sum + (phaseWeight[p.status] ?? 0), 0) / phases.length) * 100,
      )
    : -1

function progressState(): { pct: number; label: string; detail: string } {
  if (payload.completion_pct !== undefined) return { pct: payload.completion_pct, label: 'Progress', detail: '' }
  if (inPlanning && planningTotal > 0) {
    return {
      pct: Math.round((planningDone / planningTotal) * 100),
      label: 'Planning',
      detail: `${planningDone}/${planningTotal} answered`,
    }
  }
  if (implPct >= 0) {
    const done = phases.filter((p: any) => p.status === 'done').length
    return { pct: implPct, label: 'Implementation', detail: `${done}/${phases.length} phases done` }
  }
  return { pct: -1, label: '', detail: '' }
}

const { pct, label: progressLabel, detail: progressDetail } = progressState()

function barColorFor(p: number): string {
  if (p < 33) return 'bg-risk'
  if (p < 67) return 'bg-signal'
  return 'bg-accent'
}

const barColor = barColorFor(pct)

function progressBadge(label: string): string {
  return label
}

const dotClass: Record<string, string> = {
  pending: 'bg-mid',
  done: 'bg-accent',
  partial: 'bg-signal',
  in_progress: 'bg-progress',
  blocked: 'bg-risk',
  skipped: 'bg-rule',
}
const pillClass: Record<string, string> = {
  pending: 'bg-panel-2 text-mid',
  done: 'bg-accent-soft text-accent',
  partial: 'bg-signal-soft text-signal',
  in_progress: 'bg-progress-soft text-progress',
  blocked: 'bg-risk-soft text-risk',
  skipped: 'bg-panel-2 text-mid',
}

const activeRegistryEntries = registry.filter((entry) => entry.applies(payload as Record<string, unknown>))

// Review boards own their whole chrome (proto-A layout: banner/tabs/nav/diff pane) —
// none of the progress-bar/phase/decision scaffolding below applies, so skip straight there.
const isReview = mode === 'review'
---

{isReview ? (
  <div class='-mx-4 -mt-6 -mb-16 sm:-mx-6 sm:-mt-10'>
    {/* ReviewSection renders --demo assets as its own Demo tab, so no standalone demo section
        here. That left sections/DemoSection.astro with no caller at all — the registry never
        had a demo entry — so it is dead but kept rather than deleted (this tree is unversioned). */}
    <ReviewSection payload={payload} mode={mode} inPlanning={false} collapsed={false} />
  </div>
) : (
<div class='space-y-10'>
  {payload.spec_status && (
    <SpecStatusBadge
      status={payload.spec_status.status}
      version={payload.spec_status.version}
      date={payload.spec_status.date}
      feature={payload.spec_status.feature}
    />
  )}
  {startCommand && <StartWorkBanner command={startCommand} liveCommand={liveCommand} />}

  {(pct >= 0 || phases.length > 0) && (
    <div class='sticky top-0 z-20 -mx-4 mb-8 border-b border-rule-soft bg-ground/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6'>
      {pct >= 0 && (
        <div class='mb-3'>
          {progressLabel && (
            <div class='mb-1.5 flex items-center gap-2 font-mono text-[0.68rem]'>
              <span
                class={`font-bold uppercase tracking-[0.11em] ${progressLabel === 'Planning' ? 'text-signal' : 'text-progress'}`}
              >
                {progressBadge(progressLabel)}
              </span>
              {progressDetail && <span class='text-mid'>· {progressDetail}</span>}
            </div>
          )}
          <div class='flex items-center gap-3'>
            <span class='w-8 shrink-0 text-right font-mono text-xs font-semibold tabular-nums text-mid'>
              {pct}%
            </span>
            <div class='h-1.5 flex-1 overflow-hidden rounded-full bg-panel-2'>
              <div class={`h-full rounded-full transition-all ${barColor}`} style={`width:${pct}%`} />
            </div>
          </div>
        </div>
      )}
      {phases.length > 0 && (
        <div class='flex flex-wrap gap-2'>
          {phases.map((p: any) => (
            <a
              href='#phases'
              class={`inline-flex items-center gap-1.5 rounded px-3 py-1 text-xs font-medium no-underline ${pillClass[p.status] ?? pillClass.pending}`}
            >
              <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${dotClass[p.status] ?? 'bg-mid'}`} />
              {p.label}
            </a>
          ))}
        </div>
      )}
    </div>
  )}

  {activeRegistryEntries.filter((entry) => entry.id !== 'review').map((entry) => {
    const Component = SECTION_COMPONENTS[entry.id]
    if (!Component) return null
    const collapsed = !!entry.collapseInImpl && !inPlanning
    return <Component payload={payload} mode={mode} inPlanning={inPlanning} collapsed={collapsed} />
  })}

  {payload.notes && <Callout type='note' title='Notes'>{payload.notes}</Callout>}

  <slot />
</div>
)}
