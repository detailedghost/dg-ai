---
import Icon from './Icon.astro'

interface Props {
  type: 'info' | 'warning' | 'note' | 'tip'
  title?: string
}
const { type, title } = Astro.props

const styles: Record<string, { border: string; bg: string; icon: string; iconColor: string; label: string }> = {
  info:    { border: 'border-accent', bg: 'bg-accent-soft', icon: 'information-circle', iconColor: 'text-accent', label: 'Info' },
  warning: { border: 'border-risk',   bg: 'bg-risk-soft',   icon: 'exclamation-triangle', iconColor: 'text-risk', label: 'Warning' },
  note:    { border: 'border-rule',   bg: 'bg-panel-2',     icon: 'document-text',      iconColor: 'text-mid',  label: 'Note' },
  tip:     { border: 'border-accent', bg: 'bg-accent-soft', icon: 'check-circle',        iconColor: 'text-accent', label: 'Tip' },
}
const s = styles[type] ?? styles.info
---

<div class={`my-4 rounded border-l-[3px] p-4 ${s.border} ${s.bg}`}>
  {
    (title || type) && (
      <div class="mb-1.5 flex items-center gap-1.5">
        <Icon name={s.icon} class={`h-3.5 w-3.5 ${s.iconColor}`} />
        <span class={`font-mono text-[0.66rem] font-bold uppercase tracking-[0.11em] ${s.iconColor}`}>
          {title || s.label}
        </span>
      </div>
    )
  }
  <div class="text-sm leading-relaxed text-ink-2">
    <slot />
  </div>
</div>
