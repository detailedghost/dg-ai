---
import type { Agent, Recommendation } from '../types'
import AgentAvatar from './AgentAvatar.astro'
import Icon from './Icon.astro'

interface Props {
  agents: Agent[]
}

const { agents } = Astro.props

const flavorBadge: Record<Recommendation['flavor'], string> = {
  edit: 'bg-progress-soft text-progress',
  escalate: 'bg-signal-soft text-signal',
  prototype: 'bg-accent-soft text-accent',
}

const outcomeColor: Record<NonNullable<Recommendation['outcome']>, string> = {
  accepted: 'text-accent',
  rejected: 'text-risk',
  deferred: 'text-signal',
}

const rows = agents.flatMap((agent) => agent.recommendations.map((rec) => ({ ...rec, agent: agent.name })))
---

<div class='divide-y divide-rule-soft rounded border border-rule bg-panel'>
  {rows.map((row) => (
    <details class='group'>
      <summary class='flex cursor-pointer select-none items-center gap-3 px-4 py-2.5 hover:bg-panel-2'>
        <AgentAvatar name={row.agent} />
        <span class='w-16 shrink-0 truncate font-mono text-[0.62rem] uppercase tracking-wide text-mid'>
          {row.agent}
        </span>
        <span class='w-[5.25rem] shrink-0'>
          <span class={`rounded px-1.5 py-0.5 font-mono text-[0.62rem] font-medium uppercase ${flavorBadge[row.flavor]}`}>
            {row.flavor}
          </span>
        </span>
        <p class='min-w-0 flex-1 text-sm text-ink-2'>{row.text}</p>
        <span class={`shrink-0 text-xs font-medium ${row.outcome ? outcomeColor[row.outcome] : 'text-mid'}`}>
          {row.outcome ?? 'untriaged'}
        </span>
        <Icon name='chevron-right' class='h-3 w-3 shrink-0 text-mid transition-transform group-open:rotate-90' />
      </summary>
      <div class='border-t border-rule-soft bg-panel-2 px-4 py-3 sm:pl-[8.5rem]'>
        {row.detail ? (
          <p class='text-sm leading-relaxed text-ink-2'>{row.detail}</p>
        ) : (
          <p class='text-sm italic text-mid'>No further detail was given.</p>
        )}
      </div>
    </details>
  ))}
</div>
