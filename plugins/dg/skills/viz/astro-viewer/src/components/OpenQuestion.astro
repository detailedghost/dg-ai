---
interface Props {
  index: number
  text: string
}
const { index, text } = Astro.props
---

<div class="my-2 flex items-start gap-3 rounded border-l-[3px] border-signal bg-signal-soft px-3 py-2">
  <span
    class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-signal font-mono text-xs font-bold text-on-fill"
  >
    {index}
  </span>
  <span class="text-sm text-ink-2">{text}</span>
</div>
