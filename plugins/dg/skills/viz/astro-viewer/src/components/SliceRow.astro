---
import Icon from './Icon.astro'

interface Props {
  id: number | string
  name: string
  status: 'pending' | 'done' | 'partial' | 'blocked' | 'skipped'
  description?: string
  dependsOn?: Array<string | number>
  agents?: { primary?: string; qa?: string[]; proxy?: string }
  ready?: boolean
  contractHref?: string
}

const { id, name, status, description, dependsOn = [], agents = {}, ready = false, contractHref } = Astro.props
const isProxied = Boolean(agents.proxy)

const statusConfig: Record<Props['status'], { label: string; icon: string; classes: string }> = {
  pending: { label: 'pending', icon: 'clock', classes: 'bg-panel-2 text-mid' },
  done: { label: 'done', icon: 'check-circle', classes: 'bg-accent-soft text-accent' },
  partial: { label: 'partial', icon: 'arrow-path', classes: 'bg-progress-soft text-progress' },
  blocked: { label: 'blocked', icon: 'no-symbol', classes: 'bg-risk-soft text-risk' },
  skipped: { label: 'skipped', icon: 'chevron-right', classes: 'bg-signal-soft text-signal' },
}

const cfg = statusConfig[status]
// A left rule marks the two states worth spotting from across the table: unblocked work
// (accent) and work handed to an external agent (progress). Proxy wins when both apply.
const railClass = isProxied ? 'border-l-[3px] border-l-progress' : ready ? 'border-l-[3px] border-l-accent' : ''
---

<tr id={`slice-${id}`} class='scroll-mt-8 border-t border-rule-soft align-top hover:bg-panel-2'>
  <td class={`px-3 py-2.5 font-mono text-xs text-mid ${railClass}`}>#{id}</td>
  <td class='px-3 py-2.5'>
    <p class='font-display font-medium text-ink'>{name}</p>
    {description && <p class='mt-0.5 text-xs text-mid'>{description}</p>}
    {contractHref && (
      <a
        href={contractHref}
        class='mt-1 inline-flex items-center gap-1 text-xs font-medium text-accent transition-colors hover:underline'
      >
        <Icon name='server' class='h-3 w-3' />
        contract
      </a>
    )}
  </td>
  <td class='whitespace-nowrap px-3 py-2.5'>
    <span class={`inline-flex items-center gap-1 rounded px-1.5 py-0.5 font-mono text-[0.62rem] font-bold uppercase ${cfg.classes}`}>
      <Icon name={cfg.icon} class='h-3 w-3' />
      {cfg.label}
    </span>
    {ready && (
      <span class='mt-1 flex items-center gap-1 font-mono text-[0.62rem] font-bold uppercase text-accent'>
        <Icon name='bolt' class='h-3 w-3' />
        ready
      </span>
    )}
  </td>
  <td class='px-3 py-2.5 text-xs text-ink-2'>
    {agents.primary && <span class='block'>{agents.primary}</span>}
    {agents.qa && agents.qa.length > 0 && <span class='block text-mid'>qa: {agents.qa.join(', ')}</span>}
    {isProxied && (
      <span class='mt-0.5 inline-flex items-center gap-1 rounded bg-progress-soft px-1.5 py-0.5 font-mono text-[0.62rem] font-bold uppercase text-progress'>
        <Icon name='arrow-right-circle' class='h-3 w-3' />
        proxy: {agents.proxy}
      </span>
    )}
    {!agents.primary && !(agents.qa && agents.qa.length > 0) && !isProxied && <span class='text-mid'>—</span>}
  </td>
  <td class='whitespace-nowrap px-3 py-2.5 font-mono text-xs text-mid'>
    {dependsOn.length > 0 ? `#${dependsOn.join(', #')}` : '—'}
  </td>
</tr>
