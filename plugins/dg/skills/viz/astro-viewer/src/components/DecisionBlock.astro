---
import Icon from './Icon.astro'
import { roleName, threadBubbleClass, threadLabelClass } from '../lib/thread'
import type { ThreadEntry } from '../types'

interface Props {
  question: string
  answer: string
  rationale?: string
  thread?: ThreadEntry[]
}

const { question, answer, rationale, thread = [] } = Astro.props

const isResolved = answer && answer.trim() !== '' && answer.toLowerCase() !== 'tbd'
const inDiscussion = !isResolved && thread.length > 0
const autoOpen = thread.length <= 2
// Multi-select answers arrive newline-joined; render >1 value as chips.
const answerParts = isResolved ? String(answer).split('\n').map((s) => s.trim()).filter(Boolean) : []
const isMulti = answerParts.length > 1
---

<div class="my-3 rounded border border-rule bg-panel">
  <div class="px-4 pt-3 pb-2">
    <p class="mb-1 text-xs text-mid">{question}</p>
    {isResolved && isMulti && (
      <ul class="flex flex-wrap gap-1.5">
        {answerParts.map((p) => (
          <li class="rounded bg-accent-soft px-2 py-0.5 text-sm font-medium text-accent">{p}</li>
        ))}
      </ul>
    )}
    {isResolved && !isMulti && (
      <p class="font-display font-semibold text-ink">{answer}</p>
    )}
    {!isResolved && inDiscussion && (
      <span class="inline-flex items-center gap-1.5 rounded bg-progress-soft px-2 py-0.5 font-mono text-xs font-semibold text-progress">
        <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-progress"></span>
        in discussion
      </span>
    )}
    {!isResolved && !inDiscussion && (
      <span class="inline-block rounded bg-signal-soft px-2 py-0.5 font-mono text-xs font-semibold text-signal">
        awaiting input ↓
      </span>
    )}
  </div>

  {thread.length > 0 && (
    <details class="group border-t border-rule-soft" open={autoOpen || undefined}>
      <summary class="flex cursor-pointer select-none items-center gap-2 px-4 py-2 text-xs text-mid transition-colors hover:text-ink">
        <Icon name="chevron-right" class="h-3 w-3 transition-transform duration-150 group-open:rotate-90" />
        Discussion · {thread.length} {thread.length === 1 ? 'message' : 'messages'}
      </summary>
      <div class="space-y-2 px-4 pb-3">
        {thread.map((msg) => (
          <div class={`rounded px-3 py-2 text-sm ${threadBubbleClass(msg.role)}`}>
            <p class={`mb-1 font-mono text-xs font-semibold ${threadLabelClass(msg.role)}`}>{roleName(msg.role)}</p>
            <p class="text-ink-2">{msg.text}</p>
          </div>
        ))}
      </div>
    </details>
  )}

  {rationale && thread.length === 0 && (
    <div class="border-t border-rule-soft px-4 py-2">
      <p class="text-xs italic text-mid">{rationale}</p>
    </div>
  )}
</div>
