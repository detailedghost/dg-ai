---
interface Props {
  command: string
  liveCommand?: string
}
const { command, liveCommand } = Astro.props
---

<div class="mb-8 rounded border border-rule border-l-[3px] border-l-accent bg-accent-soft/30 px-5 py-4">
  <div class="flex items-center gap-2">
    <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-accent"></span>
    <p class="text-sm font-semibold text-accent">Ready to build — start the work:</p>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <code class="rounded bg-panel px-2 py-1 font-mono text-xs text-ink-2 ring-1 ring-rule">{command}</code>
    <button
      type="button"
      data-copy-text={command}
      title="Copy command"
      class="rounded px-2 py-1 text-xs text-mid transition-colors hover:bg-accent-soft hover:text-accent"
    >
      Copy
    </button>
  </div>

  {liveCommand && (
    <div class="mt-3 border-t border-rule-soft pt-3">
      <p class="mb-1.5 text-xs text-mid">…or run it so progress streams back to this board live:</p>
      <div class="flex flex-wrap items-start gap-2">
        <code class="flex-1 rounded bg-panel px-2 py-1 font-mono text-[11px] leading-relaxed text-ink-2 ring-1 ring-rule">{liveCommand}</code>
        <button
          type="button"
          data-copy-text={liveCommand}
          title="Copy live-update command"
          class="shrink-0 rounded px-2 py-1 text-xs text-mid transition-colors hover:bg-accent-soft hover:text-accent"
        >
          Copy
        </button>
      </div>
    </div>
  )}
</div>
