---
import AgentAvatar from '../components/AgentAvatar.astro'
import Icon from '../components/Icon.astro'
import RoundtableFindings from '../components/RoundtableFindings.astro'
import type { Agent, Recommendation } from '../types'

interface Props {
  payload: Record<string, unknown>
}
const { payload } = Astro.props

const interactive = !!payload.roundtable_interactive
const agents = (payload.roundtable ?? []) as Agent[]

const flavorBadge: Record<Recommendation['flavor'], string> = {
  edit: 'bg-progress-soft text-progress',
  escalate: 'bg-signal-soft text-signal',
  prototype: 'bg-accent-soft text-accent',
}

const outcomeColor: Record<NonNullable<Recommendation['outcome']>, string> = {
  accepted: 'text-accent',
  rejected: 'text-risk',
  deferred: 'text-signal',
}
function outcomeLabel(o: NonNullable<Recommendation['outcome']>): string {
  return o.charAt(0).toUpperCase() + o.slice(1)
}

const triageRows = agents.flatMap((agent, agentIdx) =>
  agent.recommendations.map((rec, recIdx) => ({ ...rec, agent: agent.name, agentIdx, recIdx })),
)
---

<section id='roundtable'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='user-group' class='h-5 w-5 text-accent' /> Roundtable
  </h2>

  {interactive ? (
    <div id='rt-triage' class='space-y-3'>
      <div class='divide-y divide-rule-soft rounded border border-rule bg-panel'>
        {triageRows.map((row) => (
          <details class='group' data-rt-row>
            <summary class='flex cursor-pointer select-none items-center gap-3 px-4 py-2.5 hover:bg-panel-2'>
              <AgentAvatar name={row.agent} />
              <span class='w-16 shrink-0 truncate font-mono text-[0.62rem] uppercase tracking-wide text-mid'>
                {row.agent}
              </span>
              <span class='w-[5.25rem] shrink-0'>
                <span class={`rounded px-1.5 py-0.5 font-mono text-[0.62rem] font-medium uppercase ${flavorBadge[row.flavor]}`}>
                  {row.flavor}
                </span>
              </span>
              <p class='min-w-0 flex-1 text-sm text-ink-2'>{row.text}</p>
              {row.outcome ? (
                <span class={`shrink-0 text-xs font-medium ${outcomeColor[row.outcome]}`}>
                  {outcomeLabel(row.outcome)}
                </span>
              ) : (
                <span class='flex shrink-0 items-center gap-1.5' data-rt-actions>
                  <button
                    type='button'
                    class='rt-triage-btn rounded bg-accent-soft px-2 py-1 font-mono text-xs font-medium text-accent hover:bg-accent-soft/70'
                    data-agent={String(row.agentIdx)}
                    data-rec={String(row.recIdx)}
                    data-answer='accepted'
                  >Accept</button>
                  <button
                    type='button'
                    class='rt-triage-btn rounded bg-risk-soft px-2 py-1 font-mono text-xs font-medium text-risk hover:bg-risk-soft/70'
                    data-agent={String(row.agentIdx)}
                    data-rec={String(row.recIdx)}
                    data-answer='rejected'
                  >Reject</button>
                  <button
                    type='button'
                    class='rt-triage-btn rounded bg-signal-soft px-2 py-1 font-mono text-xs font-medium text-signal hover:bg-signal-soft/70'
                    data-agent={String(row.agentIdx)}
                    data-rec={String(row.recIdx)}
                    data-answer='deferred'
                  >Defer</button>
                </span>
              )}
              <Icon name='chevron-right' class='h-3 w-3 shrink-0 text-mid transition-transform group-open:rotate-90' />
            </summary>
            <div class='border-t border-rule-soft bg-panel-2 px-4 py-3 sm:pl-[8.5rem]'>
              {row.detail ? (
                <p class='text-sm leading-relaxed text-ink-2'>{row.detail}</p>
              ) : (
                <p class='text-sm italic text-mid'>No further detail was given.</p>
              )}
            </div>
          </details>
        ))}
      </div>
      <div id='rt-error' class='hidden rounded border-l-[3px] border-risk bg-risk-soft px-4 py-3 text-sm text-risk'></div>
    </div>
  ) : (
    <RoundtableFindings agents={agents} />
  )}
</section>

<script>
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'

  // Delegate on document, not #rt-triage: refreshRegions() swaps viz-main's innerHTML on every
  // payload rev, replacing #rt-triage and orphaning a listener bound to it. document is never swapped.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.rt-triage-btn')
    if (!btn) return

    // The buttons live inside a <summary>, whose default action would expand the row on triage.
    e.preventDefault()

    const { slug, nonce } = readVizMeta()
    const errorEl = document.getElementById('rt-error')

    const agent = Number(btn.dataset.agent)
    const rec = Number(btn.dataset.rec)
    const answer = btn.dataset.answer as 'accepted' | 'rejected' | 'deferred'

    btn.disabled = true

    try {
      const answers = [{ type: 'recommendation', agent, rec, answer }]
      const hmac = await signAnswers(slug, answers)
      const res = await respond(slug, nonce, hmac, answers)

      if (res.ok) {
        const actions = btn.closest('[data-rt-actions]')
        if (actions) {
          const label = document.createElement('span')
          const colorMap: Record<string, string> = {
            accepted: 'text-accent',
            rejected: 'text-risk',
            deferred: 'text-signal',
          }
          label.className = `shrink-0 text-xs font-medium ${colorMap[answer] ?? 'text-mid'}`
          label.textContent = answer.charAt(0).toUpperCase() + answer.slice(1)
          actions.replaceWith(label)
        }
      } else {
        const msg = await res.text()
        if (errorEl) {
          errorEl.textContent = `Error ${res.status}: ${msg}`
          errorEl.classList.remove('hidden')
        }
        btn.disabled = false
      }
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = String(err)
        errorEl.classList.remove('hidden')
      }
      btn.disabled = false
    }
  })
</script>
