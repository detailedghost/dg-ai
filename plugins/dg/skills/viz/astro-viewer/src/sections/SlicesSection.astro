---
import Icon from '../components/Icon.astro'
import SliceRow from '../components/SliceRow.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props

const slices: any[] = payload.slices ?? []
const contracts: any[] = payload.contracts ?? []
const statusById = new Map(slices.map((sl: any) => [String(sl.id), sl.status ?? 'pending']))

function isReady(sl: any): boolean {
  return (
    (sl.status ?? 'pending') === 'pending' &&
    (sl.dependsOn ?? []).every((d: any) => statusById.get(String(d)) === 'done')
  )
}

const readyCount = slices.filter(isReady).length
const doneSlices = slices.filter((sl: any) => sl.status === 'done').length
const sliceHasContract = new Set(
  contracts.filter((c: any) => c.sliceId !== undefined).map((c: any) => String(c.sliceId)),
)
const contractAnchor = (sliceId: any) => `contract-${String(sliceId)}`
---

<section id='slices'>
  <h2 class='mb-1 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='queue-list' class='h-5 w-5 text-accent' /> Slices
    <span class='ml-auto font-mono text-sm font-normal text-mid'>{doneSlices} / {slices.length} done</span>
  </h2>
  <p class='mb-4 text-xs text-mid'>
    {readyCount > 0 ? `${readyCount} ready to start` : 'Nothing unblocked yet'} · dependencies must be done first
  </p>
  <div class='overflow-x-auto rounded border border-rule'>
    <table class='w-full text-sm'>
      <thead>
        <tr class='bg-panel-2 text-left font-mono text-[0.66rem] uppercase tracking-wide text-mid'>
          <th class='px-3 py-2 font-bold'>#</th>
          <th class='px-3 py-2 font-bold'>Slice</th>
          <th class='px-3 py-2 font-bold'>Status</th>
          <th class='px-3 py-2 font-bold'>Agents</th>
          <th class='px-3 py-2 font-bold'>Depends on</th>
        </tr>
      </thead>
      <tbody class='bg-panel'>
        {slices.map((sl: any) => (
          <SliceRow
            id={sl.id}
            name={sl.name}
            status={sl.status ?? 'pending'}
            description={sl.description}
            dependsOn={sl.dependsOn ?? []}
            agents={sl.agents ?? {}}
            ready={isReady(sl)}
            contractHref={sliceHasContract.has(String(sl.id)) ? `#${contractAnchor(sl.id)}` : undefined}
          />
        ))}
      </tbody>
    </table>
  </div>
</section>
