---
import Icon from '../components/Icon.astro'
import RiskBox from '../components/RiskBox.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props
---

<section id='risks'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='exclamation-triangle' class='h-5 w-5 text-risk' /> Risks
  </h2>
  {(payload.risks ?? []).map((r: any) => (
    <RiskBox severity={r.severity} title={r.title} body={r.body} />
  ))}
</section>
