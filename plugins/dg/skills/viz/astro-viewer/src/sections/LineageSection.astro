---
import Icon from "../components/Icon.astro"
import type { LineageGraph, LineageNode, LineageEdge, LineagePayload } from "../types.ts"

interface Props {
  payload: LineagePayload
  mode: string
  inPlanning?: boolean
  collapsed?: boolean
}
const { payload } = Astro.props

const lineage: LineageGraph = payload.lineage ?? { nodes: [], edges: [] }
const nodes: LineageNode[] = lineage.nodes ?? []
const edges: LineageEdge[] = lineage.edges ?? []
const narrative: string | undefined = lineage.narrative
const graphData = JSON.stringify({ nodes, edges }).replace(/</g, "\\u003c")
---

<section id='lineage'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='chart-bar' class='h-5 w-5 text-accent' />
    Lineage
  </h2>

  <div class='lineage-wrap'>
    <!-- graph canvas -->
    <div class='lineage-canvas-wrap'>
      <div id='lineage-legend' class='lineage-legend'>
        <div class='lg-row'><span class='lg-swatch legend-target'></span>Target</div>
        <div class='lg-row'><span class='lg-swatch legend-up'></span>Upstream</div>
        <div class='lg-row'><span class='lg-swatch legend-down'></span>Downstream</div>
        <div class='lg-sep'></div>
        <div class='lg-row'><span class='lg-swatch edge-solid'></span>Proven</div>
        <div class='lg-row'><span class='lg-swatch edge-dashed'></span>Inferred</div>
        <div class='lg-row'><span class='lg-swatch edge-back'></span>↺ back-edge</div>
        <div class='lg-row'><span class='lg-swatch stub'></span>+N collapsed</div>
      </div>
      <div id='lineage-cy' class='lineage-cy'></div>
      <button id='lineage-fit' class='lineage-fit-btn' title='fit graph' type='button'>fit</button>
    </div>

    <!-- right slide-in panel -->
    <aside id='lineage-panel' class='lineage-panel'>
      <div class='lineage-panel-head'>
        <button type='button' id='lineage-close-panel' class='lineage-close-btn' title='close'>×</button>
      </div>
      <div id='lineage-panel-body' class='lineage-panel-body'></div>
    </aside>
  </div>

  {narrative && (
    <div class='lineage-narrative'>
      <h3 class='lineage-narrative-title'>Narrative</h3>
      <p class='lineage-narrative-text'>{narrative}</p>
    </div>
  )}
</section>

<!-- embed graph data for client island; is:inline prevents Astro from treating this as a module script -->
<script is:inline type="application/json" id="lineage-data" set:html={graphData}></script>

<style>
  .lineage-wrap {
    display: grid;
    /* panel column starts collapsed; JS adds .open on <aside> which triggers the grid track to expand */
    grid-template-columns: 1fr 0px;
    transition: grid-template-columns 0.22s ease;
    gap: 0;
  }
  /* when panel is open, allocate 300px for it — canvas shrinks, nothing is hidden */
  .lineage-wrap:has(.lineage-panel.open) {
    grid-template-columns: 1fr 300px;
  }
  .lineage-canvas-wrap {
    position: relative;
    min-width: 0; /* allow shrink inside grid */
    height: 520px;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%);
    border: 1px solid #2b3a52;
  }
  .lineage-cy {
    width: 100%;
    height: 100%;
  }
  .lineage-legend {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 20;
    background: rgba(16, 26, 42, 0.94);
    border: 1px solid #2b3a52;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
    color: #cfe0f5;
    max-width: 200px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }
  .lg-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lg-sep {
    height: 1px;
    background: #2b3a52;
    margin: 6px 0;
  }
  .lg-swatch {
    width: 22px;
    height: 13px;
    border-radius: 3px;
    flex: 0 0 auto;
    display: inline-block;
  }
  .lg-swatch.legend-target { background: #3a2d05; border: 2px solid #ffd13a; }
  .lg-swatch.legend-up { background: #0e2138; border: 2px solid #3aa0ff; }
  .lg-swatch.legend-down { background: #082a25; border: 2px solid #22d3a8; }
  .lg-swatch.edge-solid { height: 0; border-top: 3px solid #4cc9f0; border-radius: 0; }
  .lg-swatch.edge-dashed { height: 0; border-top: 3px dashed #ffae42; border-radius: 0; }
  .lg-swatch.edge-back { height: 0; border-top: 3px dashed #ff5d73; border-radius: 0; }
  .lg-swatch.stub { background: repeating-linear-gradient(45deg, #2b3a52 0 4px, #101d30 4px 8px); border: 1px dashed #6b7a92; }

  .lineage-fit-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 20;
    cursor: pointer;
    border: none;
    background: #1e293b;
    color: #fff;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
  }
  .lineage-fit-btn:hover { background: #334155; }

  /* right slide-in panel — grid child; grid track expands to 300px on .open, this element fills it */
  .lineage-panel {
    width: 300px;
    height: 520px;
    background: #111c2e;
    color: #e6f1ff;
    border-left: 1px solid #2b3a52;
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    overflow-y: auto;
    border-radius: 0 10px 10px 0;
    /* hidden by default: clip content; grid track is 0px so nothing shows */
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.18s ease, visibility 0s linear 0.18s;
  }
  .lineage-panel.open {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.22s ease, visibility 0s linear 0s;
  }
  .lineage-panel-head {
    display: flex;
    justify-content: flex-end;
    padding: 8px 10px 0;
  }
  .lineage-close-btn {
    cursor: pointer;
    border: none;
    background: transparent;
    font-size: 20px;
    color: inherit;
    opacity: 0.6;
  }
  .lineage-close-btn:hover { opacity: 1; }
  .lineage-panel-body {
    padding: 4px 16px 24px;
  }
  .lineage-panel-body h2 {
    margin: 4px 0 2px;
    font-size: 16px;
    font-family: ui-monospace, monospace;
    word-break: break-all;
  }
  .lineage-panel-body h3 {
    margin: 14px 0 3px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.6;
  }
  .lp-kind {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .lp-target { color: #ffd13a; }
  .lp-upstream { color: #3aa0ff; }
  .lp-downstream { color: #22d3a8; }
  .lp-desc {
    margin: 6px 0 8px;
    font-size: 12.5px;
    line-height: 1.55;
    color: #cbd5e1;
  }
  .lp-desc.lp-muted { color: #64748b; font-style: italic; }
  .lp-id {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    opacity: 0.6;
  }
  .lp-cols {
    margin: 0;
    padding-left: 16px;
    font-size: 12px;
  }
  .lp-pre {
    background: #0c1828;
    color: #d6e4ff;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 11px;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
  }
  .lp-ev {
    font-size: 12px;
    background: #0c1828;
    padding: 6px 8px;
    border-radius: 5px;
    margin-top: 3px;
  }
  .lp-stub {
    font-size: 11px;
    background: #1a1500;
    border: 1px dashed #d9a441;
    padding: 5px 8px;
    border-radius: 5px;
    margin-top: 5px;
  }
  .lp-lazy {
    font-size: 11px;
    opacity: 0.65;
    font-style: italic;
  }
  .lp-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .lp-badge.proven { background: #0f2e1a; color: #4ade80; }
  .lp-badge.inferred { background: #2a1e00; color: #fcd34d; }

  .lineage-narrative {
    margin-top: 16px;
    padding: 14px 16px;
    background: #0f172a;
    border-radius: 8px;
    border: 1px solid #2b3a52;
  }
  .lineage-narrative-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #64748b;
    margin: 0 0 6px;
  }
  .lineage-narrative-text {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0;
  }
</style>

<script>
  import cytoscape from 'cytoscape'
  import cytoscapeDagre from 'cytoscape-dagre'

  cytoscape.use(cytoscapeDagre as any)

  // wrapped in an IIFE so the early-return guards below are legal (module top-level return is illegal)
  ;(() => {
  interface RawNode {
    id: string
    label: string
    type: string
    role: string
    columns?: string[]
    sql?: string
    evidence?: string
    description?: string
    verified?: boolean
    collapsed?: number
  }
  interface RawEdge {
    from: string
    to: string
    source: string
    confidence: string
    kind?: string
    evidence?: string
  }

  const dataEl = document.getElementById('lineage-data')
  if (!dataEl) { console.error('[lineage] lineage-data element missing'); return }
  const { nodes, edges } = JSON.parse(dataEl.textContent ?? '{"nodes":[],"edges":[]}') as { nodes: RawNode[]; edges: RawEdge[] }

  const SHAPE_BY_TYPE: Record<string, string> = {
    source: 'round-rectangle',
    staging: 'round-rectangle',
    intermediate: 'rectangle',
    model: 'hexagon',
    view: 'ellipse',
    stub: 'round-rectangle',
  }

  const nodeById = new Map(nodes.map((n) => [n.id, n]))
  const edgeById = new Map(edges.map((e, i) => [`e-${i}`, e]))

  function escHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  const elements = [
    ...nodes.map((n) => ({
      data: {
        id: n.id,
        label: n.collapsed ? `+${n.collapsed} more` : n.label,
        type: n.type,
        role: n.role,
        collapsed: n.collapsed ?? 0,
      },
    })),
    ...edges.map((e, i) => ({
      data: {
        id: `e-${i}`,
        source: e.from,
        target: e.to,
        confidence: e.confidence,
        kind: e.kind ?? 'normal',
        elabel: e.kind === 'back' ? '↺' : '',
      },
    })),
  ]

  const cy = cytoscape({
    container: document.getElementById('lineage-cy'),
    elements,
    style: [
      {
        selector: 'node',
        style: {
          shape: (n: any) => SHAPE_BY_TYPE[n.data('type')] ?? 'round-rectangle',
          label: 'data(label)',
          'font-size': 11,
          'font-family': 'ui-monospace, monospace',
          'text-valign': 'center',
          'text-halign': 'center',
          color: '#dbeafe',
          width: 'label',
          height: 'label',
          padding: '12px',
          'text-wrap': 'wrap',
          'text-max-width': 150,
          'border-width': 2,
          'background-color': '#101d30',
          'border-color': '#2b3a52',
        },
      },
      {
        selector: 'node[role="upstream"]',
        style: { 'border-color': '#3aa0ff', 'background-color': '#0e2138' },
      },
      {
        selector: 'node[role="downstream"]',
        style: { 'border-color': '#22d3a8', 'background-color': '#082a25' },
      },
      {
        selector: 'node[type="dashboard"]',
        style: { shape: 'round-rectangle', 'border-style': 'double', 'border-width': 4 },
      },
      {
        selector: 'node[role="target"]',
        style: {
          'background-color': '#3a2d05',
          'border-color': '#ffd13a',
          'border-width': 5,
          padding: '16px',
          'font-weight': 'bold',
          'font-size': 13,
          color: '#ffe9a8',
          'overlay-color': '#ffd13a',
          'overlay-opacity': 0.2,
          'overlay-padding': 14,
        },
      },
      {
        selector: 'node[type="stub"], node[collapsed > 0]',
        style: { 'border-style': 'dashed', 'border-color': '#6b7a92' },
      },
      {
        selector: 'edge',
        style: {
          width: 2.5,
          'line-color': '#4cc9f0',
          'target-arrow-color': '#4cc9f0',
          'target-arrow-shape': 'triangle',
          'curve-style': 'bezier',
          'arrow-scale': 1.1,
          opacity: 0.95,
        },
      },
      {
        selector: 'edge[confidence="inferred"]',
        style: { 'line-style': 'dashed', 'line-color': '#ffae42', 'target-arrow-color': '#ffae42' },
      },
      {
        selector: 'edge[kind="back"]',
        style: {
          'line-color': '#ff5d73',
          'target-arrow-color': '#ff5d73',
          'line-style': 'dashed',
          'curve-style': 'unbundled-bezier',
          'control-point-distances': [-70],
          'control-point-weights': [0.5],
          label: 'data(elabel)',
          'font-size': 9,
          color: '#ff8a98',
        },
      },
      { selector: '.sel', style: { 'border-width': 4, 'border-color': '#ffffff', 'line-color': '#ffffff', 'target-arrow-color': '#ffffff', 'z-index': 99 } },
      { selector: '.dim', style: { opacity: 0.16 } },
    ] as any,
    layout: {
      name: 'dagre',
      rankDir: 'LR',
      nodeSep: 28,
      rankSep: 95,
      edgeSep: 12,
    } as any,
    wheelSensitivity: 0.5,
    minZoom: 0.2,
    maxZoom: 3,
  })

  // auto-fit once the dagre layout settles so the graph fills the canvas
  cy.one('layoutstop', () => cy.fit(undefined, 40))

  // --- panel ---
  const _panel = document.getElementById('lineage-panel')
  const _panelBody = document.getElementById('lineage-panel-body')
  if (!_panel || !_panelBody) { console.error('[lineage] lineage panel elements missing'); return }
  const panel: HTMLElement = _panel
  const panelBody: HTMLElement = _panelBody

  function openPanel(html: string) {
    panelBody.innerHTML = html
    panel.classList.add('open')
  }
  function closePanel() {
    panel.classList.remove('open')
  }

  function clearHighlight() {
    cy.elements().removeClass('dim sel')
  }

  function highlightNode(node: any) {
    clearHighlight()
    const hood = node.closedNeighborhood()
    cy.elements().addClass('dim')
    hood.removeClass('dim').addClass('sel')
  }
  function highlightEdge(edge: any) {
    clearHighlight()
    cy.elements().addClass('dim')
    edge.connectedNodes().removeClass('dim')
    edge.removeClass('dim').addClass('sel')
  }

  const TYPE_LABEL: Record<string, string> = {
    source: 'Source', staging: 'Staging', intermediate: 'Intermediate',
    model: 'Model', view: 'View', dashboard: 'Dashboard', stub: 'Stub',
  }
  const ROLE_LABEL: Record<string, string> = {
    target: 'Target', upstream: 'Upstream (feeds the target)', downstream: 'Downstream (consumes the target)',
  }

  function nodePanelHtml(n: RawNode): string {
    const cols = (n.columns ?? []).map((c) => `<li><code>${escHtml(c)}</code></li>`).join('')
    const desc = n.description
      ? `<p class="lp-desc">${escHtml(n.description)}</p>`
      : `<p class="lp-desc lp-muted">No description in dbt docs.</p>`
    return `
      <div class="lp-kind lp-${n.role}">${(ROLE_LABEL[n.role] ?? n.role)} · ${TYPE_LABEL[n.type] ?? n.type}</div>
      <h2>${escHtml(n.label)}</h2>
      ${desc}
      <div class="lp-id">${escHtml(n.id)}</div>
      ${n.collapsed ? `<div class="lp-stub">⊕ ${n.collapsed} more upstream collapsed at this boundary</div>` : ''}
      ${cols ? `<h3>Columns</h3><ul class="lp-cols">${cols}</ul>` : ''}
      ${n.sql ? `<h3>Transform SQL</h3><pre class="lp-pre">${escHtml(n.sql)}</pre>` : ''}
      ${n.evidence ? `<h3>Provenance</h3><div class="lp-ev">${escHtml(n.evidence)}</div>` : ''}
      <h3>Stats</h3><div class="lp-lazy">⤓ lazy — click to fetch row count / freshness (<code>--stats</code>)</div>
    `
  }

  function edgePanelHtml(e: RawEdge): string {
    const src = nodeById.get(e.from)
    const tgt = nodeById.get(e.to)
    const srcLabel = src ? escHtml(src.label) : escHtml(e.from)
    const tgtLabel = tgt ? escHtml(tgt.label) : escHtml(e.to)
    const badge = e.confidence === 'proven'
      ? `<span class="lp-badge proven">solid · proven</span>`
      : `<span class="lp-badge inferred">dashed · inferred</span>`
    return `
      <div class="lp-kind">EDGE${e.kind === 'back' ? ' · ↺ back-edge (cycle)' : ''}</div>
      <h2>${srcLabel} → ${tgtLabel}</h2>
      <div class="lp-id">${escHtml(e.from)} → ${escHtml(e.to)}</div>
      <h3>Trust</h3><div>${badge}</div>
      ${e.evidence ? `<h3>Evidence</h3><div class="lp-ev">${escHtml(e.evidence)}</div>` : ''}
    `
  }

  cy.on('tap', 'node', (evt) => {
    const id = evt.target.id()
    const n = nodeById.get(id)
    if (!n) return
    highlightNode(evt.target)
    openPanel(nodePanelHtml(n))
  })

  cy.on('tap', 'edge', (evt) => {
    const d = evt.target.data()
    const e = edgeById.get(d.id)
    if (!e) return
    highlightEdge(evt.target)
    openPanel(edgePanelHtml(e))
  })

  cy.on('tap', (evt) => {
    if (evt.target === cy) {
      clearHighlight()
      closePanel()
    }
  })

  document.getElementById('lineage-close-panel')?.addEventListener('click', () => {
    clearHighlight()
    closePanel()
  })

  document.getElementById('lineage-fit')?.addEventListener('click', () => {
    cy.fit(undefined, 40)
  })
  })()
</script>
