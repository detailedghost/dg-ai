---
import Icon from '../components/Icon.astro'
import type { Track } from '../types.ts'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props

const tracks: Track[] = payload.tracks ?? []

const statusPill: Record<string, string> = {
  pending: 'bg-panel-2 text-mid',
  in_progress: 'bg-progress-soft text-progress',
  done: 'bg-accent-soft text-accent',
  partial: 'bg-signal-soft text-signal',
  blocked: 'bg-risk-soft text-risk',
  skipped: 'bg-panel-2 text-mid',
}

const statusDot: Record<string, string> = {
  pending: 'bg-mid',
  in_progress: 'bg-progress animate-pulse',
  done: 'bg-accent',
  partial: 'bg-signal',
  blocked: 'bg-risk',
  skipped: 'bg-rule',
}
---

<section id='tracks'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='queue-list' class='h-5 w-5 text-accent' />
    Parallel Agents
  </h2>

  {tracks.length === 0 ? (
    <p class='text-sm text-mid italic'>No tracks yet — no parallel agents are running.</p>
  ) : (
    <div class='flex flex-col gap-3'>
      {tracks.map((t: Track) => (
        <div data-track-id={t.id} class={`flex items-start gap-3 rounded border p-3 ${t.status === 'blocked' ? 'border-l-[3px] border-risk bg-risk-soft' : 'border-rule bg-panel'}`}>
          <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${statusDot[t.status] ?? 'bg-mid'}`} />
          <div class='min-w-0 flex-1'>
            <div class='flex flex-wrap items-center gap-2'>
              <span class='font-display text-sm font-medium text-ink'>{t.label ?? t.id}</span>
              {t.agent && t.agent !== t.label && (
                <span class='text-xs text-mid'>{t.agent}</span>
              )}
              <span class={`inline-flex items-center rounded-full px-2 py-0.5 font-mono text-xs font-medium uppercase ${statusPill[t.status] ?? statusPill.pending}`}>
                {t.status}
              </span>
              {t.status === 'blocked' && (
                <a href='#respond' class='inline-flex items-center gap-1 rounded-full bg-risk px-2 py-0.5 text-xs font-medium text-on-fill hover:opacity-90'>
                  Respond to unblock
                </a>
              )}
            </div>
            {t.detail && (
              <p class='mt-1 text-xs text-mid'>{t.detail}</p>
            )}
            {t.progress !== undefined && (
              <div class='mt-2 flex items-center gap-2'>
                <div class='h-1 flex-1 overflow-hidden rounded-full bg-panel-2'>
                  <div class='h-full rounded-full bg-progress transition-all' style={`width:${t.progress}%`} />
                </div>
                <span class='w-8 shrink-0 text-right font-mono text-xs tabular-nums text-mid'>{t.progress}%</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</section>
