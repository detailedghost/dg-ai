---
import DoneOverlay from "../components/DoneOverlay.astro";
import Icon from "../components/Icon.astro";
import type { PrDecision, PrDecisionRequest } from "../types.ts";

interface Props {
	payload: Record<string, unknown>;
	mode: string;
}
const { payload } = Astro.props;

const request = (payload.pr_decision_request ?? {}) as PrDecisionRequest;
const title = request.title ?? "Untitled PR";
const body = request.body ?? "";
const summary = request.summary ?? "";
const prUrl = request.prUrl ?? "";
const decisions = request.decisions ?? [];
const commits = request.commits ?? [];
const commitUrl = (sha: string) => (prUrl ? `${prUrl}/commits/${sha}` : "");
const sourceLabel: Record<string, string> = { spec: "Spec", review: "Review", commit: "Commit" };
const sourceBadge: Record<string, string> = {
	spec: "bg-progress-soft text-progress",
	review: "bg-signal-soft text-signal",
	commit: "bg-panel-2 text-mid",
};

// SSR persisted state: once merged, payload.pr_decision holds the decision object.
// Render the decided state so a reload/region-swap of a settled board never shows live buttons again.
const decision = payload.pr_decision as PrDecision | undefined;
const decided = !!decision;

const actionLabel: Record<PrDecision["action"], string> = {
	open: "Open PR (ready)",
	draft: "Open as Draft",
	regenerate: "Regenerate PR message",
};

// Same reload-survival concern as the decided banner above, extended to the overlay:
// render it already-visible when decided, so a reload lands on the terminal state too.
const overlayMessage: Record<PrDecision["action"], string> = {
	open: "Opening PR…",
	draft: "Opening draft PR…",
	regenerate: "Regenerating options…",
};

// regenerate is a kick-back to rework, not a launch — it gets the spinner overlay, not the
// terminal done overlay. open/draft are genuine launches → green ('approve') tone + confetti.
const isRework = decided && decision!.action === "regenerate";
const doneVisible = decided && !isRework;
const doneTone: "approve" | "neutral" =
	decision?.action === "open" || decision?.action === "draft" ? "approve" : "neutral";
---

<section id='pr-decision'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='code-bracket' class='h-5 w-5 text-accent' />
    Launch PR
  </h2>

  <div class='rounded border border-rule bg-panel p-5'>
    {summary && (
      <div class='mb-5'>
        <p class='mb-1 font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>Summary</p>
        <div class='whitespace-pre-wrap rounded border border-rule-soft bg-panel-2 px-4 py-3 text-sm text-ink-2'>{summary}</div>
      </div>
    )}

    {decisions.length > 0 && (
      <div class='mb-5'>
        <p class='mb-2 font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>Decisions</p>
        <ul class='space-y-2'>
          {decisions.map((d) => (
            <li class='rounded border border-rule-soft bg-panel-2 px-4 py-3 text-sm'>
              <div class='flex items-start gap-2'>
                <span class={`shrink-0 rounded-full px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide ${sourceBadge[d.source] ?? sourceBadge.commit}`}>
                  {sourceLabel[d.source] ?? d.source}
                </span>
                <div class='min-w-0 flex-1'>
                  <p class='font-medium text-ink'>{d.title}</p>
                  {d.detail && <p class='mt-0.5 text-ink-2'>{d.detail}</p>}
                  {prUrl && d.ref && (
                    <a href={commitUrl(d.ref)} target='_blank' rel='noopener' class='mt-1 inline-flex items-center gap-1 font-mono text-xs font-medium text-accent hover:underline'>
                      {d.ref.slice(0, 8)} →
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
        {prUrl && (
          <a href={prUrl} target='_blank' rel='noopener' class='mt-2 inline-flex items-center gap-1 text-xs font-medium text-accent hover:underline'>
            <Icon name='code-bracket' class='h-3.5 w-3.5' />
            View the open PR →
          </a>
        )}
      </div>
    )}

    {commits.length > 0 && (
      <div class='mb-5'>
        <p class='mb-2 font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>Commits</p>
        <ul class='divide-y divide-rule-soft overflow-hidden rounded border border-rule'>
          {commits.map((c) => (
            <li class='flex items-baseline gap-3 bg-panel-2 px-4 py-2 text-sm'>
              {prUrl ? (
                <a href={commitUrl(c.sha)} target='_blank' rel='noopener' class='shrink-0 font-mono text-xs text-accent hover:underline'>{c.sha.slice(0, 8)}</a>
              ) : (
                <span class='shrink-0 font-mono text-xs text-mid'>{c.sha.slice(0, 8)}</span>
              )}
              <span class='min-w-0 flex-1 truncate text-ink-2'>{c.subject}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {(request.reviewVerdict || request.reviewSummary || request.reviewSlug) && (
      <div class='mb-5 rounded border border-rule-soft bg-panel-2 px-4 py-3 text-sm'>
        <p class='mb-1 flex items-center gap-1.5 font-medium text-ink-2'>
          <Icon name='check-circle' class='h-4 w-4 text-accent' />
          Approved review{request.reviewVerdict ? ` — ${request.reviewVerdict}` : ''}
        </p>
        {request.reviewSummary && <p class='text-ink-2'>{request.reviewSummary}</p>}
        {request.reviewSlug && (
          <a
            href={`/viz/${request.reviewSlug}`}
            target='_blank'
            rel='noopener'
            class='mt-1.5 inline-flex items-center gap-1 text-xs font-medium text-accent hover:underline'
          >
            <Icon name='code-bracket' class='h-3.5 w-3.5' />
            View the code review →
          </a>
        )}
      </div>
    )}

    {decided && (
      <div class='mb-4 rounded border-l-[3px] border-accent bg-accent-soft px-4 py-3'>
        <p class='text-sm font-medium text-accent'>
          Decision submitted: {actionLabel[decision!.action] ?? decision!.action}
        </p>
        {decision!.guidance && (
          <p class='mt-1 text-xs text-accent/80'>Guidance: {decision!.guidance}</p>
        )}
      </div>
    )}

    {!decided && (
      <div>
        <p class='mb-1 font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>Proposed title</p>
        <p class='mb-4 rounded bg-panel-2 px-3 py-2 text-sm font-medium text-ink'>
          {title}
        </p>

        <label for='pr-decision-body' class='mb-1 block font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>
          Proposed body (editable)
        </label>
        <textarea
          id='pr-decision-body'
          rows='10'
          class='mb-4 w-full rounded border border-rule bg-panel px-3 py-2 font-mono text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent'
        >{body}</textarea>

        <div id='pr-decision-error' class='hidden mb-4 rounded border-l-[3px] border-risk bg-risk-soft px-4 py-3 text-sm text-risk'></div>

        <div id='pr-decision-buttons' class='flex flex-wrap items-center gap-3'>
          <button
            type='button'
            data-pr-action='open'
            class='inline-flex items-center gap-1.5 rounded bg-accent px-4 py-2 text-sm font-medium text-on-fill hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 ring-offset-panel'
          >
            <Icon name='check-circle' class='h-4 w-4' />
            Open PR
          </button>
          <button
            type='button'
            data-pr-action='draft'
            class='inline-flex items-center gap-1.5 rounded border border-rule bg-panel px-4 py-2 text-sm font-medium text-ink-2 hover:bg-panel-2 focus:outline-none focus:ring-2 focus:ring-mid focus:ring-offset-2 ring-offset-panel'
          >
            Open as Draft
          </button>
          <div class='flex flex-1 items-center gap-2'>
            <input
              type='text'
              id='pr-decision-guidance'
              placeholder='Guidance for a new message (optional)'
              class='min-w-[12rem] flex-1 rounded border border-rule bg-panel px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent'
            />
            <button
              type='button'
              data-pr-action='regenerate'
              class='inline-flex shrink-0 items-center gap-1.5 rounded border border-rule bg-panel px-4 py-2 text-sm font-medium text-ink-2 hover:bg-panel-2 focus:outline-none focus:ring-2 focus:ring-mid focus:ring-offset-2 ring-offset-panel'
            >
              <Icon name='arrow-path' class='h-4 w-4' />
              Request new message
            </button>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<!-- Open/Draft launch → confirm overlay with the green ('approve') glow ✓, dismissable so you
     can head back to the debrief. Mirrors the /prototype picker's confirm overlay. -->
<DoneOverlay
  id='prd-overlay'
  visible={doneVisible}
  tone={doneTone}
  message={doneVisible ? overlayMessage[decision!.action] : null}
  link={prUrl || undefined}
  linkLabel='View PR →'
  dismissLabel='← Back to debrief'
/>

<!-- Regenerate → rework kick-back. Mirrors the /prototype picker's inline "Reworking options…"
     banner: non-blocking, keeps the tab alive while the agent revises + re-renders the board. -->
<div class={`prd-rework-banner${isRework ? ' visible' : ''}`} id='prd-rework-banner' role='status'>
  <span class='prd-rework-title'>⟲ Reworking the PR message…</span>
  <span>Keep this tab open — it refreshes when the new draft is ready.</span>
  <button type='button' class='prd-rework-dismiss' id='prd-rework-dismiss'>Dismiss</button>
</div>

<script>
  // Delegate on document, not the buttons: refreshRegions() swaps viz-main's innerHTML on every
  // payload rev, orphaning any per-node listeners. document is never replaced. slug/nonce re-read
  // per click since the [data-viz-*] carriers also live inside the swapped region.
  import { showDoneOverlay } from '../lib/doneOverlay.ts'
  import { burstConfetti } from '../lib/confetti.ts'
  import { setFaviconHref } from '../lib/favicon.ts'
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'

  const RECEIVED_HOLD_MS = 1200 // visible "Received ✓" dwell before settling

  // Processing favicon for the rework kick-back (🔄), matching the /prototype picker's states.
  const REWORK_FAVICON =
    'data:image/svg+xml,' +
    encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">' +
        '<text x="50" y="54" font-size="80" text-anchor="middle" dominant-baseline="central">🔄</text></svg>',
    )

  function hold(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms))
  }

  type PrAction = 'open' | 'draft' | 'regenerate'

  async function submitPrDecision(action: PrAction) {
    const { slug, nonce } = readVizMeta()
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pr-action]')
    const clickedBtn = document.querySelector<HTMLButtonElement>(`[data-pr-action="${action}"]`)
    const errorEl = document.getElementById('pr-decision-error')
    const bodyEl = document.getElementById('pr-decision-body') as HTMLTextAreaElement | null
    const guidanceEl = document.getElementById('pr-decision-guidance') as HTMLInputElement | null
    const setDisabled = (state: boolean) => { for (const b of buttons) b.disabled = state }

    // Phase 1 — Received: disable immediately, mark clicked button
    setDisabled(true)
    const originalLabel = clickedBtn?.innerHTML ?? ''
    if (clickedBtn) {
      clickedBtn.innerHTML = '✓ Received'
      clickedBtn.style.opacity = '1'
      clickedBtn.style.background = '#1f6f6b'
      clickedBtn.style.color = '#fff'
      clickedBtn.style.borderColor = '#1f6f6b'
    }

    try {
      const decision: { action: PrAction; body: string; guidance?: string } = {
        action,
        body: bodyEl?.value ?? '',
      }
      const guidance = guidanceEl?.value?.trim()
      if (action === 'regenerate') decision.guidance = guidance || 'Generate a new PR message.'

      const answers = [{ type: 'pr_decision', index: 0, answer: JSON.stringify(decision) }]
      const hmac = await signAnswers(slug, answers)
      // Phase 2 — Hold: POST and minimum dwell run concurrently; we wait for both
      const [res] = await Promise.all([respond(slug, nonce, hmac, answers), hold(RECEIVED_HOLD_MS)])

      // Phase 3 — server merged; show full-screen overlay (matches PrototypeSwitcher #ps-overlay).
      // The overlay is the terminal UX state — vizRefresh settles the board underneath in background.
      if (res.ok) {
        if (action === 'regenerate') {
          // Rework kick-back — non-blocking banner, tab stays live for the revised draft
          // (mirrors the /prototype picker's reject → "Reworking options…" flow).
          document.getElementById('prd-rework-banner')?.classList.add('visible')
          setFaviconHref(REWORK_FAVICON)
        } else {
          // Open/Draft launch — green confirm overlay + a celebratory confetti burst.
          const actionMsg: Record<string, string> = { open: 'Opening PR…', draft: 'Opening draft PR…' }
          showDoneOverlay('prd-overlay', actionMsg[action] ?? 'Decision submitted', 'approve')
          burstConfetti()
        }
        const vizRefresh = (window as unknown as { vizRefresh?: (ids?: string[]) => Promise<void> }).vizRefresh
        vizRefresh?.().catch(() => {})
      } else {
        if (clickedBtn) clickedBtn.innerHTML = originalLabel
        if (clickedBtn) {
          clickedBtn.style.background = ''
          clickedBtn.style.color = ''
          clickedBtn.style.borderColor = ''
        }
        const msg = await res.text()
        if (errorEl) {
          errorEl.textContent = `Error ${res.status}: ${msg}`
          errorEl.classList.remove('hidden')
        }
        setDisabled(false)
      }
    } catch (err) {
      if (clickedBtn) clickedBtn.innerHTML = originalLabel
      if (clickedBtn) {
        clickedBtn.style.background = ''
        clickedBtn.style.color = ''
        clickedBtn.style.borderColor = ''
      }
      if (errorEl) {
        errorEl.textContent = String(err)
        errorEl.classList.remove('hidden')
      }
      setDisabled(false)
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pr-action]')
    if (!btn) return
    submitPrDecision(btn.dataset.prAction as PrAction)
  })

  // Dismiss the rework banner (delegated — the region swap orphans per-node listeners).
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#prd-rework-dismiss')) return
    document.getElementById('prd-rework-banner')?.classList.remove('visible')
  })
</script>

<style>
  /* Rework kick-back banner — amber, non-blocking, matches the /prototype picker's
     "Reworking options…" banner (#ps-rework-banner). */
  .prd-rework-banner {
    display: none;
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: 480px;
    max-width: 92vw;
    background: #3a2a0a;
    color: #fde68a;
    border: 1px solid #b45309;
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    font-family: system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.5;
  }
  .prd-rework-banner.visible { display: block; }
  .prd-rework-title { font-weight: 600; margin-right: 4px; }
  .prd-rework-dismiss {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fde68a;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    cursor: pointer;
    margin-left: 10px;
  }
  .prd-rework-dismiss:hover { background: rgba(255, 255, 255, 0.08); }
</style>
