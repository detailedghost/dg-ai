---
import Icon from "../components/Icon.astro"
import type { ErdPayload, EvidenceRecord } from "../types"

interface Props {
  payload: ErdPayload
}
const { payload } = Astro.props
const evidence = payload.evidence ?? []

const groups = new Map<string, EvidenceRecord[]>()
for (const e of evidence) {
  if (!groups.has(e.type)) groups.set(e.type, [])
  groups.get(e.type)!.push(e)
}

const LABEL_BY_TYPE: Record<string, string> = {
  "db-table": "DB Tables",
  "db-column": "DB Columns",
  "file": "Files",
  "import": "Imports",
}
---

<section id="evidence-proto">
  <h2 class="mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink">
    <Icon name="magnifying-glass" class="h-5 w-5 text-accent" />
    Evidence <span class="evidence-proto-count">({evidence.length})</span>
  </h2>

  <div class="evidence-proto-groups">
    {Array.from(groups.entries()).map(([type, rows]) => (
      <div class="evidence-proto-group">
        <h3 class="evidence-proto-group-title">
          {LABEL_BY_TYPE[type] ?? type} <span class="evidence-proto-group-count">{rows.length}</span>
        </h3>
        <table class="evidence-proto-table">
          <tbody>
            {rows.map((e) => (
              <tr>
                <td class="evidence-proto-td-ref"><code>{e.ref}</code></td>
                <td class="evidence-proto-td-detail">{e.detail ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </div>
</section>

<style>
  .evidence-proto-count {
    font-weight: 400;
    color: var(--color-mid);
    font-size: 0.875rem;
  }
  .evidence-proto-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .evidence-proto-group-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-mid);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .evidence-proto-group-count {
    font-size: 0.625rem;
    background: var(--color-panel-2);
    color: var(--color-mid);
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
  }
  .evidence-proto-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .evidence-proto-table tr {
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .evidence-proto-table tr:last-child { border-bottom: none; }
  .evidence-proto-table td {
    padding: 0.45rem 0.75rem;
    vertical-align: top;
  }
  .evidence-proto-td-ref {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .evidence-proto-td-detail {
    color: var(--color-mid);
  }
</style>
