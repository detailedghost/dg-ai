---
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props

const items: any[] = (payload.references ?? payload.links ?? []).filter((item: any) => item.kind === 'pr')
const isChain = items.length > 1
---

<section id='pull-requests'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='code-bracket' class='h-5 w-5 text-progress' /> Pull Requests
    {isChain && (
      <span class='ml-1 rounded-full bg-progress-soft px-2 py-0.5 font-mono text-xs font-medium text-progress'>
        merge order ↓
      </span>
    )}
  </h2>

  <ol>
    {items.map((item: any, i: number) => (
      <li class='flex gap-3'>
        {/* left rail: dot + connector share one centered column, so the line always runs through the dot's center */}
        <div class='flex w-6 shrink-0 flex-col items-center'>
          <span class='mt-1 flex h-6 w-6 items-center justify-center rounded-full bg-progress font-mono text-xs font-bold text-on-fill shadow-sm'>
            {i + 1}
          </span>
          {i < items.length - 1 && (
            <span class='w-0.5 flex-1 bg-rule' aria-hidden='true'></span>
          )}
        </div>

        <div class='min-w-0 flex-1 pb-3 last:pb-0'>
          {item.url
            ? (
              <a
                href={item.url}
                target='_blank'
                rel='noopener'
                class='group flex items-start gap-2.5 rounded border border-rule bg-panel px-3 py-2.5 transition-colors hover:border-progress hover:bg-progress-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-progress'
              >
                <span class='min-w-0 flex-1 text-sm font-medium text-progress group-hover:underline'>
                  {item.label || item.url}
                </span>
                {item.status && (
                  <span class='ml-auto shrink-0 rounded-full bg-panel-2 px-2 py-0.5 text-xs text-mid'>{item.status}</span>
                )}
              </a>
            )
            : (
              <div class='flex items-start gap-2.5 rounded border border-rule bg-panel px-3 py-2.5'>
                <span class='min-w-0 flex-1 text-sm font-medium text-ink-2'>
                  {item.label || item.url}
                </span>
                {item.status && (
                  <span class='ml-auto shrink-0 rounded-full bg-panel-2 px-2 py-0.5 text-xs text-mid'>{item.status}</span>
                )}
              </div>
            )
          }
        </div>
      </li>
    ))}
  </ol>
</section>
