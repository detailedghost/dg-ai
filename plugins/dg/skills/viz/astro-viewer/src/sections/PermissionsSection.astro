---
import Icon from '../components/Icon.astro'
import type { Permission } from '../types.ts'

interface Props {
  payload: Record<string, unknown>
  mode: string
}
const { payload } = Astro.props

const permissions: Permission[] = (payload.permissions as Permission[]) ?? []
const grantedCount = permissions.filter((p) => p.granted).length
const allGranted = permissions.length > 0 && grantedCount === permissions.length
---

<section id='permissions'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='shield-check' class='h-5 w-5 text-accent' />
    Permissions
  </h2>
  <p class='mb-3 text-xs text-mid'>
    Turn on what you want to allow, then submit once. Anything left off stays denied.
  </p>

  <div id='perm-form' class='rounded border border-rule bg-panel'>
    <div class='flex items-center gap-3 border-b border-rule bg-panel-2 px-4 py-2.5'>
      <span class='min-w-0 flex-1'>
        <span class='block font-mono text-[0.66rem] font-bold uppercase tracking-[0.11em] text-mid'>Toggle all</span>
        <span class='block text-xs text-mid'>
          <span data-perm-count>{grantedCount}</span> of {permissions.length} granted
        </span>
      </span>
      <button
        type='button'
        role='switch'
        aria-checked={allGranted ? 'true' : 'false'}
        aria-label='Toggle all permissions'
        data-perm-switch
        data-perm-toggle-all
        class={`relative h-5 w-9 shrink-0 rounded-full transition-colors ${allGranted ? 'bg-accent' : 'bg-rule'}`}
      >
        <span class={`absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all ${allGranted ? 'left-[18px]' : 'left-0.5'}`} />
      </button>
    </div>

    {permissions.map((perm: Permission) => (
      <div class='flex items-start gap-3 border-b border-rule-soft px-4 py-3 last:border-b-0'>
        <span class='min-w-0 flex-1'>
          <span class='block text-sm font-medium text-ink'>{perm.label}</span>
          <span class='block text-xs text-mid'>{perm.description}</span>
        </span>
        <button
          type='button'
          role='switch'
          aria-checked={perm.granted ? 'true' : 'false'}
          aria-label={perm.label}
          data-perm-switch
          data-perm-key={perm.key}
          class={`relative mt-0.5 h-5 w-9 shrink-0 rounded-full transition-colors ${perm.granted ? 'bg-accent' : 'bg-rule'}`}
        >
          <span class={`absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-all ${perm.granted ? 'left-[18px]' : 'left-0.5'}`} />
        </button>
      </div>
    ))}

    <div class='flex flex-wrap items-center gap-3 border-t border-rule px-4 py-3'>
      <button
        type='button'
        data-perm-submit
        class='rounded bg-accent px-4 py-2 text-sm font-medium text-on-fill hover:bg-accent/90 disabled:opacity-50'
      >
        Update permissions
      </button>
      <span data-perm-status class='hidden text-sm text-mid' aria-live='polite'></span>
    </div>
  </div>
</section>

<script>
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'

  // Delegate on document: refreshRegions() swaps viz-main's innerHTML on every payload rev, so any
  // listener bound to a specific control dies on the first refresh. document is never swapped.
  function paintSwitch(btn: HTMLElement, on: boolean) {
    btn.setAttribute('aria-checked', String(on))
    btn.classList.toggle('bg-accent', on)
    btn.classList.toggle('bg-rule', !on)
    const knob = btn.querySelector<HTMLElement>('span')
    knob?.classList.toggle('left-[18px]', on)
    knob?.classList.toggle('left-0.5', !on)
  }

  function rowSwitches(form: HTMLElement): HTMLElement[] {
    return [...form.querySelectorAll<HTMLElement>('[data-perm-switch][data-perm-key]')]
  }

  function syncForm(form: HTMLElement) {
    const rows = rowSwitches(form)
    const on = rows.filter((r) => r.getAttribute('aria-checked') === 'true').length
    const master = form.querySelector<HTMLElement>('[data-perm-toggle-all]')
    if (master) paintSwitch(master, rows.length > 0 && on === rows.length)
    const count = form.querySelector<HTMLElement>('[data-perm-count]')
    if (count) count.textContent = String(on)
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-perm-switch]')
    if (!btn) return
    const form = btn.closest<HTMLElement>('#perm-form')
    if (!form) return

    const on = btn.getAttribute('aria-checked') !== 'true'
    paintSwitch(btn, on)
    if (btn.hasAttribute('data-perm-toggle-all')) {
      rowSwitches(form).forEach((row) => paintSwitch(row, on))
    }
    syncForm(form)
  })

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-perm-submit]')
    if (!btn) return
    const form = btn.closest<HTMLElement>('#perm-form')
    if (!form) return

    const status = form.querySelector<HTMLElement>('[data-perm-status]')
    const selected = rowSwitches(form)
      .filter((row) => row.getAttribute('aria-checked') === 'true')
      .map((row) => row.dataset.permKey ?? '')
      .filter(Boolean)

    const { slug, nonce } = readVizMeta()
    btn.disabled = true
    if (status) {
      status.textContent = 'Saving...'
      status.classList.remove('hidden')
    }

    try {
      const answers = [{ type: 'permission_set', index: 0, answer: JSON.stringify(selected) }]
      const hmac = await signAnswers(slug, answers)
      const res = await respond(slug, nonce, hmac, answers)
      if (!res.ok) throw new Error(`${res.status}: ${await res.text()}`)
      await (window as unknown as { vizRefresh?: (ids?: string[]) => Promise<void> }).vizRefresh?.()
    } catch (err) {
      if (status) status.textContent = `Error saving: ${err}`
      btn.disabled = false
    }
  })
</script>
