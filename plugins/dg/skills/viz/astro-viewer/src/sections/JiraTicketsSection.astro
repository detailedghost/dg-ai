---
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props

const items: any[] = (payload.references ?? payload.links ?? []).filter((item: any) => item.kind === 'jira')
---

<section id='jira-tickets'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='server' class='h-5 w-5 text-accent' /> Jira Tickets
  </h2>
  <ul class='space-y-2'>
    {items.map((item: any) => (
      <li>
        {item.url
          ? (
            <a
              href={item.url}
              target='_blank'
              rel='noopener'
              class='group flex items-center gap-2.5 rounded border border-rule bg-panel px-3 py-2.5 transition-colors hover:border-accent hover:bg-accent-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent'
            >
              <span class='min-w-0 flex-1 truncate text-sm font-medium text-accent group-hover:underline'>
                {item.label || item.url}
              </span>
              {item.status && (
                <span class='ml-auto shrink-0 text-xs text-mid'>{item.status}</span>
              )}
            </a>
          )
          : (
            <div class='flex items-center gap-2.5 rounded border border-rule bg-panel px-3 py-2.5'>
              <span class='min-w-0 flex-1 truncate text-sm font-medium text-ink-2'>
                {item.label || item.url}
              </span>
              {item.status && (
                <span class='ml-auto shrink-0 text-xs text-mid'>{item.status}</span>
              )}
            </div>
          )
        }
      </li>
    ))}
  </ul>
</section>
