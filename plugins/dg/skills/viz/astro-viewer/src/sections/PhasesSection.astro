---
import Icon from '../components/Icon.astro'
import PhaseTimeline from '../components/PhaseTimeline.astro'

interface Props {
  payload: any
  mode: string
  inPlanning: boolean
}
const { payload, inPlanning } = Astro.props
---

<section id='phases'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='queue-list' class='h-5 w-5 text-accent' />
    {inPlanning ? 'Phases' : 'Implementation Timeline'}
    {!inPlanning && (
      <span class='ml-1 inline-flex items-center gap-1 font-mono text-xs font-normal text-progress'>
        <span class='h-1.5 w-1.5 animate-pulse rounded-full bg-progress' /> live
      </span>
    )}
  </h2>
  <PhaseTimeline phases={payload.phases} />
</section>
