---
// PROTOTYPE — throwaway, see .agents/prototype/erd-viz-sections/NOTES.md
// Variant C: collapsible accordion, one section per evidence type.
import Icon from "../../components/Icon.astro"

interface EvidenceRecord {
  type: string
  ref: string
  detail?: string
}
interface Props {
  evidence: EvidenceRecord[]
}
const { evidence } = Astro.props

const groups = new Map<string, EvidenceRecord[]>()
for (const e of evidence) {
  if (!groups.has(e.type)) groups.set(e.type, [])
  groups.get(e.type)!.push(e)
}
const LABEL_BY_TYPE: Record<string, string> = {
  "db-table": "DB Tables",
  "db-column": "DB Columns",
  "file": "Files",
}
---

<section id="evidence-proto">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-gray-800 dark:text-gray-200">
    <Icon name="magnifying-glass" class="h-5 w-5 text-indigo-500" />
    Evidence <span class="evidence-proto-count">({evidence.length})</span>
  </h2>

  <div class="evidence-proto-accordion">
    {Array.from(groups.entries()).map(([type, rows], i) => (
      <details class="evidence-proto-item" open={i === 0}>
        <summary class="evidence-proto-summary">
          <span class="evidence-proto-chevron">▸</span>
          {LABEL_BY_TYPE[type] ?? type}
          <span class="evidence-proto-badge">{rows.length}</span>
        </summary>
        <ul class="evidence-proto-sublist">
          {rows.map((e) => (
            <li>
              <code>{e.ref}</code>
              {e.detail && <span class="evidence-proto-sub-detail">— {e.detail}</span>}
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</section>

<style>
  .evidence-proto-count {
    font-weight: 400;
    color: #9ca3af;
    font-size: 0.875rem;
  }
  .evidence-proto-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .evidence-proto-item {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
  }
  :global(.dark) .evidence-proto-item {
    border-color: #1f2937;
  }
  .evidence-proto-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #374151;
    background: #f9fafb;
    user-select: none;
  }
  :global(.dark) .evidence-proto-summary {
    color: #d1d5db;
    background: #111827;
  }
  .evidence-proto-summary::-webkit-details-marker { display: none; }
  .evidence-proto-chevron {
    display: inline-block;
    transition: transform 0.15s ease;
    color: #9ca3af;
  }
  details[open] .evidence-proto-chevron {
    transform: rotate(90deg);
  }
  .evidence-proto-badge {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 400;
    background: #e5e7eb;
    color: #6b7280;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
  }
  :global(.dark) .evidence-proto-badge {
    background: #1f2937;
    color: #9ca3af;
  }
  .evidence-proto-sublist {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0.9rem 0.7rem;
    font-size: 0.8125rem;
  }
  .evidence-proto-sublist li {
    padding: 0.25rem 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    color: #374151;
  }
  :global(.dark) .evidence-proto-sublist li {
    color: #d1d5db;
  }
  .evidence-proto-sub-detail {
    font-family: system-ui, sans-serif;
    color: #9ca3af;
    margin-left: 0.3rem;
  }
</style>
