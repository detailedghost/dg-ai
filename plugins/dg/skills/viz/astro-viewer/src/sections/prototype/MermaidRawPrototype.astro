---
// PROTOTYPE — throwaway, see .agents/prototype/erd-diagram-shapes-flowchart/NOTES.md
// Renders a raw Mermaid diagram source as-is (dark theme) — box shapes and
// connector styles are baked into the diagram source itself per variant.
interface Props {
  diagram: string
}
const { diagram } = Astro.props
const srcJson = JSON.stringify(diagram)
---

<div class="raw-proto-wrap">
  <script is:inline type="application/json" class="raw-proto-src" set:html={srcJson}></script>
  <div class="raw-proto-canvas"></div>
</div>

<style>
  .raw-proto-wrap {
    border-radius: 10px;
    overflow: auto;
    background: #ffffff;
    border: 1px solid #e0e7ff;
    padding: 1.25rem;
    min-height: 360px;
  }
  :global(.dark) .raw-proto-wrap {
    background: radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%);
    border-color: #2b3a52;
  }
  .raw-proto-canvas {
    display: flex;
    justify-content: center;
  }
  .raw-proto-canvas :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  import mermaid from "mermaid"

  function isDark() {
    return document.documentElement.classList.contains("dark")
  }

  function initMermaid() {
    const dark = isDark()
    mermaid.initialize({
      startOnLoad: false,
      theme: dark ? "dark" : "base",
      securityLevel: "loose",
      themeVariables: dark
        ? {
            background: "#0a111e",
            primaryColor: "#15263f",
            primaryBorderColor: "#3aa0ff",
            primaryTextColor: "#e6f1ff",
            lineColor: "#4cc9f0",
            secondaryColor: "#0e2138",
            tertiaryColor: "#111c2e",
            // Slimmer, muted edge-label chips — default dark theme renders these
            // bright/boxy, which read as "loud" next to thin connector lines.
            edgeLabelBackground: "#0e1b2e",
            fontSize: "13px",
          }
        : {
            background: "#ffffff",
            primaryColor: "#eef2ff",
            primaryBorderColor: "#6366f1",
            primaryTextColor: "#312e81",
            lineColor: "#6366f1",
            secondaryColor: "#e0e7ff",
            tertiaryColor: "#f5f3ff",
            edgeLabelBackground: "#f5f3ff",
            fontSize: "13px",
          },
    })
  }

  async function renderAll() {
    initMermaid()
    const wraps = document.querySelectorAll<HTMLElement>(".raw-proto-wrap")
    let i = 0
    for (const wrap of wraps) {
      const srcEl = wrap.querySelector<HTMLElement>(".raw-proto-src")
      const canvas = wrap.querySelector<HTMLElement>(".raw-proto-canvas")
      const src = srcEl?.textContent ? JSON.parse(srcEl.textContent) : ""
      if (!canvas || !src) continue
      try {
        const { svg } = await mermaid.render(`raw-proto-svg-${i++}-${dark_suffix()}`, src)
        canvas.innerHTML = svg
      } catch (err) {
        canvas.textContent = "render failed — see console"
        console.error("[mermaid-raw-proto]", err)
      }
    }
  }

  function dark_suffix() {
    return isDark() ? "d" : "l"
  }

  renderAll()

  // Defensive: re-render if the dark/light class toggles without a full page
  // reload (the page-level popstate->reload handler is the primary path via
  // PrototypeSwitcher's mode toggle, but this covers any other toggle source).
  let lastDark = isDark()
  new MutationObserver(() => {
    const nowDark = isDark()
    if (nowDark !== lastDark) {
      lastDark = nowDark
      renderAll()
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })
</script>
