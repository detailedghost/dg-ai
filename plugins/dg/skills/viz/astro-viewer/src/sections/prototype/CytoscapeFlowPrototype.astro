---
// PROTOTYPE — throwaway, see .agents/prototype/erd-renderer-comparison/NOTES.md
// Code/import flowchart via cytoscape + cytoscape-dagre, copying the init
// pattern from ../LineageSection.astro almost verbatim (styling/layout only —
// no click-to-inspect panel, out of scope for this comparison).
interface FlowNode {
  id: string
  label: string
}
interface FlowEdge {
  from: string
  to: string
}
interface Props {
  nodes: FlowNode[]
  edges: FlowEdge[]
}
const { nodes, edges } = Astro.props
const graphData = JSON.stringify({ nodes, edges }).replace(/</g, "\\u003c")
---

<div class="cy-flow-proto-wrap">
  <div class="cy-flow-proto-cy"></div>
</div>
<script is:inline type="application/json" class="cy-flow-proto-data" set:html={graphData}></script>

<style>
  .cy-flow-proto-wrap {
    height: 340px;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%);
    border: 1px solid #2b3a52;
  }
  .cy-flow-proto-cy {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import cytoscape from "cytoscape"
  import cytoscapeDagre from "cytoscape-dagre"

  cytoscape.use(cytoscapeDagre as any)

  interface FlowNode {
    id: string
    label: string
  }
  interface FlowEdge {
    from: string
    to: string
  }

  document.querySelectorAll<HTMLElement>(".cy-flow-proto-wrap").forEach((wrap) => {
    const dataEl = wrap.parentElement?.querySelector<HTMLElement>(".cy-flow-proto-data")
    const canvas = wrap.querySelector<HTMLElement>(".cy-flow-proto-cy")
    if (!dataEl?.textContent || !canvas) return
    const { nodes, edges } = JSON.parse(dataEl.textContent) as { nodes: FlowNode[]; edges: FlowEdge[] }

    const elements = [
      ...nodes.map((n) => ({ data: { id: n.id, label: n.label } })),
      ...edges.map((e, i) => ({ data: { id: `e-${i}`, source: e.from, target: e.to } })),
    ]

    const cy = cytoscape({
      container: canvas,
      elements,
      style: [
        {
          selector: "node",
          style: {
            shape: "rectangle",
            label: "data(label)",
            "font-size": 12,
            "font-family": "ui-monospace, monospace",
            "text-valign": "center",
            "text-halign": "center",
            color: "#e6f1ff",
            width: "label",
            height: "label",
            padding: "14px",
            "border-width": 2,
            "background-color": "#15263f",
            "border-color": "#3aa0ff",
          },
        },
        {
          selector: "edge",
          style: {
            width: 2.5,
            "line-color": "#4cc9f0",
            "target-arrow-color": "#4cc9f0",
            "target-arrow-shape": "triangle",
            "curve-style": "bezier",
            "arrow-scale": 1.1,
          },
        },
      ] as any,
      layout: {
        name: "dagre",
        rankDir: "LR",
        nodeSep: 32,
        rankSep: 90,
      } as any,
      wheelSensitivity: 0.5,
      minZoom: 0.2,
      maxZoom: 3,
    })

    cy.one("layoutstop", () => cy.fit(undefined, 40))
  })
</script>
