---
// PROTOTYPE — throwaway, see .agents/prototype/erd-viz-sections/NOTES.md
// Variant A: flat, chronological-ish list of evidence records.
import Icon from "../../components/Icon.astro"

interface EvidenceRecord {
  type: string
  ref: string
  detail?: string
}
interface Props {
  evidence: EvidenceRecord[]
}
const { evidence } = Astro.props

const ICON_BY_TYPE: Record<string, string> = {
  "db-table": "server",
  "db-column": "server",
  "file": "code-bracket",
}
---

<section id="evidence-proto">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-gray-800 dark:text-gray-200">
    <Icon name="magnifying-glass" class="h-5 w-5 text-indigo-500" />
    Evidence <span class="evidence-proto-count">({evidence.length})</span>
  </h2>

  <ul class="evidence-proto-list">
    {evidence.map((e) => (
      <li class="evidence-proto-row">
        <span class={`evidence-proto-type evidence-proto-type--${e.type}`}>{e.type}</span>
        <code class="evidence-proto-ref">{e.ref}</code>
        {e.detail && <span class="evidence-proto-detail">{e.detail}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .evidence-proto-count {
    font-weight: 400;
    color: #9ca3af;
    font-size: 0.875rem;
  }
  .evidence-proto-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
  }
  :global(.dark) .evidence-proto-list {
    border-color: #1f2937;
  }
  .evidence-proto-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid #f3f4f6;
    font-size: 0.8125rem;
  }
  :global(.dark) .evidence-proto-row {
    border-bottom-color: #111827;
  }
  .evidence-proto-row:last-child { border-bottom: none; }

  .evidence-proto-type {
    flex: 0 0 auto;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: #f3f4f6;
    color: #6b7280;
  }
  :global(.dark) .evidence-proto-type {
    background: #1f2937;
    color: #9ca3af;
  }
  .evidence-proto-type--db-table,
  .evidence-proto-type--db-column {
    background: #ecfdf5;
    color: #059669;
  }
  :global(.dark) .evidence-proto-type--db-table,
  :global(.dark) .evidence-proto-type--db-column {
    background: #052e21;
    color: #34d399;
  }
  .evidence-proto-type--file {
    background: #eef2ff;
    color: #4f46e5;
  }
  :global(.dark) .evidence-proto-type--file {
    background: #1e1b4b;
    color: #818cf8;
  }

  .evidence-proto-ref {
    flex: 0 0 auto;
    font-family: var(--font-mono, ui-monospace, monospace);
    color: #374151;
  }
  :global(.dark) .evidence-proto-ref {
    color: #d1d5db;
  }
  .evidence-proto-detail {
    color: #9ca3af;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
