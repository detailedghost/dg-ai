---
// PROTOTYPE — throwaway, see .agents/prototype/erd-diagram-themes/NOTES.md
// Answers: what color theme should the /erd Mermaid diagram section use?
interface Props {
  diagram: string
  mermaidTheme: string
  themeVariables?: Record<string, string>
  containerBg: string
  containerBorder: string
}
const { diagram, mermaidTheme, themeVariables = {}, containerBg, containerBorder } = Astro.props

const srcJson = JSON.stringify(diagram)
const themeVarsJson = JSON.stringify(themeVariables)
---

<div
  class="theme-proto-wrap"
  style={`background:${containerBg};border-color:${containerBorder}`}
  data-mermaid-theme={mermaidTheme}
  data-theme-vars={themeVarsJson}
>
  <script is:inline type="application/json" class="theme-proto-src" set:html={srcJson}></script>
  <div class="theme-proto-canvas"></div>
</div>

<style>
  .theme-proto-wrap {
    border-radius: 10px;
    overflow: auto;
    border: 1px solid;
    padding: 1rem;
    min-height: 320px;
  }
  .theme-proto-canvas {
    display: flex;
    justify-content: center;
  }
  .theme-proto-canvas :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  import mermaid from "mermaid"

  // This page renders one wrapper per theme variant (all in the DOM at once
  // for a future side-by-side option), each carrying its own init config —
  // mermaid.initialize() is global, so re-init immediately before each render.
  async function renderAll() {
    const wraps = document.querySelectorAll<HTMLElement>(".theme-proto-wrap")
    let i = 0
    for (const wrap of wraps) {
      const theme = wrap.dataset.mermaidTheme ?? "dark"
      const themeVariables = JSON.parse(wrap.dataset.themeVars ?? "{}")
      const srcEl = wrap.querySelector<HTMLElement>(".theme-proto-src")
      const src = srcEl?.textContent ? JSON.parse(srcEl.textContent) : ""
      const canvas = wrap.querySelector<HTMLElement>(".theme-proto-canvas")
      if (!canvas || !src) continue

      mermaid.initialize({ startOnLoad: false, theme, securityLevel: "loose", themeVariables })
      try {
        const { svg } = await mermaid.render(`theme-proto-svg-${i++}`, src)
        canvas.innerHTML = svg
      } catch (err) {
        canvas.textContent = "render failed — see console"
        console.error("[mermaid-theme-proto]", err)
      }
    }
  }

  renderAll()
</script>
