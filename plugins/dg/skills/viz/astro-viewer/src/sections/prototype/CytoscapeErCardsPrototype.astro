---
// PROTOTYPE — throwaway, see .agents/prototype/erd-renderer-comparison/NOTES.md
// Cytoscape has no native ER/table shape. This is the "half solution" the
// comparison is meant to surface: cytoscape-node-html-label overlays a real
// HTML card (header + PK/FK column rows) on top of an invisible cytoscape
// node, positioned by dagre. Point is to see whether that reads as tolerable,
// not to make it pixel-perfect.
interface Column {
  name: string
  type: string
  pk?: boolean
  fk?: boolean
}
interface Table {
  id: string
  name: string
  columns: Column[]
}
interface Relation {
  from: string
  to: string
}
interface Props {
  tables: Table[]
  relations: Relation[]
}
const { tables, relations } = Astro.props
const graphData = JSON.stringify({ tables, relations }).replace(/</g, "\\u003c")
---

<div class="cy-er-proto-wrap">
  <div class="cy-er-proto-cy"></div>
</div>
<script is:inline type="application/json" class="cy-er-proto-data" set:html={graphData}></script>

<style>
  .cy-er-proto-wrap {
    height: 420px;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%);
    border: 1px solid #2b3a52;
  }
  .cy-er-proto-cy {
    width: 100%;
    height: 100%;
  }
  .cy-er-proto-cy :global(.er-card) {
    width: 190px;
    border-radius: 8px;
    overflow: hidden;
    border: 1.5px solid #3aa0ff;
    background: #0e1b2e;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  .cy-er-proto-cy :global(.er-card-head) {
    background: #15263f;
    color: #e6f1ff;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 6px 10px;
    border-bottom: 1.5px solid #3aa0ff;
  }
  .cy-er-proto-cy :global(.er-card-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    color: #cfe0f5;
    border-top: 1px solid #1c2c44;
  }
  .cy-er-proto-cy :global(.er-card-col) {
    flex: 1;
  }
  .cy-er-proto-cy :global(.er-card-type) {
    opacity: 0.55;
  }
  .cy-er-proto-cy :global(.er-badge) {
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 4px;
  }
  .cy-er-proto-cy :global(.er-badge.pk) {
    background: #3a2d05;
    color: #ffd13a;
  }
  .cy-er-proto-cy :global(.er-badge.fk) {
    background: #0e2138;
    color: #4cc9f0;
  }
</style>

<script>
  import cytoscape from "cytoscape"
  import cytoscapeDagre from "cytoscape-dagre"
  // No shipped types beyond the plugin's own ambient .d.ts (no Core augmentation) — `as any` bridges the gap.
  import nodeHtmlLabel from "cytoscape-node-html-label"

  cytoscape.use(cytoscapeDagre as any)
  ;(nodeHtmlLabel as any)(cytoscape)

  interface Column {
    name: string
    type: string
    pk?: boolean
    fk?: boolean
  }
  interface Table {
    id: string
    name: string
    columns: Column[]
  }
  interface Relation {
    from: string
    to: string
  }

  function escHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
  }

  document.querySelectorAll<HTMLElement>(".cy-er-proto-wrap").forEach((wrap) => {
    const dataEl = wrap.parentElement?.querySelector<HTMLElement>(".cy-er-proto-data")
    const canvas = wrap.querySelector<HTMLElement>(".cy-er-proto-cy")
    if (!dataEl?.textContent || !canvas) return
    const { tables, relations } = JSON.parse(dataEl.textContent) as { tables: Table[]; relations: Relation[] }
    const tableById = new Map(tables.map((t) => [t.id, t]))

    const elements = [
      ...tables.map((t) => ({ data: { id: t.id, rows: t.columns.length } })),
      ...relations.map((r, i) => ({ data: { id: `e-${i}`, source: r.from, target: r.to } })),
    ]

    const cy = cytoscape({
      container: canvas,
      elements,
      style: [
        {
          selector: "node",
          style: {
            shape: "round-rectangle",
            "background-opacity": 0,
            "border-opacity": 0,
            width: 190,
            height: (n: any) => 34 + n.data("rows") * 22,
          },
        },
        {
          selector: "edge",
          style: {
            width: 2.5,
            "line-color": "#4cc9f0",
            "target-arrow-color": "#4cc9f0",
            "target-arrow-shape": "triangle",
            "curve-style": "bezier",
            "arrow-scale": 1.1,
          },
        },
      ] as any,
      layout: {
        name: "dagre",
        rankDir: "LR",
        nodeSep: 50,
        rankSep: 130,
      } as any,
      wheelSensitivity: 0.5,
      minZoom: 0.2,
      maxZoom: 3,
    })
    ;(cy as any).nodeHtmlLabel([
      {
        query: "node",
        halign: "center",
        valign: "center",
        halignBox: "center",
        valignBox: "center",
        tpl: (data: { id: string }) => {
          const table = tableById.get(data.id)
          if (!table) return ""
          const rows = table.columns
            .map(
              (c) => `
            <div class="er-card-row">
              <span class="er-card-col">${escHtml(c.name)}</span>
              <span class="er-card-type">${escHtml(c.type)}</span>
              ${c.pk ? '<span class="er-badge pk">PK</span>' : ""}
              ${c.fk ? '<span class="er-badge fk">FK</span>' : ""}
            </div>`,
            )
            .join("")
          return `<div class="er-card"><div class="er-card-head">${escHtml(table.name)}</div>${rows}</div>`
        },
      },
    ])

    cy.one("layoutstop", () => cy.fit(undefined, 40))
  })
</script>
