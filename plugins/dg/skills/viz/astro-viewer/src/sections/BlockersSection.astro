---
import Callout from '../components/Callout.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props
---

<section id='blockers'>
  <Callout type='warning' title='Blockers'>
    <ul class='list-inside list-disc space-y-1'>
      {(payload.blockers ?? []).map((b: string) => <li>{b}</li>)}
    </ul>
  </Callout>
</section>
