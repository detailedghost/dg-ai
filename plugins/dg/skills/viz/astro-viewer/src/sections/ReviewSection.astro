---
/**
 * GitHub-PR style code review board — layout/styling lifted from proto-A
 * (/tmp/claude/viz-review-protos/review-proto-A.html). Renders full-bleed
 * (BoardView wraps this in a negative-margin box to escape Base's padding).
 *
 * All interactivity (grouping tabs, per-line comments, file approve/viewed,
 * overall verdict, submit) is vanilla JS in the trailing client script — this
 * component only serializes payload.review into a DATA blob for it to read.
 */
interface Props {
  payload: Record<string, unknown>
  mode: string
  inPlanning?: boolean
  collapsed?: boolean
}
const { payload } = Astro.props

const review = (payload.review ?? { repo: '', base: '', head: '', commits: [], files: [] }) as {
  repo: string
  base: string
  head: string
  commits: { sha: string; subject: string }[]
  files: {
    path: string
    dir: string
    status: string
    additions: number
    deletions: number
    patch: string
    slice: string | number | null
    commitSha: string | null
    newContent?: string
  }[]
}

const slug = payload.slug as string
const range = `${review.base}..${review.head}`
const subagents = Array.isArray(payload.subagents)
  ? (payload.subagents as { name: string; description: string }[])
  : []

/** /demo output, rendered as its own tab rather than above the diff (BoardView skips the standalone section). */
const demo = payload.demo as
  | { video?: string; poster?: string; caption?: string; screenshots?: { src: string; label?: string }[] }
  | undefined
const hasDemo = !!demo && !!(demo.video || (demo.screenshots ?? []).length > 0)
const reviewData = JSON.stringify({ slug, range, review, subagents, demo }).replace(/</g, "\\u003c")

/**
 * SSR persisted state: once /api/respond merges a review_submit answer, payload.review_result
 * holds it (see respond-core.ts). Base.astro's page-level poller reloads this board on any
 * payload.json mtime bump (it sets __vizOwnsMain, see below) — including the bump from the
 * submit itself — so the settled result must render server-side from the start, or the reload
 * that follows nearly every submit wipes it back to a live, resubmittable board.
 */
const reviewResult = payload.review_result as { verdict?: string } | undefined
const settledVerdict = reviewResult && reviewResult.verdict !== 'request_changes' ? (reviewResult.verdict ?? null) : null
const resultState = settledVerdict === 'approve' ? 'approved' : settledVerdict === 'comment' ? 'commented' : 'none'
const resultLabel = settledVerdict === 'approve' ? 'Approved' : 'Comment submitted'
---

<div id='review-app' data-slug={slug}>
  <div class='rv-banner'>
    <span class='rv-tag'>CODE REVIEW</span>
    <span class='rv-title'>{payload.title}</span>
    {payload.subtitle && <span class='rv-desc'>{payload.subtitle}</span>}
  </div>

  <div class='rv-meta-strip' id='rvMetaStrip'></div>

  <div class='rv-tabs'>
    <button type='button' class='rv-tab-btn active' data-mode='file'>Files</button>
    <button type='button' class='rv-tab-btn' data-mode='commit'>Commit</button>
    <button type='button' class='rv-tab-btn' data-mode='slice'>Spec</button>
    {hasDemo && <button type='button' class='rv-tab-btn rv-tab-demo' data-mode='demo'>▶ Demo</button>}
    <div class='rv-tabs-spacer'></div>
    <div class='rv-verdict-slot' id='rvVerdictSlot' data-result={resultState}>
      <button type='button' class='rv-verdict-approve-btn' id='rvApprove'>✓ Approve</button>
      <button type='button' class='rv-verdict-reject-btn' id='rvReject'>✕ Reject</button>
      <span class='rv-result rv-result-done' role='status'>
        <svg class='rv-result-check' viewBox='0 0 24 24' aria-hidden='true'>
          <path d='M4 12.6l5.2 5.2L20 7' />
        </svg>
        <span id='rvResultLabel'>{resultLabel}</span>
        <button type='button' class='rv-result-dismiss' id='rvResultDismiss' aria-label='Back to review'>✕</button>
      </span>
      <span class='rv-result rv-result-working' role='status' aria-live='polite'>
        <span class='rv-result-dot' aria-hidden='true'></span>
        Applying feedback
        <span class='rv-result-elapsed' id='rvResultElapsed'>0:00</span>
      </span>
    </div>
  </div>

  <div class='rv-main'>
    <nav class='rv-nav' id='rvNav'></nav>
    <div class='rv-nav-resizer' id='rvNavResizer'></div>
    <div class='rv-diff-pane' id='rvDiffPane'></div>
  </div>

  <div class='rv-verdict-overlay hidden' id='rvVerdictOverlay'>
    <div class='rv-verdict-modal'>
      <div class='rv-verdict-modal-header'>
        <h3>Submit review</h3>
        <button type='button' class='rv-icon-btn' id='rvCloseVerdict' aria-label='Close'>✕</button>
      </div>
      <textarea id='rvSummary' class='rv-summary-input' placeholder='Leave a summary comment (optional)'></textarea>
      <div class='rv-verdict-choices'>
        <label class='rv-verdict-choice'>
          <input type='radio' name='rv-verdict' value='comment' checked />
          <span class='rv-verdict-dot rv-verdict-dot-comment'></span>
          Comment
        </label>
        <label class='rv-verdict-choice'>
          <input type='radio' name='rv-verdict' value='approve' />
          <span class='rv-verdict-dot rv-verdict-dot-approve'></span>
          Approve
        </label>
        <label class='rv-verdict-choice'>
          <input type='radio' name='rv-verdict' value='request_changes' />
          <span class='rv-verdict-dot rv-verdict-dot-request'></span>
          Reject
        </label>
      </div>
      <div class='rv-verdict-footer'>
        <span id='rvVerdictStatus' class='rv-verdict-status'></span>
        <button type='button' class='rv-submit-btn' id='rvSubmitReview'>Submit review</button>
      </div>
    </div>
  </div>

</div>

<script type='application/json' id='rv-data' is:inline set:html={reviewData} />

<script>
  import { burstConfetti } from '../lib/confetti.ts'
  import { setDoneFavicon } from '../lib/doneOverlay.ts'
  import { setFaviconHref, FAVICON_WAITING } from '../lib/favicon.ts'
  import {
    buildReviewFileTree,
    countReviewFiles,
    type ReviewFileTreeNode,
  } from '../lib/review-file-tree.ts'
  import {
    highlightReviewSource,
    languageLabel,
    type ReviewSyntaxHighlighter,
  } from '../lib/review-syntax.ts'
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'

  interface ReviewCommit { sha: string; subject: string }
  interface ReviewFile {
    path: string
    dir: string
    status: string
    additions: number
    deletions: number
    patch: string
    slice: string | number | null
    commitSha: string | null
    newContent?: string
  }
  interface SubagentInfo { name: string; description: string }
  // Seed shape written by `dg-skills viz review --comments` (e.g. reviewer-agent findings) — pre-fills
  // state.lineComments via the same addComment/addFileComment path a human click would take.
  interface SeedComment {
    file: string
    side?: 'old' | 'new'
    lineNumber?: number | null
    startLineNumber?: number
    body: string
  }
  interface ReviewData {
    slug: string
    range: string
    review: {
      repo: string
      base: string
      head: string
      commits: ReviewCommit[]
      files: ReviewFile[]
      slices?: SliceMeta[]
      seedComments?: SeedComment[]
    }
    subagents: SubagentInfo[]
    demo?: DemoPayload
  }

  /** One entry per slice in the spec, in spec order — see the review command sliceMeta. */
  interface SliceMeta {
    id: string
    name: string
    /** Matches ReviewFile.slice, so it joins files to their slice. */
    label: string
    description?: string
    /** Every path the slice declares; slices overlap, so this is not deduplicated across them. */
    files: string[]
  }

  interface DemoPayload {
    video?: string
    poster?: string
    caption?: string
    screenshots?: { src: string; label?: string }[]
  }

  interface LineComment {
    file: string
    // null only for a file-scoped comment (scope: 'file') — every line comment has both.
    side: 'old' | 'new' | null
    lineNumber: number | null
    // Present + different from lineNumber only for a shift-click range comment — the
    // comment is still keyed/rendered at lineNumber (the range's end/anchor line).
    startLineNumber?: number
    scope: 'line' | 'file'
    body: string
  }
  interface FileApproval {
    path: string
    viewed: boolean
  }

  const dataEl = document.getElementById('rv-data')
  const DATA: ReviewData = JSON.parse(dataEl?.textContent ?? '{"slug":"","range":"","review":{"repo":"","base":"","head":"","commits":[],"files":[]},"subagents":[]}')
  const FILES = DATA.review.files
  const COMMITS = DATA.review.commits
  const SUBAGENTS = DATA.subagents ?? []
  const DEMO = DATA.demo
  const SLICES = DATA.review.slices ?? []

  // This board client-builds #viz-main, so Base.astro's poller must reload (not innerHTML-swap) on any rev bump.
  ;(window as unknown as { __vizOwnsMain?: boolean }).__vizOwnsMain = true

  const SLICE_LABEL_FALLBACK = 'Docs & other'

  function sliceLabel(slice: string | number | null): string {
    if (slice === null || slice === undefined) return SLICE_LABEL_FALLBACK
    return String(slice)
  }

  const state = {
    mode: 'file' as 'commit' | 'file' | 'slice' | 'demo',
    activeFile: null as string | null,
    // Slice-tab accordion: which slices are open. Empty = all collapsed, so the tab opens as a
    // readable list of slices rather than the whole diff again.
    expandedSlices: new Set<string>(),
    // Collapsed folders in the left file tree, keyed by the folder's (post-compaction) full path.
    collapsedDirs: new Set<string>(),
    // Per-file viewed/approve + comment.
    fileApprovals: new Map<string, FileApproval>(),
    // Comments, keyed by `${file}::${side}::${lineNumber}` for line comments, or
    // `${file}::file` for a file-scoped comment (see fileCommentKey).
    lineComments: new Map<string, LineComment[]>(),
  }
  for (const f of FILES) state.fileApprovals.set(f.path, { path: f.path, viewed: false })

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string))
  }
  function cssEscape(s: string): string {
    return s.replace(/[^a-zA-Z0-9_-]/g, '_')
  }

  // Loaded dynamically (rather than a static top-level `import`) so a failure to
  // resolve the dependency (e.g. a stale Vite optimize-deps cache returning a 504)
  // only degrades markdown rendering instead of aborting this entire module —
  // a failed static import kills the whole script before renderNav()/renderDiffPane()
  // ever run, wiping the nav tree and diff pane along with it.
  let marked: (typeof import('marked'))['marked'] | null = null
  try {
    const markedModule = await import('marked')
    marked = markedModule.marked
    // Raw HTML passthrough from markdown source (block or inline) is escaped rather than
    // rendered — review content comes from arbitrary diffs/comments, never trust it as HTML.
    marked.use({
      renderer: {
        html(token: { text: string }): string {
          return escapeHtml(token.text)
        },
      },
    })
  } catch (err) {
    console.error('[viz] failed to load marked — markdown/HTML preview will show as plain escaped text', err)
  }
  function renderMarkdown(md: string): string {
    if (!marked) return `<pre class="rv-md-fallback">${escapeHtml(md)}</pre>`
    return marked.parse(md, { async: false }) as string
  }

  // The optional highlighter is isolated behind a dynamic import for the same reason as
  // marked above: a stale optimized dependency must degrade code color, never blank the board.
  let sourceHighlighter: ReviewSyntaxHighlighter | null = null
  try {
    const { createReviewHighlighter } = await import('../lib/review-highlighter.ts')
    sourceHighlighter = createReviewHighlighter()
  } catch (err) {
    console.error('[viz] failed to load review syntax grammars — code will show as plain escaped text', err)
  }

  interface DiffRow {
    type: 'hunk' | 'add' | 'del' | 'ctx'
    text: string
    oldLn?: number
    newLn?: number
  }

  function parsePatch(patch: string): { rows: DiffRow[]; truncated: boolean } {
    const lines = patch.split('\n')
    const rows: DiffRow[] = []
    let oldLn = 0
    let newLn = 0
    let truncated = false
    for (const raw of lines) {
      if (
        raw.startsWith('diff --git') || raw.startsWith('index ') || raw.startsWith('new file') ||
        raw.startsWith('deleted file') || raw.startsWith('--- ') || raw.startsWith('+++ ')
      ) continue
      if (raw.startsWith('@@')) {
        const m = raw.match(/@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/)
        if (m) { oldLn = parseInt(m[1], 10); newLn = parseInt(m[2], 10) }
        rows.push({ type: 'hunk', text: raw })
        continue
      }
      if (raw.length === 0 && rows.length === lines.length - 1) { truncated = true; continue }
      if (raw.startsWith('+')) {
        rows.push({ type: 'add', text: raw.slice(1), newLn: newLn++ })
      } else if (raw.startsWith('-')) {
        rows.push({ type: 'del', text: raw.slice(1), oldLn: oldLn++ })
      } else {
        rows.push({ type: 'ctx', text: raw.slice(1), oldLn: oldLn++, newLn: newLn++ })
      }
    }
    return { rows, truncated }
  }

  // Shift-click range selection: orders an anchor/clicked line pair regardless of
  // which direction the user dragged the shift-click (up or down the gutter).
  function computeLineRange(a: number, b: number): [number, number] {
    return a <= b ? [a, b] : [b, a]
  }

  function commentKey(path: string, side: 'old' | 'new', lineNumber: number): string {
    return `${path}::${side}::${lineNumber}`
  }

  // File-scoped comments live in the same state.lineComments map as line comments —
  // just under this distinct key — so they flow through the same buildLineCommentsPayload()
  // flatten into the submitted review_result, distinguished by scope/lineNumber alone.
  function fileCommentKey(path: string): string {
    return `${path}::file`
  }

  function commentsFor(path: string, side: 'old' | 'new', lineNumber: number): LineComment[] {
    return state.lineComments.get(commentKey(path, side, lineNumber)) ?? []
  }

  function fileCommentsFor(path: string): LineComment[] {
    return state.lineComments.get(fileCommentKey(path)) ?? []
  }

  // startLineNumber is set only for a shift-click range comment (see computeLineRange /
  // openRangeCommentForm) — the comment is still keyed/rendered at lineNumber, the
  // range's end/anchor line, so single-line callers are unaffected.
  function addComment(path: string, side: 'old' | 'new', lineNumber: number, body: string, startLineNumber?: number): void {
    const key = commentKey(path, side, lineNumber)
    const list = state.lineComments.get(key) ?? []
    list.push({ file: path, side, lineNumber, startLineNumber, scope: 'line', body })
    state.lineComments.set(key, list)
  }

  function addFileComment(path: string, body: string): void {
    const key = fileCommentKey(path)
    const list = state.lineComments.get(key) ?? []
    list.push({ file: path, side: null, lineNumber: null, scope: 'file', body })
    state.lineComments.set(key, list)
  }

  function removeComment(path: string, side: 'old' | 'new', lineNumber: number, idx: number): void {
    const key = commentKey(path, side, lineNumber)
    const list = state.lineComments.get(key)
    if (!list) return
    list.splice(idx, 1)
    if (list.length === 0) state.lineComments.delete(key)
    else state.lineComments.set(key, list)
  }

  function removeFileComment(path: string, idx: number): void {
    const key = fileCommentKey(path)
    const list = state.lineComments.get(key)
    if (!list) return
    list.splice(idx, 1)
    if (list.length === 0) state.lineComments.delete(key)
    else state.lineComments.set(key, list)
  }

  function editComment(path: string, side: 'old' | 'new', lineNumber: number, idx: number, body: string): void {
    const key = commentKey(path, side, lineNumber)
    const list = state.lineComments.get(key)
    if (!list || !list[idx]) return
    list[idx].body = body
  }

  function editFileComment(path: string, idx: number, body: string): void {
    const key = fileCommentKey(path)
    const list = state.lineComments.get(key)
    if (!list || !list[idx]) return
    list[idx].body = body
  }

  function totalCommentCount(): number {
    let n = 0
    for (const list of state.lineComments.values()) n += list.length
    return n
  }

  function commentRowHtml(path: string, side: 'old' | 'new', lineNumber: number): string {
    const comments = commentsFor(path, side, lineNumber)
    if (comments.length === 0) return ''
    const items = comments
      .map(
        (c, i) => `<div class="rv-comment" data-path="${escapeHtml(path)}" data-scope="line" data-side="${side}" data-line="${lineNumber}" data-idx="${i}">
          ${c.startLineNumber && c.startLineNumber !== lineNumber ? `<div class="rv-comment-range-label">Lines ${c.startLineNumber}–${lineNumber}</div>` : ''}
          <div class="rv-comment-body rv-md">${renderMarkdown(c.body)}</div>
          <div class="rv-comment-actions">
            <button type="button" class="rv-comment-edit" title="Edit comment">Edit</button>
            <button type="button" class="rv-comment-remove" title="Delete comment">Delete</button>
          </div>
        </div>`,
      )
      .join('')
    return `<tr class="rv-comment-row"><td colspan="4"><div class="rv-comment-thread">${items}</div></td></tr>`
  }

  function fileCommentThreadHtml(path: string): string {
    const comments = fileCommentsFor(path)
    if (comments.length === 0) return ''
    const items = comments
      .map(
        (c, i) => `<div class="rv-comment" data-path="${escapeHtml(path)}" data-scope="file" data-idx="${i}">
          <div class="rv-comment-body rv-md">${renderMarkdown(c.body)}</div>
          <div class="rv-comment-actions">
            <button type="button" class="rv-comment-edit" title="Edit comment">Edit</button>
            <button type="button" class="rv-comment-remove" title="Delete comment">Delete</button>
          </div>
        </div>`,
      )
      .join('')
    return `<div class="rv-file-comment-thread">${items}</div>`
  }

  function fileCommentFormHtml(path: string): string {
    return `<div class="rv-comment-form-row hidden" data-path="${escapeHtml(path)}" data-scope="file">
      <div class="rv-comment-form">
        <textarea class="rv-comment-textarea" placeholder="Leave a comment on this file"></textarea>
        <div class="rv-comment-form-actions">
          <button type="button" class="rv-comment-cancel">Cancel</button>
          <button type="button" class="rv-comment-add">Comment</button>
        </div>
      </div>
    </div>`
  }

  function addCommentFormHtml(path: string, side: 'old' | 'new', lineNumber: number): string {
    return `<tr class="rv-comment-form-row hidden" data-path="${escapeHtml(path)}" data-scope="line" data-side="${side}" data-line="${lineNumber}">
      <td colspan="4">
        <div class="rv-comment-form">
          <textarea class="rv-comment-textarea" placeholder="Leave a comment"></textarea>
          <div class="rv-comment-form-actions">
            <button type="button" class="rv-comment-cancel">Cancel</button>
            <button type="button" class="rv-comment-add">Comment</button>
          </div>
        </div>
      </td>
    </tr>`
  }

  function renderDiffTable(file: ReviewFile): string {
    const { rows, truncated } = parsePatch(file.patch)
    const trs = rows
      .map((r) => {
        if (r.type === 'hunk') {
          return `<tr class="hunk"><td class="ln"></td><td class="ln"></td><td class="marker"></td><td class="code">${escapeHtml(r.text)}</td></tr>`
        }
        const marker = r.type === 'add' ? '+' : r.type === 'del' ? '-' : ''
        const oldCell = r.type === 'add' ? '' : (r.oldLn ?? '')
        const newCell = r.type === 'del' ? '' : (r.newLn ?? '')
        // Anchor side/line: prefer new-side line for add/ctx, old-side for del — matches GitHub's per-line semantics.
        const side: 'old' | 'new' = r.type === 'del' ? 'old' : 'new'
        const lineNumber = side === 'old' ? (r.oldLn ?? 0) : (r.newLn ?? 0)
        // Kept on one line deliberately: td.code/td.ln use white-space:pre, and a
        // pretty-printed multi-line template here would render as literal blank rows.
        const highlightedCode = highlightReviewSource(r.text, file.path, sourceHighlighter, escapeHtml)
        const rowHtml = `<tr class="${r.type}" data-path="${escapeHtml(file.path)}" data-side="${side}" data-line="${lineNumber}"><td class="ln">${oldCell}</td><td class="ln">${newCell}</td><td class="marker"><span class="rv-marker-text">${marker}</span><button type="button" class="rv-gutter-add" title="Add comment">+</button></td><td class="code">${highlightedCode}</td></tr>`
        return rowHtml + addCommentFormHtml(file.path, side, lineNumber) + commentRowHtml(file.path, side, lineNumber)
      })
      .join('')
    const truncatedRow = truncated ? `<tr class="truncated"><td colspan="4">⋯ end of patch ⋯</td></tr>` : ''
    return `<div class="rv-diff-scroll"><table class="rv-diff-table"><tbody>${trs}${truncatedRow}</tbody></table></div>`
  }

  type FileKind = 'markdown' | 'html' | 'other'
  function fileKind(path: string): FileKind {
    if (/\.(md|markdown|mdx)$/i.test(path)) return 'markdown'
    if (/\.(html|htm)$/i.test(path)) return 'html'
    return 'other'
  }

  /**
   * sliceTagOverride names the grouping the card is being rendered *under*. The slice pane shows one
   * file beneath every slice that declares it, so the file's own single-valued `slice` would label a
   * card in slice 5's pane with slice 7.5 — contradicting the heading directly above it.
   */
  function fileCardHtml(file: ReviewFile, idOverride?: string, sliceTagOverride?: string): string {
    const id = idOverride || file.path
    // groupDir() sends "." for a repo-root file, which is a grouping key and not a path prefix —
    // slicing its length off blindly ate the first two characters ("README.md" → "./ADME.md").
    const dirPart = file.dir && file.dir !== '.' ? file.dir + '/' : ''
    const base = file.path.startsWith(dirPart) ? file.path.slice(dirPart.length) : file.path
    const approval = state.fileApprovals.get(file.path)
    const viewed = !!approval?.viewed
    const hasContent = typeof file.newContent === 'string' && file.newContent.length > 0
    const kind = hasContent ? fileKind(file.path) : 'other'

    // Diff is always available; Code shows raw newContent; Rendered only applies to markdown/HTML.
    const views: { key: 'diff' | 'code' | 'rendered'; label: string }[] = [{ key: 'diff', label: 'Diff' }]
    if (hasContent) {
      views.push({ key: 'code', label: 'Code' })
      if (kind === 'markdown' || kind === 'html') views.push({ key: 'rendered', label: 'Rendered' })
    }
    const viewToggleHtml = hasContent
      ? `<div class="rv-view-toggle" onclick="event.stopPropagation()">
          ${views.map((v, i) => `<button type="button" class="rv-view-toggle-btn${i === 0 ? ' active' : ''}" data-view="${v.key}">${v.label}</button>`).join('')}
        </div>`
      : ''

    const codeHtml = hasContent
      ? `<div class="rv-view-code hidden"><pre class="rv-code-pre">${highlightReviewSource(file.newContent as string, file.path, sourceHighlighter, escapeHtml)}</pre></div>`
      : ''
    let renderedHtml = ''
    if (hasContent && kind === 'markdown') {
      renderedHtml = `<div class="rv-view-rendered rv-md hidden">${renderMarkdown(file.newContent as string)}</div>`
    } else if (hasContent && kind === 'html') {
      // No allow-scripts on the sandbox — this is a read-only preview, source scripts must never execute.
      renderedHtml = `<div class="rv-view-rendered hidden"><iframe class="rv-html-preview" sandbox srcdoc="${escapeHtml(file.newContent as string)}"></iframe></div>`
    }
    const bodyHtml = hasContent
      ? `<div class="rv-view-diff">${renderDiffTable(file)}</div>${codeHtml}${renderedHtml}`
      : renderDiffTable(file)
    const sourceLabel = languageLabel(file.path)
    const languageTagHtml = sourceLabel ? `<span class="rv-language-tag">${escapeHtml(sourceLabel)}</span>` : ''
    // GitHub-style: marking a file viewed auto-collapses its card (omit `open`);
    // unchecking re-expands. Derived straight from state.fileApprovals, so it
    // survives any re-render without a separate collapsed-state field.
    return `<details class="rv-file-card" id="card-${cssEscape(id)}" ${viewed ? '' : 'open'} data-path="${escapeHtml(file.path)}">
      <summary>
        <span class="rv-chevron">▾</span>
        <span class="rv-pill rv-pill-${file.status}">${file.status.slice(0, 1).toUpperCase()}</span>
        <span class="rv-path"><span class="rv-dirpart">${escapeHtml(dirPart)}</span>${escapeHtml(base)}</span>
        ${languageTagHtml}
        ${viewToggleHtml}
        <span class="rv-spacer"></span>
        <span class="rv-slice-tag">${escapeHtml(sliceTagOverride ?? sliceLabel(file.slice))}</span>
        <span class="rv-tally"><span class="a">+${file.additions}</span> <span class="d">-${file.deletions}</span></span>
        <button type="button" class="rv-file-comment-toggle-btn" title="Add comment to file" onclick="event.stopPropagation()">💬 Add comment to file</button>
        <label class="rv-viewed-toggle" onclick="event.stopPropagation()">
          <input type="checkbox" class="rv-viewed-checkbox" data-path="${escapeHtml(file.path)}" ${viewed ? 'checked' : ''} />
          Viewed
        </label>
      </summary>
      ${bodyHtml}
      <div class="rv-file-comment-section">
        ${fileCommentThreadHtml(file.path)}
        ${fileCommentFormHtml(file.path)}
      </div>
    </details>`
  }

  function computeTotals() {
    const adds = FILES.reduce((s, f) => s + f.additions, 0)
    const dels = FILES.reduce((s, f) => s + f.deletions, 0)
    return { commits: COMMITS.length, files: FILES.length, adds, dels }
  }

  function renderMetaStrip(): void {
    const t = computeTotals()
    const el = document.getElementById('rvMetaStrip')
    if (!el) return
    const viewedCount = [...state.fileApprovals.values()].filter((a) => a.viewed).length
    el.innerHTML = `
      <span class="rv-range">${escapeHtml(DATA.range)}</span>
      <span class="rv-stat"><strong>${t.commits}</strong> commits</span>
      <span class="rv-stat"><strong>${t.files}</strong> files changed</span>
      <span class="rv-stat"><span class="a">+${t.adds}</span> <span class="d">-${t.dels}</span></span>
      <span class="rv-stat">${viewedCount}/${t.files} viewed</span>
      <span class="rv-stat">${totalCommentCount()} comment(s)</span>
    `
  }

  // Deterministic ordering for the flat commit/slice groupings: full path, alphabetical
  // case-insensitive — independent of payload/insertion order.
  function sortFilesByPath(files: ReviewFile[]): ReviewFile[] {
    return [...files].sort((a, b) => a.path.localeCompare(b.path, undefined, { sensitivity: 'base' }))
  }

  function groupByCommit() {
    return COMMITS.map((c) => ({
      key: c.sha,
      title: c.sha,
      subtitle: c.subject,
      files: sortFilesByPath(FILES.filter((f) => f.commitSha === c.sha)),
    })).filter((g) => g.files.length > 0)
  }

  /**
   * Slice-tab rows in spec order, including slices no changed file touched — the spec's slice
   * list is the checklist, so a slice with nothing in the diff is information, not something to
   * hide. Anything unmatched by the spec lands in a trailing catch-all row.
   *
   * A row shows every changed file the slice DECLARES, not the files uniquely assigned to it, so
   * a file two slices both touched appears under both. Attributing it to one slice only would
   * show the slice that created a file as empty once a later slice revised it.
   */
  function sliceRows(): { key: string; tag: string; heading: string; description: string; files: ReviewFile[] }[] {
    const changedByPath = new Map(FILES.map((f) => [f.path, f]))

    const rows = SLICES.map((s) => ({
      key: s.label,
      tag: s.label,
      heading: `Slice ${s.id}${s.name ? ` — ${s.name}` : ''}`,
      description: s.description ?? '',
      files: sortFilesByPath(s.files.map((p) => changedByPath.get(p)).filter((f): f is ReviewFile => !!f)),
    }))

    // Whatever no slice declares (docs, school notes, drive-by edits).
    const declared = new Set(SLICES.flatMap((s) => s.files))
    const leftovers = FILES.filter((f) => !declared.has(f.path))
    if (leftovers.length > 0) {
      rows.push({
        key: 'other',
        tag: SLICE_LABEL_FALLBACK,
        heading: SLICE_LABEL_FALLBACK,
        description: 'Changed files no slice in the spec declares.',
        files: sortFilesByPath(leftovers),
      })
    }
    return rows
  }

  type SliceRow = ReturnType<typeof sliceRows>[number]

  /** The one expanded slice, or null. Single-open, so the first entry is the whole answer. */
  function openSliceKey(): string | null {
    for (const key of state.expandedSlices) return key
    return null
  }

  /**
   * Expands exactly one slice — or none, for null — and re-renders. The pane is rebuilt rather than
   * poked because the sticky prev/next bars depend on *which* slice is open, so the surrounding
   * chrome changes with every toggle, not just the row itself.
   */
  function setOpenSlice(key: string | null): void {
    state.expandedSlices.clear()
    if (key) state.expandedSlices.add(key)
    renderDiffPane()
    renderNav()
    if (!key) return
    document
      .querySelector<HTMLElement>(`details.rv-slice[data-slice="${cssAttrEscape(key)}"]`)
      ?.scrollIntoView({ block: 'start', behavior: 'smooth' })
  }

  /** Sticky jump target for the slice before/after the open one; '' when there is none. */
  function sliceJumpHtml(row: SliceRow | null, dir: 'prev' | 'next'): string {
    if (!row) return ''
    const label = dir === 'prev' ? '↑ Previous slice' : '↓ Next slice'
    const count = row.files.length === 0 ? 'no files changed' : `${row.files.length} file${row.files.length === 1 ? '' : 's'}`
    return (
      `<button type="button" class="rv-slice-jump rv-slice-jump-${dir}" data-goto-slice="${escapeHtml(row.key)}">` +
      `<span class="rv-slice-jump-dir">${label}</span>` +
      `<span class="rv-slice-jump-name">${escapeHtml(row.heading)}</span>` +
      `<span class="rv-slice-jump-meta">${count}</span>` +
      `</button>`
    )
  }

  function renderSlicePane(): string {
    const rows = sliceRows()
    if (rows.length === 0) {
      return `<div class="rv-demo-empty">No spec slices found — pass --spec to group by slice.</div>`
    }
    const openIdx = rows.findIndex((r) => r.key === openSliceKey())
    const prev = openIdx > 0 ? rows[openIdx - 1] : null
    const next = openIdx >= 0 && openIdx < rows.length - 1 ? rows[openIdx + 1] : null

    return `<section class="rv-slice-list">${sliceJumpHtml(prev, 'prev')}${rows
      .map((row) => {
        const add = row.files.reduce((s, f) => s + f.additions, 0)
        const del = row.files.reduce((s, f) => s + f.deletions, 0)
        const open = state.expandedSlices.has(row.key)
        const empty = row.files.length === 0
        const counts = empty
          ? `<span class="rv-slice-empty">no files changed</span>`
          : `<span class="rv-slice-count">${row.files.length} file${row.files.length === 1 ? '' : 's'}</span>` +
            `<span class="a">+${add}</span> <span class="d">-${del}</span>`
        const body = empty
          ? `<div class="rv-slice-emptybody">Nothing in this range touches the files this slice declares.</div>`
          // Slice-scoped card id, same trick as commit mode: one file can appear under two
          // slices, and a bare path would collide. Comments/approvals still key off file.path.
          : row.files.map((f) => fileCardHtml(f, `${row.key}::${f.path}`, row.tag)).join('')
        return (
          `<details class="rv-slice${empty ? ' is-empty' : ''}" data-slice="${escapeHtml(row.key)}"${open ? ' open' : ''}>` +
          `<summary class="rv-slice-summary"><span class="rv-slice-caret">▸</span>` +
          `<span class="rv-slice-heading">${escapeHtml(row.heading)}</span>` +
          `<span class="rv-slice-meta">${counts}</span></summary>` +
          (row.description ? `<p class="rv-slice-desc">${escapeHtml(row.description)}</p>` : '') +
          `<div class="rv-slice-files">${body}</div>` +
          `</details>`
        )
      })
      .join('')}${sliceJumpHtml(next, 'next')}</section>`
  }
  // ── File tree (nav) ─────────────────────────────────────────────────────
  // Independent of state.mode — the tree is the constant file navigator; only
  // the diff pane below re-groups by commit/file/slice.
  type TreeNode = ReviewFileTreeNode<ReviewFile>

  // ── "By file" diff-pane tree ────────────────────────────────────────────
  // Mirrors the nav's own directory nesting (buildReviewFileTree) instead
  // of a flat one-level grouping keyed by exact directory string — so a repo
  // with deep paths shows real collapsible folders in the main pane too.
  function renderFileTreeNode(node: TreeNode): string {
    if (node.type === 'file') {
      return fileCardHtml(node.file, node.file.path)
    }
    const collapsed = state.collapsedDirs.has(node.path) ? '' : 'open'
    const childrenHtml = node.children.map((c) => renderFileTreeNode(c)).join('')
    return `<details class="rv-diff-tree-folder" data-dir="${escapeHtml(node.path)}" ${collapsed}>
      <summary class="rv-diff-tree-folder-header">
        <span class="rv-chevron">▾</span>
        <span class="rv-diff-tree-folder-name">${escapeHtml(node.name)}</span>
        <span class="rv-count">${countReviewFiles(node)}</span>
      </summary>
      <div class="rv-diff-tree-folder-body">${childrenHtml}</div>
    </details>`
  }

  function renderFileTreeSections(files: ReviewFile[]): string {
    const root = buildReviewFileTree(files)
    return root.children.map((c) => renderFileTreeNode(c)).join('')
  }

  function renderTreeNode(node: TreeNode): string {
    if (node.type === 'file') {
      const f = node.file
      const active = state.activeFile === f.path ? 'active' : ''
      const viewed = state.fileApprovals.get(f.path)?.viewed ? 'rv-nav-file-viewed' : ''
      return `<div class="rv-nav-file ${active} ${viewed}" data-path="${escapeHtml(f.path)}" title="${escapeHtml(f.path)}">
        <span class="rv-status-badge rv-status-badge-${f.status}">${f.status.slice(0, 1).toUpperCase()}</span>
        <span class="rv-fname">${escapeHtml(node.name)}</span>
        <span class="rv-stat-mini"><span class="a">+${f.additions}</span><span class="d">-${f.deletions}</span></span>
      </div>`
    }
    const collapsed = state.collapsedDirs.has(node.path) ? 'collapsed' : ''
    const childrenHtml = node.children.map((c) => renderTreeNode(c)).join('')
    return `<div class="rv-tree-folder ${collapsed}" data-dir="${escapeHtml(node.path)}">
      <div class="rv-tree-folder-header">
        <span class="rv-chevron">▾</span>
        <span class="rv-tree-folder-name">${escapeHtml(node.name)}</span>
        <span class="rv-count">${countReviewFiles(node)}</span>
      </div>
      <div class="rv-tree-folder-body ${collapsed}">${childrenHtml}</div>
    </div>`
  }

  /**
   * The files the nav tree lists. In slice mode it narrows to whichever slices are expanded, so the
   * tree and the diff pane always show the same set instead of the tree listing the whole range.
   * With nothing expanded — or in any other mode — it falls back to every changed file, because an
   * empty tree reads as a broken board rather than as "collapse everything to see nothing".
   * Deduped by path: a file two slices both declare is one tree entry, not two.
   */
  function navFiles(): ReviewFile[] {
    if (state.mode !== 'slice' || state.expandedSlices.size === 0) return FILES
    const open = sliceRows().filter((r) => state.expandedSlices.has(r.key))
    const byPath = new Map(open.flatMap((r) => r.files).map((f) => [f.path, f]))
    return sortFilesByPath([...byPath.values()])
  }

  function renderNav(): void {
    const nav = document.getElementById('rvNav')
    if (!nav) return
    const root = buildReviewFileTree(navFiles())
    nav.innerHTML = root.children.map((c) => renderTreeNode(c)).join('')

    nav.querySelectorAll('.rv-tree-folder-header').forEach((h) => {
      h.addEventListener('click', () => {
        const folder = h.closest('.rv-tree-folder') as HTMLElement
        const dir = folder.dataset.dir as string
        const body = folder.querySelector(':scope > .rv-tree-folder-body') as HTMLElement
        if (state.collapsedDirs.has(dir)) {
          state.collapsedDirs.delete(dir); folder.classList.remove('collapsed'); body.classList.remove('collapsed')
        } else {
          state.collapsedDirs.add(dir); folder.classList.add('collapsed'); body.classList.add('collapsed')
        }
      })
    })
    nav.querySelectorAll('.rv-nav-file').forEach((el) => {
      el.addEventListener('click', () => {
        const path = (el as HTMLElement).dataset.path as string
        state.activeFile = path
        renderNavActiveOnly()
        scrollToFileAnyGroup(path)
      })
    })
  }

  function renderNavActiveOnly(): void {
    document.querySelectorAll('.rv-nav-file').forEach((el) => {
      el.classList.toggle('active', (el as HTMLElement).dataset.path === state.activeFile)
    })
  }

  function scrollToFileAnyGroup(path: string): void {
    const cards = [...document.querySelectorAll<HTMLDetailsElement>('.rv-file-card')].filter((c) => c.dataset.path === path)
    // One file can have a card under several slices; jump to one whose slice is already open rather
    // than scrolling to a card hidden inside a collapsed group. No ancestor slice → any card will do.
    const card = cards.find((c) => c.closest<HTMLDetailsElement>('details.rv-slice')?.open !== false) ?? cards[0]
    if (!card) return
    const slice = card.closest<HTMLDetailsElement>('details.rv-slice')
    if (slice && !slice.open) slice.open = true
    if (!card.open) card.open = true
    card.scrollIntoView({ block: 'start', behavior: 'smooth' })
  }

  // ── Scroll-spy: highlight whichever file card is most in view ──────────────
  // Pure decision logic (pickMostVisiblePath/applyScrollSpyResult) is kept
  // separate from the IntersectionObserver wiring so it's testable without a
  // real DOM/browser.
  function pickMostVisiblePath(ratios: Map<string, number>): string | null {
    let bestPath: string | null = null
    let bestRatio = 0
    for (const [path, ratio] of ratios) {
      if (ratio > bestRatio) { bestRatio = ratio; bestPath = path }
    }
    return bestPath
  }

  function scrollActiveNavIntoView(): void {
    document.querySelector('.rv-nav-file.active')?.scrollIntoView({ block: 'nearest' })
  }

  function applyScrollSpyResult(ratios: Map<string, number>): void {
    const bestPath = pickMostVisiblePath(ratios)
    if (!bestPath || bestPath === state.activeFile) return
    state.activeFile = bestPath
    renderNavActiveOnly()
    scrollActiveNavIntoView()
  }

  let scrollSpyObserver: IntersectionObserver | null = null

  function initScrollSpy(): void {
    scrollSpyObserver?.disconnect()
    const pane = document.getElementById('rvDiffPane')
    if (!pane) return
    const ratios = new Map<string, number>()
    scrollSpyObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const path = (entry.target as HTMLElement).dataset.path
          if (path) ratios.set(path, entry.isIntersecting ? entry.intersectionRatio : 0)
        }
        applyScrollSpyResult(ratios)
      },
      { root: pane, threshold: [0, 0.25, 0.5, 0.75, 1] },
    )
    pane.querySelectorAll<HTMLElement>('.rv-file-card').forEach((card) => scrollSpyObserver!.observe(card))
  }

  /** The Demo tab's pane. Video (controls only, never autoplay) then the screenshot grid. */
  function renderDemoPane(): string {
    if (!DEMO) return '<div class="rv-demo-empty">No demo assets were attached to this review.</div>'
    const shots = DEMO.screenshots ?? []
    const videoType = DEMO.video?.endsWith('.webm') ? 'video/webm' : 'video/mp4'
    const parts: string[] = []
    if (DEMO.caption) parts.push(`<p class="rv-demo-caption">${escapeHtml(DEMO.caption)}</p>`)
    if (DEMO.video) {
      const poster = DEMO.poster ? ` poster="${escapeHtml(DEMO.poster)}"` : ''
      parts.push(
        `<div class="rv-demo-videowrap"><video class="rv-demo-video" controls preload="metadata"${poster}>` +
          `<source src="${escapeHtml(DEMO.video)}" type="${videoType}">` +
          `Your browser cannot play this video. <a href="${escapeHtml(DEMO.video)}">Open it directly.</a>` +
          `</video></div>`,
      )
    }
    if (shots.length > 0) {
      const figures = shots
        .map(
          (shot) =>
            `<figure class="rv-demo-shot"><a href="${escapeHtml(shot.src)}" target="_blank" rel="noopener noreferrer">` +
            `<img src="${escapeHtml(shot.src)}" alt="${escapeHtml(shot.label ?? 'demo screenshot')}" loading="lazy"></a>` +
            (shot.label ? `<figcaption>${escapeHtml(shot.label)}</figcaption>` : '') +
            `</figure>`,
        )
        .join('')
      parts.push(`<div class="rv-demo-shots">${figures}</div>`)
    }
    return `<section class="rv-group-section rv-demo-pane">${parts.join('')}</section>`
  }

  function renderDiffPane(): void {
    const pane = document.getElementById('rvDiffPane')
    if (!pane) return
    if (state.mode === 'demo') {
      // No file cards here to bind or observe — disconnect scrollSpyObserver so it doesn't
      // keep watching the nodes this innerHTML swap is about to detach.
      scrollSpyObserver?.disconnect()
      pane.innerHTML = renderDemoPane()
      return
    }
    if (state.mode === 'slice') {
      pane.innerHTML = renderSlicePane()
    } else if (state.mode === 'file') {
      pane.innerHTML = renderFileTreeSections(FILES)
    } else {
      // Only 'commit' mode reaches here — 'file' and 'slice' render via their own panes above.
      const groups = groupByCommit()
      pane.innerHTML = groups
        .map((g) => {
          const headerHtml = `<h2><span class="rv-sha">${escapeHtml(g.key)}</span></h2><div class="rv-sub">${escapeHtml(g.subtitle)}</div>`
          const cardsHtml = g.files.map((f) => fileCardHtml(f, `${g.key}::${f.path}`)).join('')
          return `<section class="rv-group-section"><div class="rv-section-header">${headerHtml}</div>${cardsHtml}</section>`
        })
        .join('')
    }
    bindDiffPaneEvents()
    initScrollSpy()
  }

  function bindDiffPaneEvents(): void {
    const pane = document.getElementById('rvDiffPane')
    if (!pane) return

    // Which slice is open is state, not DOM, so a re-render (comment added, file marked viewed)
    // never collapses the reviewer's place. Opening one closes the rest.
    pane.querySelectorAll<HTMLDetailsElement>('details.rv-slice').forEach((row) => {
      row.addEventListener('toggle', () => {
        const key = row.dataset.slice
        if (!key) return
        const desired = row.open ? key : null
        // setOpenSlice re-renders, and inserting the rebuilt `<details open>` fires toggle again —
        // which would call straight back in here forever. A no-op when the DOM already agrees.
        if (desired === openSliceKey()) return
        setOpenSlice(desired)
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-slice-jump').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.gotoSlice
        if (key) setOpenSlice(key)
      })
    })

    pane.querySelectorAll<HTMLInputElement>('.rv-viewed-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => {
        const path = cb.dataset.path as string
        const approval = state.fileApprovals.get(path) ?? { path, viewed: false }
        approval.viewed = cb.checked
        state.fileApprovals.set(path, approval)
        // Auto-collapse/expand immediately rather than waiting for the next full
        // renderDiffPane() — fileCardHtml's own `open` computation (derived from
        // this same viewed flag) keeps it consistent across any later re-render.
        const card = cb.closest('.rv-file-card') as HTMLDetailsElement | null
        if (card) card.open = !cb.checked
        renderMetaStrip()
        renderNav()
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-file-comment-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation()
        const card = btn.closest('.rv-file-card') as HTMLElement
        const formRow = card.querySelector<HTMLElement>('.rv-comment-form-row[data-scope="file"]')
        if (!formRow) return
        const wasHidden = formRow.classList.contains('hidden')
        formRow.classList.toggle('hidden')
        if (wasHidden) {
          delete formRow.dataset.editIdx
          const ta = formRow.querySelector('textarea') as HTMLTextAreaElement
          ta.value = ''
          ta.focus()
        }
      })
    })

    pane.querySelectorAll<HTMLElement>('td.marker').forEach((cell) => {
      cell.addEventListener('click', (e) => {
        e.stopPropagation()
        const row = cell.closest('tr') as HTMLElement
        const path = row.dataset.path as string
        const side = row.dataset.side as 'old' | 'new'
        const line = Number(row.dataset.line)
        const formRow = pane.querySelector<HTMLElement>(
          `.rv-comment-form-row[data-path="${cssAttrEscape(path)}"][data-side="${side}"][data-line="${line}"]`,
        )
        if (!formRow) return
        const wasHidden = formRow.classList.contains('hidden')
        formRow.classList.toggle('hidden')
        if (wasHidden) {
          delete formRow.dataset.editIdx
          const ta = formRow.querySelector('textarea') as HTMLTextAreaElement
          ta.value = ''
          ta.focus()
        }
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-comment-cancel').forEach((btn) => {
      btn.addEventListener('click', () => {
        const formRow = btn.closest('.rv-comment-form-row') as HTMLElement
        delete formRow.dataset.editIdx
        delete formRow.dataset.rangeStart
        formRow.classList.add('hidden')
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-comment-add').forEach((btn) => {
      btn.addEventListener('click', () => {
        const formRow = btn.closest('.rv-comment-form-row') as HTMLElement
        const path = formRow.dataset.path as string
        const textarea = formRow.querySelector('textarea') as HTMLTextAreaElement
        const body = textarea.value.trim()
        if (!body) return
        if (formRow.dataset.scope === 'file') {
          if (formRow.dataset.editIdx !== undefined) {
            editFileComment(path, Number(formRow.dataset.editIdx), body)
          } else {
            addFileComment(path, body)
          }
        } else {
          const side = formRow.dataset.side as 'old' | 'new'
          const line = Number(formRow.dataset.line)
          const startLine = formRow.dataset.rangeStart ? Number(formRow.dataset.rangeStart) : undefined
          if (formRow.dataset.editIdx !== undefined) {
            editComment(path, side, line, Number(formRow.dataset.editIdx), body)
          } else {
            addComment(path, side, line, body, startLine)
          }
        }
        delete formRow.dataset.editIdx
        delete formRow.dataset.rangeStart
        renderMetaStrip()
        renderDiffPane()
      })
    })

    pane.querySelectorAll<HTMLTextAreaElement>('.rv-comment-textarea').forEach((ta) => {
      bindCommentTextareaKeys(ta, () => {
        ta.closest('.rv-comment-form-row')?.querySelector<HTMLElement>('.rv-comment-add')?.click()
      }, () => {
        ta.closest('.rv-comment-form-row')?.querySelector<HTMLElement>('.rv-comment-cancel')?.click()
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-comment-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.rv-comment') as HTMLElement
        const path = row.dataset.path as string
        const idx = Number(row.dataset.idx)
        const isFile = row.dataset.scope === 'file'
        let formRow: HTMLElement | null
        let body: string
        if (isFile) {
          body = fileCommentsFor(path)[idx]?.body ?? ''
          formRow = pane.querySelector<HTMLElement>(`.rv-comment-form-row[data-scope="file"][data-path="${cssAttrEscape(path)}"]`)
        } else {
          const side = row.dataset.side as 'old' | 'new'
          const line = Number(row.dataset.line)
          body = commentsFor(path, side, line)[idx]?.body ?? ''
          formRow = pane.querySelector<HTMLElement>(
            `.rv-comment-form-row[data-path="${cssAttrEscape(path)}"][data-side="${side}"][data-line="${line}"]`,
          )
        }
        if (!formRow) return
        formRow.classList.remove('hidden')
        formRow.dataset.editIdx = String(idx)
        const ta = formRow.querySelector('textarea') as HTMLTextAreaElement
        ta.value = body
        ta.focus()
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-comment-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.rv-comment') as HTMLElement
        const path = row.dataset.path as string
        const idx = Number(row.dataset.idx)
        if (row.dataset.scope === 'file') {
          removeFileComment(path, idx)
        } else {
          const side = row.dataset.side as 'old' | 'new'
          const line = Number(row.dataset.line)
          removeComment(path, side, line, idx)
        }
        renderMetaStrip()
        renderDiffPane()
      })
    })

    pane.querySelectorAll<HTMLElement>('.rv-view-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view as 'diff' | 'code' | 'rendered'
        const card = btn.closest('.rv-file-card') as HTMLElement
        card.querySelectorAll('.rv-view-toggle-btn').forEach((b) => b.classList.toggle('active', b === btn))
        card.querySelector('.rv-view-diff')?.classList.toggle('hidden', view !== 'diff')
        card.querySelector('.rv-view-code')?.classList.toggle('hidden', view !== 'code')
        card.querySelector('.rv-view-rendered')?.classList.toggle('hidden', view !== 'rendered')
      })
    })

    // GitHub-style click-to-highlight: click a line-number cell to spotlight that row
    // (single row at a time); click it again to clear. Shift-click a second line in the
    // same file/side to extend the anchor into a range, highlight the whole block, and
    // open a comment covering it. Scoped to td.ln so it never fights with the
    // drag-based select-to-comment popover on the code cell.
    pane.querySelectorAll<HTMLElement>('td.ln').forEach((cell) => {
      cell.addEventListener('click', (e) => {
        const row = cell.closest<HTMLElement>('tr[data-path]')
        if (!row) return
        const path = row.dataset.path as string
        const side = row.dataset.side as 'old' | 'new'
        const line = Number(row.dataset.line)

        if (e.shiftKey && rangeAnchor && rangeAnchor.path === path && rangeAnchor.side === side) {
          const [start, end] = computeLineRange(rangeAnchor.line, line)
          highlightLineRange(pane, path, side, start, end)
          openRangeCommentForm(pane, path, side, start, end)
          return
        }

        rangeAnchor = { path, side, line }
        const wasHighlighted = row.classList.contains('rv-line-highlighted')
        pane.querySelectorAll('.rv-line-highlighted').forEach((r) => r.classList.remove('rv-line-highlighted'))
        if (!wasHighlighted) row.classList.add('rv-line-highlighted')
      })
    })
  }

  // Anchor for shift-click range selection — deliberately module state rather than
  // `state.*` since it's transient UI-only and never needs to survive a re-render or
  // be serialized into the submitted review.
  let rangeAnchor: { path: string; side: 'old' | 'new'; line: number } | null = null

  function highlightLineRange(pane: HTMLElement, path: string, side: 'old' | 'new', start: number, end: number): void {
    pane.querySelectorAll('.rv-line-highlighted').forEach((r) => r.classList.remove('rv-line-highlighted'))
    pane.querySelectorAll<HTMLElement>(`tr[data-path="${cssAttrEscape(path)}"][data-side="${side}"]`).forEach((row) => {
      const line = Number(row.dataset.line)
      if (line >= start && line <= end) row.classList.add('rv-line-highlighted')
    })
  }

  // Opens the already-rendered per-line comment form belonging to the range's end
  // line — ranges are decided at click-time in the browser, so pre-rendering a form
  // for every possible start/end combination isn't feasible; reusing the single-line
  // form (tagged with rangeStart) keeps this a small addition instead of a new
  // dynamic-DOM code path.
  function openRangeCommentForm(pane: HTMLElement, path: string, side: 'old' | 'new', start: number, end: number): void {
    const formRow = pane.querySelector<HTMLElement>(
      `.rv-comment-form-row[data-path="${cssAttrEscape(path)}"][data-side="${side}"][data-line="${end}"]`,
    )
    if (!formRow) return
    delete formRow.dataset.editIdx
    if (start !== end) formRow.dataset.rangeStart = String(start)
    else delete formRow.dataset.rangeStart
    formRow.classList.remove('hidden')
    const ta = formRow.querySelector('textarea') as HTMLTextAreaElement
    ta.value = ''
    ta.focus()
  }

  /** Cmd/Ctrl+Enter submits, Esc cancels — shared by per-line comment forms and the modal summary box. */
  function bindCommentTextareaKeys(ta: HTMLTextAreaElement, onSubmit: () => void, onCancel: () => void): void {
    ta.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault()
        onSubmit()
      } else if (e.key === 'Escape') {
        e.preventDefault()
        onCancel()
      }
    })
  }

  // ── "#agent" mention autocomplete ──────────────────────────────────────────
  // Comment textareas are recreated on every renderDiffPane() call, so listeners
  // are delegated on document rather than bound per-element (which would need
  // rebinding after each re-render). One shared dropdown is reused/repositioned
  // under whichever textarea is active — caret-level anchoring inside a textarea
  // needs a mirror-div hack, which is overkill for a "just under the box" popup.
  const MENTION_SELECTOR = '.rv-comment-textarea, .rv-file-comment-textarea, #rvSummary'

  const mention = {
    el: null as HTMLElement | null,
    target: null as HTMLTextAreaElement | null,
    hashStart: -1,
    items: [] as SubagentInfo[],
    highlighted: 0,
  }

  function getMentionDropdown(): HTMLElement {
    if (mention.el) return mention.el
    const el = document.createElement('div')
    el.className = 'rv-mention-dropdown hidden'
    // Prevent the textarea from blurring before a click on an item registers.
    el.addEventListener('mousedown', (e) => e.preventDefault())
    el.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('.rv-mention-item')
      if (item) selectMention(item.dataset.name ?? '')
    })
    const host = document.getElementById('review-app') ?? document.body
    host.appendChild(el)
    mention.el = el
    return el
  }

  function closeMention(): void {
    mention.el?.classList.add('hidden')
    mention.target = null
    mention.hashStart = -1
  }

  function renderMentionItems(): void {
    const el = getMentionDropdown()
    el.innerHTML = mention.items
      .map(
        (a, i) => `<div class="rv-mention-item${i === mention.highlighted ? ' highlighted' : ''}" data-name="${escapeHtml(a.name)}">
          <span class="rv-mention-name">#${escapeHtml(a.name)}</span>
          <span class="rv-mention-desc">${escapeHtml(a.description)}</span>
        </div>`,
      )
      .join('')
  }

  function positionMentionDropdown(ta: HTMLTextAreaElement): void {
    const el = getMentionDropdown()
    const rect = ta.getBoundingClientRect()
    el.style.left = `${rect.left}px`
    el.style.top = `${rect.bottom + 4}px`
    el.style.width = `${Math.min(320, rect.width)}px`
  }

  // Scans left from the cursor for a run of non-space chars; a leading "#" in that
  // run is the mention trigger. Returns -1 if the run doesn't start with "#".
  function findMentionStart(value: string, cursor: number): number {
    let i = cursor
    while (i > 0 && !/\s/.test(value[i - 1])) i--
    return value[i] === '#' ? i : -1
  }

  function handleMentionInput(ta: HTMLTextAreaElement): void {
    const cursor = ta.selectionStart ?? 0
    const start = findMentionStart(ta.value, cursor)
    if (start === -1) { closeMention(); return }
    const filterText = ta.value.slice(start + 1, cursor).toLowerCase()
    const items = SUBAGENTS.filter((a) => a.name.toLowerCase().startsWith(filterText))
    if (items.length === 0) { closeMention(); return }
    mention.target = ta
    mention.hashStart = start
    mention.items = items
    mention.highlighted = 0
    positionMentionDropdown(ta)
    renderMentionItems()
    getMentionDropdown().classList.remove('hidden')
  }

  function selectMention(name: string): void {
    const ta = mention.target
    if (!ta || mention.hashStart === -1) return
    const cursor = ta.selectionStart ?? mention.hashStart
    const before = ta.value.slice(0, mention.hashStart)
    const after = ta.value.slice(cursor)
    const inserted = `#${name} `
    ta.value = before + inserted + after
    const caret = before.length + inserted.length
    ta.setSelectionRange(caret, caret)
    ta.focus()
    closeMention()
  }

  document.addEventListener('input', (e) => {
    const ta = e.target as HTMLElement
    if (!(ta instanceof HTMLTextAreaElement) || !ta.matches(MENTION_SELECTOR)) return
    handleMentionInput(ta)
  })

  document.addEventListener('keydown', (e) => {
    if (!mention.target || e.target !== mention.target) return
    if (e.key === 'ArrowDown') {
      e.preventDefault()
      mention.highlighted = (mention.highlighted + 1) % mention.items.length
      renderMentionItems()
    } else if (e.key === 'ArrowUp') {
      e.preventDefault()
      mention.highlighted = (mention.highlighted - 1 + mention.items.length) % mention.items.length
      renderMentionItems()
    } else if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault()
      selectMention(mention.items[mention.highlighted]?.name ?? '')
    } else if (e.key === 'Escape') {
      e.preventDefault()
      closeMention()
    }
  })

  document.addEventListener('blur', (e) => {
    if ((e.target as HTMLElement) === mention.target) closeMention()
  }, true)

  // Belt-and-suspenders click-away: covers clicks on non-focusable elements, where
  // blur wouldn't otherwise fire on the textarea.
  document.addEventListener('mousedown', (e) => {
    if (!mention.target) return
    const target = e.target as Node
    if (target !== mention.target && !mention.el?.contains(target)) closeMention()
  })

  function openLineCommentForm(path: string, side: 'old' | 'new', line: number, prefillBody: string): void {
    const pane = document.getElementById('rvDiffPane')
    const formRow = pane?.querySelector<HTMLElement>(
      `.rv-comment-form-row[data-path="${cssAttrEscape(path)}"][data-side="${side}"][data-line="${line}"]`,
    )
    if (!formRow) return
    formRow.classList.remove('hidden')
    delete formRow.dataset.editIdx
    const ta = formRow.querySelector('textarea') as HTMLTextAreaElement
    ta.value = prefillBody
    ta.focus()
    ta.setSelectionRange(ta.value.length, ta.value.length)
  }

  // ── Select-to-comment: highlight a run of diff text, click the popover, and it
  // opens that row's existing comment form prefilled with the selection as a quote. ──
  let selectionPopoverEl: HTMLElement | null = null

  function getSelectionPopover(): HTMLElement {
    if (selectionPopoverEl) return selectionPopoverEl
    const el = document.createElement('div')
    el.className = 'rv-selection-popover hidden'
    el.innerHTML = `<div class="rv-selection-popover-title"></div><button type="button" class="rv-selection-popover-btn">+ Add comment</button>`
    // Prevent mousedown from clearing the active text selection before the click
    // registers — same reason getMentionDropdown() does this for textarea focus.
    // Without it: mousedown clears selection → mouseup sees empty selection →
    // hideSelectionPopover() makes the button display:none → click hits the element
    // behind the popover instead of the button → openLineCommentForm never called.
    el.addEventListener('mousedown', (e) => e.preventDefault())
    el.querySelector('button')?.addEventListener('click', () => {
      const { path, side, line, text } = el.dataset
      hideSelectionPopover()
      if (!path || !side || !line) return
      const quotedBody = text ? text.split('\n').map((l) => `> ${l}`).join('\n') + '\n\n' : ''
      openLineCommentForm(path, side as 'old' | 'new', Number(line), quotedBody)
    })
    // Appended inside #review-app (not document.body) so it inherits the --rv-* custom
    // properties scoped there; position:fixed still places it relative to the viewport.
    const host = document.getElementById('review-app') ?? document.body
    host.appendChild(el)
    selectionPopoverEl = el
    return el
  }

  function basename(path: string): string {
    return path.slice(path.lastIndexOf('/') + 1)
  }

  function showSelectionPopover(rect: DOMRect, tr: HTMLElement, text: string): void {
    const el = getSelectionPopover()
    const path = tr.dataset.path ?? ''
    const line = tr.dataset.line ?? ''
    el.dataset.path = path
    el.dataset.side = tr.dataset.side
    el.dataset.line = line
    el.dataset.text = text.trim()
    const titleEl = el.querySelector<HTMLElement>('.rv-selection-popover-title')
    if (titleEl) titleEl.textContent = `${basename(path)}:${line}`
    // rect is already viewport-relative (getBoundingClientRect) and el is position:fixed
    // (also viewport-relative) — do not add window.scrollY, or the popover lands far
    // below the selection (often off-screen) on any page that's been scrolled.
    // Anchored to the start of the selection (GitHub anchors its comment affordance to
    // where the drag began), not centered over the full — possibly multi-line — range.
    el.style.left = `${rect.left}px`
    el.style.top = `${rect.top - 8}px`
    el.classList.remove('hidden')
  }

  function hideSelectionPopover(): void {
    selectionPopoverEl?.classList.add('hidden')
  }

  document.addEventListener('mouseup', () => {
    const sel = window.getSelection()
    const text = sel?.toString() ?? ''
    if (!sel || sel.rangeCount === 0 || sel.isCollapsed || !text.trim()) { hideSelectionPopover(); return }
    const anchorNode = sel.anchorNode
    const anchorEl = anchorNode instanceof Element ? anchorNode : anchorNode?.parentElement
    const tr = anchorEl?.closest<HTMLElement>('tr[data-path]')
    if (!tr) { hideSelectionPopover(); return }
    const range = sel.getRangeAt(0)
    // First client rect = the start of the selection, even when the drag spans multiple
    // visual lines — matches where the user began highlighting rather than the midpoint
    // of the whole (possibly tall, multi-line) bounding box.
    const rects = range.getClientRects()
    const rect = rects[0] ?? range.getBoundingClientRect()
    showSelectionPopover(rect, tr, text)
  })
  document.addEventListener('mousedown', (e) => {
    if (selectionPopoverEl && !selectionPopoverEl.classList.contains('hidden') && !selectionPopoverEl.contains(e.target as Node)) {
      hideSelectionPopover()
    }
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideSelectionPopover()
  })

  function cssAttrEscape(s: string): string {
    return s.replace(/"/g, '\\"')
  }

  function setMode(mode: 'commit' | 'file' | 'slice' | 'demo'): void {
    state.mode = mode
    document.querySelectorAll('.rv-tab-btn').forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.mode === mode))
    // The nav lists files; leaving it interactive in demo mode would scroll a pane with no cards.
    document.getElementById('review-app')?.classList.toggle('rv-demo-mode', mode === 'demo')
    renderDiffPane()
    // Leaving slice mode has to widen the tree back to the full range.
    renderNav()
  }
  document.querySelectorAll('.rv-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => setMode((btn as HTMLElement).dataset.mode as 'commit' | 'file' | 'slice' | 'demo'))
  })

  // Resizable nav (ported from proto-A).
  ;(function initResizer() {
    const resizer = document.getElementById('rvNavResizer')
    const nav = document.getElementById('rvNav')
    if (!resizer || !nav) return
    let dragging = false
    resizer.addEventListener('mousedown', () => { dragging = true; document.body.style.userSelect = 'none' })
    window.addEventListener('mousemove', (e) => {
      if (!dragging) return
      const min = 220, max = 420
      const w = Math.min(max, Math.max(min, e.clientX))
      nav.style.width = `${w}px`
    })
    window.addEventListener('mouseup', () => { dragging = false; document.body.style.userSelect = '' })
  })()

  // ── Verdict modal + submit-review round-trip ──────────────────────────────

  const overlay = document.getElementById('rvVerdictOverlay')
  // Submit button's neon glow tracks the selected verdict via this data attribute (see <style>).
  function syncVerdictAccent(): void {
    const checked = document.querySelector<HTMLInputElement>('input[name="rv-verdict"]:checked')
    overlay?.setAttribute('data-verdict', checked?.value ?? 'comment')
  }
  document.querySelectorAll<HTMLInputElement>('input[name="rv-verdict"]').forEach((radio) => {
    radio.addEventListener('change', syncVerdictAccent)
  })
  function openVerdict(verdict: 'approve' | 'request_changes'): void {
    const radio = document.querySelector<HTMLInputElement>(`input[name="rv-verdict"][value="${verdict}"]`)
    if (radio) radio.checked = true
    syncVerdictAccent()
    overlay?.classList.remove('hidden')
  }
  document.getElementById('rvApprove')?.addEventListener('click', () => openVerdict('approve'))
  document.getElementById('rvReject')?.addEventListener('click', () => openVerdict('request_changes'))
  document.getElementById('rvCloseVerdict')?.addEventListener('click', () => overlay?.classList.add('hidden'))
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.add('hidden') })
  syncVerdictAccent()

  function buildLineCommentsPayload(): LineComment[] {
    return [...state.lineComments.values()].flat()
  }
  function buildFileApprovalsPayload(): FileApproval[] {
    return [...state.fileApprovals.values()]
  }

  async function submitReview(): Promise<void> {
    const statusEl = document.getElementById('rvVerdictStatus')
    const submitBtn = document.getElementById('rvSubmitReview') as HTMLButtonElement | null
    const verdictInput = document.querySelector<HTMLInputElement>('input[name="rv-verdict"]:checked')
    const summaryEl = document.getElementById('rvSummary') as HTMLTextAreaElement | null
    const verdict = verdictInput?.value ?? 'comment'
    const summary = summaryEl?.value.trim() ?? ''

    const reviewResult = {
      verdict,
      summary,
      fileApprovals: buildFileApprovalsPayload(),
      lineComments: buildLineCommentsPayload(),
    }

    const { nonce } = readVizMeta()
    const slug = DATA.slug
    const answers = [{ type: 'review_submit', index: 0, answer: JSON.stringify(reviewResult) }]

    if (submitBtn) submitBtn.disabled = true
    if (statusEl) statusEl.textContent = 'Submitting…'

    try {
      const hmac = await signAnswers(slug, answers)
      const res = await respond(slug, nonce, hmac, answers)
      if (!res.ok) throw new Error(`${res.status}`)
      overlay?.classList.add('hidden')
      // The respond call bumps payload.json's mtime; suppress the next poll tick so the
      // self-caused rev change doesn't trigger a location.reload() that wipes what we're about to show.
      ;(window as unknown as { __vizSuppressNextRefresh?: boolean }).__vizSuppressNextRefresh = true
      if (verdict === 'request_changes') {
        enterReworkingState()
      } else {
        setVerdictResult(verdict === 'approve' ? 'approved' : 'commented')
        if (verdict === 'approve') celebrateApprove()
        setDoneFavicon()
      }
    } catch (err) {
      approveCelebrated = false
      if (statusEl) statusEl.textContent = 'Error submitting — check console'
      if (submitBtn) submitBtn.disabled = false
      console.error('[viz] review submit failed', err)
    }
  }

  /**
   * Fires on the submit button's mousedown so the burst lands with the press rather than
   * after two awaited fetches; the flag keeps the keyboard path (Cmd+Enter in the summary
   * box, which has no mousedown) to exactly one burst per submit.
   */
  let approveCelebrated = false
  function celebrateApprove(): void {
    if (approveCelebrated) return
    approveCelebrated = true
    burstConfetti()
  }

  /**
   * The settled verdict renders in the tab bar where the verdict buttons were — CSS swaps
   * the buttons for the matching pill off this attribute, so the board underneath stays
   * readable and scrollable instead of sitting behind a full-screen overlay.
   */
  function setVerdictResult(state: 'none' | 'approved' | 'commented' | 'reworking'): void {
    const slot = document.getElementById('rvVerdictSlot')
    if (!slot) return
    const label = document.getElementById('rvResultLabel')
    if (label && (state === 'approved' || state === 'commented')) {
      label.textContent = state === 'approved' ? 'Approved' : 'Comment submitted'
    }
    slot.dataset.result = state
  }

  function startElapsed(): void {
    const el = document.getElementById('rvResultElapsed')
    if (!el) return
    const started = Date.now()
    const paint = (): void => {
      const secs = Math.floor((Date.now() - started) / 1000)
      el.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`
    }
    paint()
    window.setInterval(paint, 1000)
  }

  /**
   * request_changes swaps the verdict buttons for the reworking pill (so it can't be
   * resubmitted) and starts a lightweight standalone poll against the same /api/status
   * endpoint Base.astro's page-level poller uses. This board's JS binds once at load, so
   * an in-place region swap on rev-change would leave it non-interactive — a full reload
   * is the simplest correct way back to a live, freshly-bound board once the revision lands.
   */
  function enterReworkingState(): void {
    setVerdictResult('reworking')
    startElapsed()
    setFavicon('reworking')
    ;(window as unknown as { __vizReviewReworking?: boolean }).__vizReviewReworking = true
    startReworkPoll(DATA.slug)
  }

  /**
   * Review boards pass hideWaiting to Base.astro (no Activity rail), which leaves
   * Base's own favicon logic permanently idle — it never sees a reason to show
   * "waiting". Reuse the same amber-dot convention here instead, driven by this
   * board's own verdict lifecycle: amber while awaiting a decision, the reworking
   * spinner for request_changes, and the shared done-checkmark (setDoneFavicon,
   * imported from ../lib/doneOverlay.ts) once approve/comment settles.
   */
  const FAVICON_REWORKING =
    'data:image/svg+xml,' +
    encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><text x="16" y="24" font-size="26" text-anchor="middle">🔄</text></svg>',
    )

  function setFavicon(kind: 'waiting' | 'reworking'): void {
    setFaviconHref(kind === 'waiting' ? FAVICON_WAITING : FAVICON_REWORKING)
  }

  function startReworkPoll(slug: string): void {
    let baseline: number | null = null
    let intervalId = 0
    const tick = async (): Promise<void> => {
      try {
        const res = await fetch(`/api/status?slug=${encodeURIComponent(slug)}`, { cache: 'no-store' })
        if (!res.ok) return
        const { rev } = (await res.json()) as { rev: number }
        if (baseline === null) { baseline = rev; return }
        if (rev !== baseline) { window.clearInterval(intervalId); location.reload() }
      } catch {
        // server momentarily unreachable — try again next tick
      }
    }
    intervalId = window.setInterval(() => { void tick() }, 2500)
    void tick()
  }

  document.getElementById('rvSubmitReview')?.addEventListener('click', () => { void submitReview() })
  document.getElementById('rvSubmitReview')?.addEventListener('mousedown', () => {
    const chosen = document.querySelector<HTMLInputElement>('input[name="rv-verdict"]:checked')
    if (chosen?.value === 'approve') celebrateApprove()
  })
  document.getElementById('rvResultDismiss')?.addEventListener('click', () => setVerdictResult('none'))

  const summaryTextarea = document.getElementById('rvSummary') as HTMLTextAreaElement | null
  if (summaryTextarea) {
    bindCommentTextareaKeys(
      summaryTextarea,
      () => document.getElementById('rvSubmitReview')?.click(),
      () => overlay?.classList.add('hidden'),
    )
  }

  // Pre-fill from dg-skills viz review --comments, if any — same state.lineComments the
  // reviewer's own clicks would populate, so edit/delete on a seeded item just works.
  for (const c of DATA.review.seedComments ?? []) {
    if (c.lineNumber == null) addFileComment(c.file, c.body)
    else addComment(c.file, c.side ?? 'new', c.lineNumber, c.body, c.startLineNumber)
  }

  renderMetaStrip()
  renderNav()
  renderDiffPane()
  // Server may have rendered the settled pill (see the frontmatter's resultState) if this
  // load is actually a post-submit reload landing back on a decided board — match the
  // favicon to whichever state actually painted.
  if (document.getElementById('rvVerdictSlot')?.dataset.result !== 'none') {
    setDoneFavicon()
  } else {
    setFavicon('waiting')
  }
</script>

<style is:global>
  /* ── Demo tab ─────────────────────────────────────────────────────────── */
  .rv-tab-demo { color: var(--rv-accent); }
  /* The nav lists files, which the demo pane has none of — collapse it for the full width. */
  #review-app.rv-demo-mode .rv-nav,
  #review-app.rv-demo-mode .rv-nav-resizer { display: none; }
  .rv-demo-pane { padding: 18px 22px 26px; }
  .rv-demo-pane .rv-demo-caption {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--rv-text-muted);
  }
  .rv-demo-pane .rv-demo-videowrap {
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    max-width: 1100px;
  }
  .rv-demo-pane .rv-demo-video { display: block; width: 100%; max-height: 72vh; }
  .rv-demo-pane .rv-demo-shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .rv-demo-pane .rv-demo-shot { margin: 0; }
  .rv-demo-pane .rv-demo-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rv-border);
    border-radius: 6px;
  }
  .rv-demo-pane .rv-demo-shot figcaption {
    margin-top: 5px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rv-text-dim);
  }
  .rv-demo-empty { padding: 24px; color: var(--rv-text-dim); font-style: italic; }

  /* ── By spec slice: one collapsible row per slice ──────────────────────── */
  .rv-slice-list { padding: 14px 18px 26px; display: flex; flex-direction: column; gap: 10px; }
  /* Sticks to .rv-diff-pane, the scroll container. Opaque background on purpose — slice rows
     scroll underneath it, and a translucent bar would render the two on top of each other. */
  .rv-slice-jump {
    position: sticky;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 14px;
    border: 1px solid var(--rv-border);
    border-radius: 8px;
    background: var(--rv-panel-alt);
    color: var(--rv-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    flex-shrink: 0;
  }
  .rv-slice-jump:hover { border-color: var(--rv-accent); }
  .rv-slice-jump-prev { top: 0; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18); }
  .rv-slice-jump-next { bottom: 0; box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.18); }
  .rv-slice-jump-dir {
    font-size: 10.5px;
    color: var(--rv-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .rv-slice-jump-name { font-weight: 600; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rv-slice-jump-meta { margin-left: auto; font-family: var(--rv-mono); font-size: 11.5px; color: var(--rv-text-dim); white-space: nowrap; }
  .rv-slice {
    border: 1px solid var(--rv-border);
    border-radius: 8px;
    background: var(--rv-panel);
    overflow: hidden;
  }
  .rv-slice[open] { border-color: var(--rv-accent); }
  .rv-slice.is-empty { opacity: 0.62; }
  .rv-slice-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .rv-slice-summary::-webkit-details-marker { display: none; }
  .rv-slice-summary:hover { background: rgba(255, 255, 255, 0.03); }
  .rv-slice-caret {
    color: var(--rv-text-dim);
    font-size: 11px;
    transition: transform 0.12s ease;
  }
  .rv-slice[open] .rv-slice-caret { transform: rotate(90deg); }
  .rv-slice-heading { font-weight: 600; font-size: 13.5px; color: var(--rv-text); }
  .rv-slice-meta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--rv-mono);
    font-size: 11.5px;
  }
  .rv-slice-count { color: var(--rv-text-dim); }
  .rv-slice-empty { color: var(--rv-text-dim); font-style: italic; }
  .rv-slice-desc {
    margin: 0;
    padding: 0 14px 12px 34px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--rv-text-muted);
  }
  .rv-slice-files { padding: 0 10px 10px; }
  .rv-slice-emptybody {
    padding: 0 14px 14px 34px;
    font-size: 12.5px;
    color: var(--rv-text-dim);
    font-style: italic;
  }

  #review-app {
    --rv-bg: var(--color-ground);
    --rv-panel: var(--color-panel);
    --rv-panel-alt: var(--color-panel-2);
    --rv-border: var(--color-rule);
    --rv-border-muted: var(--color-rule-soft);
    --rv-text: var(--color-ink);
    --rv-text-muted: var(--color-ink-2);
    --rv-text-dim: var(--color-mid);
    --rv-accent: var(--color-accent);
    --rv-accent-dim: var(--color-accent);
    --rv-signal: var(--color-signal);
    --rv-add-bg: rgba(46, 160, 67, 0.15);
    --rv-add-bg-strong: rgba(46, 160, 67, 0.3);
    --rv-add-text: #1a7f37;
    --rv-del-bg: rgba(248, 81, 73, 0.12);
    --rv-del-bg-strong: rgba(248, 81, 73, 0.25);
    --rv-del-text: #cf222e;
    --rv-hunk-bg: var(--color-panel-2);
    --rv-hunk-text: var(--color-mid);
    --rv-add-code-text: var(--rv-text);
    --rv-del-code-text: var(--rv-text);
    --rv-mono: var(--font-mono);
    --rv-sans: var(--font-display);

    display: flex;
    flex-direction: column;
    position: relative;
    height: calc(100vh - 9rem);
    min-height: 480px;
    width: 100%;
    background: var(--rv-bg);
    color: var(--rv-text);
    font-family: var(--rv-sans);
    font-size: 13px;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  #review-app * { box-sizing: border-box; }

  /* Dark mode shares the app's own dark palette — diff green/red stay a calm GitHub-dark
     pair rather than the app's teal accent, so additions/deletions still read at a glance. */
  html.dark #review-app {
    --rv-bg: var(--color-ground);
    --rv-panel: var(--color-panel);
    --rv-panel-alt: var(--color-panel-2);
    --rv-border: var(--color-rule);
    --rv-border-muted: var(--color-rule-soft);
    --rv-text: var(--color-ink);
    --rv-text-muted: var(--color-ink-2);
    --rv-text-dim: var(--color-mid);
    --rv-accent: var(--color-accent);
    --rv-accent-dim: var(--color-accent);
    --rv-signal: var(--color-signal);
    --rv-add-bg: rgba(63, 185, 80, 0.12);
    --rv-add-bg-strong: rgba(63, 185, 80, 0.24);
    --rv-add-text: #3fb950;
    --rv-del-bg: rgba(248, 81, 73, 0.12);
    --rv-del-bg-strong: rgba(248, 81, 73, 0.24);
    --rv-del-text: #f85149;
    --rv-hunk-bg: var(--color-panel-2);
    --rv-hunk-text: var(--color-mid);
    --rv-add-code-text: var(--rv-text);
    --rv-del-code-text: var(--rv-text);
  }

  @media (max-width: 700px) {
    .rv-main { flex-direction: column; }
    .rv-nav { width: 100% !important; max-width: none; max-height: 240px; border-right: none; border-bottom: 1px solid var(--rv-border); }
    .rv-nav-resizer { display: none; }
  }

  .rv-banner {
    background: linear-gradient(90deg, var(--rv-panel), var(--rv-panel-alt));
    border-bottom: 1px solid var(--rv-border);
    padding: 10px 16px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-shrink: 0;
  }
  .rv-tag {
    background: var(--rv-accent-dim);
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    padding: 2px 8px;
    border-radius: 3px;
  }
  .rv-title { font-family: var(--rv-sans); font-weight: 600; font-size: 14px; }
  .rv-desc { color: var(--rv-text-muted); font-size: 12px; }

  .rv-meta-strip {
    background: var(--rv-panel);
    border-bottom: 1px solid var(--rv-border);
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--rv-text-muted);
  }
  .rv-range {
    font-family: var(--rv-mono);
    color: var(--rv-text);
    background: var(--rv-panel-alt);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--rv-border-muted);
  }
  .rv-stat strong { color: var(--rv-text); }
  .rv-meta-strip .a { color: var(--rv-add-text); font-weight: 600; }
  .rv-meta-strip .d { color: var(--rv-del-text); font-weight: 600; }

  .rv-tabs {
    background: var(--rv-panel);
    border-bottom: 1px solid var(--rv-border);
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 7px 20px;
    flex-shrink: 0;
  }
  .rv-tabs-spacer { flex: 1; }
  .rv-tab-btn {
    background: transparent;
    border: none;
    color: var(--rv-text-muted);
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--rv-sans);
    position: relative;
  }
  .rv-tab-btn:hover { color: var(--rv-text); background: rgba(255, 255, 255, 0.03); }
  .rv-tab-btn.active { color: var(--rv-text); }
  /* Anchored to the bar's own bottom edge (padding-bottom below), not the button box, so the
     underline stays flush with .rv-tabs' border-bottom regardless of the bar's vertical padding. */
  .rv-tab-btn.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 2px;
    background: var(--rv-accent);
  }
  html.dark .rv-tab-btn.active { color: var(--rv-accent); }

  /* Neon verdict controls — flat tinted fill, single restrained glow ring. No idle animation. */
  .rv-verdict-approve-btn,
  .rv-verdict-reject-btn {
    border: 1px solid transparent;
    color: #fff;
    font-weight: 700;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    margin: 6px 0 6px 8px;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
  }
  .rv-verdict-approve-btn {
    background: #227d38;
    box-shadow: 0 0 0 1px rgba(57, 211, 83, 0.6), 0 0 8px 1px rgba(57, 211, 83, 0.35);
  }
  .rv-verdict-approve-btn:hover,
  .rv-verdict-approve-btn:focus-visible {
    background: #1b6a2e;
    transform: translateY(-1px);
    box-shadow: 0 0 0 1px rgba(57, 211, 83, 0.85), 0 0 12px 2px rgba(57, 211, 83, 0.55);
  }
  .rv-verdict-reject-btn {
    background: #c93454;
    box-shadow: 0 0 0 1px rgba(255, 45, 85, 0.6), 0 0 8px 1px rgba(255, 45, 85, 0.35);
  }
  .rv-verdict-reject-btn:hover,
  .rv-verdict-reject-btn:focus-visible {
    background: #ad2b46;
    transform: translateY(-1px);
    box-shadow: 0 0 0 1px rgba(255, 45, 85, 0.85), 0 0 12px 2px rgba(255, 45, 85, 0.55);
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-verdict-approve-btn, .rv-verdict-reject-btn, .rv-submit-btn { transition: none; }
  }
  .rv-verdict-approve-btn:disabled,
  .rv-verdict-reject-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Settled verdict, rendered in the verdict buttons' own slot. Nothing here is fixed or
     absolute: the board stays fully readable and scrollable behind a decided review. */
  .rv-verdict-slot { display: flex; align-items: center; }
  .rv-verdict-slot[data-result='none'] .rv-result { display: none; }
  .rv-verdict-slot:not([data-result='none']) .rv-verdict-approve-btn,
  .rv-verdict-slot:not([data-result='none']) .rv-verdict-reject-btn { display: none; }
  .rv-verdict-slot[data-result='approved'] .rv-result-done,
  .rv-verdict-slot[data-result='commented'] .rv-result-done { display: inline-flex; }
  .rv-verdict-slot[data-result='reworking'] .rv-result-working { display: inline-flex; }

  /* display:none is the base state for BOTH pills — only the rule matching the slot's
     current data-result turns one back on, else the other stays visible beside it. */
  .rv-result {
    display: none;
    position: relative;
    overflow: hidden;
    align-items: center;
    gap: 8px;
    margin: 6px 0 6px 8px;
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-family: var(--rv-sans);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    animation: rv-result-in 0.18s ease-out both;
  }
  @keyframes rv-result-in {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Approve keeps the button's own green so the pill reads as the same control, settled. */
  .rv-verdict-slot[data-result='approved'] .rv-result-done {
    background: #227d38;
    color: #fff;
    animation: rv-result-in 0.18s ease-out both, rv-result-ring 1.1s ease-out 0.18s both;
  }
  @keyframes rv-result-ring {
    0% { box-shadow: 0 0 0 0 rgba(57, 211, 83, 0.5); }
    70% { box-shadow: 0 0 0 12px rgba(57, 211, 83, 0); }
    100% { box-shadow: 0 0 0 0 rgba(57, 211, 83, 0); }
  }
  /* Comment is not an approval — same shape, no green, no celebration ring. */
  .rv-verdict-slot[data-result='commented'] .rv-result-done {
    background: var(--rv-panel-alt);
    border-color: var(--rv-border);
    color: var(--rv-text);
  }
  .rv-result-check {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rv-result-check path {
    stroke-dasharray: 26;
    stroke-dashoffset: 26;
    animation: rv-result-draw 0.4s ease-out 0.16s forwards;
  }
  @keyframes rv-result-draw { to { stroke-dashoffset: 0; } }
  .rv-result-dismiss {
    background: none;
    border: 0;
    padding: 0 0 0 2px;
    color: inherit;
    opacity: 0.75;
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
  }
  .rv-result-dismiss:hover { opacity: 1; }

  .rv-result-working {
    background: var(--rv-panel-alt);
    border-color: var(--rv-border);
    color: var(--rv-text);
    font-weight: 600;
  }
  .rv-result-working::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 38%;
    background: var(--rv-signal);
    animation: rv-result-shimmer 1.5s ease-in-out infinite;
  }
  @keyframes rv-result-shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(320%); }
  }
  .rv-result-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--rv-signal);
    animation: rv-result-breathe 1.4s ease-in-out infinite;
  }
  @keyframes rv-result-breathe {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  .rv-result-elapsed {
    font-family: var(--rv-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--rv-text-dim);
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-result, .rv-result-dot, .rv-result-working::after { animation: none; }
    .rv-result-check path { stroke-dashoffset: 0; animation: none; }
  }

  .rv-main { flex: 1; display: flex; min-height: 0; width: 100%; }

  .rv-nav {
    width: 300px;
    min-width: 220px;
    max-width: 420px;
    background: var(--rv-panel);
    border-right: 1px solid var(--rv-border);
    overflow-y: auto;
    flex-shrink: 0;
    padding: 8px 0 40px;
  }
  .rv-nav-resizer { width: 4px; cursor: col-resize; background: transparent; flex-shrink: 0; }
  .rv-nav-resizer:hover { background: var(--rv-accent-dim); }

  /* Nested file tree — indentation comes from each folder body's own margin/border,
     so depth doesn't need to be threaded through as inline styles. */
  .rv-tree-folder-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 8px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--rv-text-dim);
    cursor: pointer;
    user-select: none;
  }
  .rv-tree-folder-header:hover { color: var(--rv-text); background: rgba(255, 255, 255, 0.04); }
  .rv-tree-folder.collapsed > .rv-tree-folder-header .rv-chevron { transform: rotate(-90deg); }
  .rv-tree-folder-name {
    font-family: var(--rv-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rv-tree-folder-header .rv-count { margin-left: auto; flex-shrink: 0; font-weight: 400; font-size: 10px; color: var(--rv-text-dim); }
  .rv-tree-folder-body {
    margin-left: 14px;
    padding-left: 7px;
    border-left: 1px solid var(--rv-border-muted);
  }
  .rv-tree-folder-body.collapsed { display: none; }

  .rv-nav-file {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px 5px 22px;
    font-family: var(--rv-mono);
    font-size: 12px;
    color: var(--rv-text-muted);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-left: 2px solid transparent;
  }
  .rv-nav-file:hover { background: rgba(255, 255, 255, 0.04); color: var(--rv-text); }
  .rv-nav-file.active { background: rgba(56, 139, 253, 0.1); color: var(--rv-text); border-left-color: var(--rv-accent); }
  .rv-nav-file-viewed { opacity: 0.55; }
  .rv-fname { overflow: hidden; text-overflow: ellipsis; }
  .rv-status-badge {
    flex-shrink: 0; width: 14px; height: 14px; border-radius: 3px; font-size: 9px; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center; font-family: var(--rv-sans);
  }
  .rv-status-badge-added { background: var(--rv-add-bg-strong); color: var(--rv-add-text); }
  .rv-status-badge-modified { background: rgba(210, 153, 34, 0.25); color: #d29922; }
  .rv-status-badge-deleted { background: var(--rv-del-bg-strong); color: var(--rv-del-text); }
  .rv-status-badge-renamed, .rv-status-badge-copied { background: rgba(88, 166, 255, 0.2); color: var(--rv-accent); }
  .rv-stat-mini { margin-left: auto; flex-shrink: 0; font-size: 10px; display: flex; gap: 4px; }
  .rv-stat-mini .a { color: var(--rv-add-text); }
  .rv-stat-mini .d { color: var(--rv-del-text); }

  .rv-diff-pane { flex: 1; overflow-y: auto; overflow-x: hidden; min-width: 0; padding: 14px 16px 60px; }

  .rv-section-header { padding: 14px 4px 8px; border-bottom: 1px solid var(--rv-border-muted); margin-bottom: 12px; }
  .rv-section-header h2 { margin: 0 0 4px; font-size: 15px; font-family: var(--rv-mono); color: var(--rv-text); }
  .rv-sha { color: #a371f7; }
  .rv-sub { color: var(--rv-text-muted); font-size: 12px; }
  .rv-sub .a { color: var(--rv-add-text); }
  .rv-sub .d { color: var(--rv-del-text); }

  .rv-file-card {
    background: var(--rv-panel);
    border: 1px solid var(--rv-border);
    border-radius: 8px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .rv-file-card > summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; background: var(--rv-panel-alt); font-family: var(--rv-mono); font-size: 12.5px; user-select: none;
  }
  .rv-file-card > summary::-webkit-details-marker { display: none; }
  .rv-chevron { font-size: 10px; color: var(--rv-text-dim); transition: transform 0.1s; width: 10px; display: inline-block; }
  .rv-file-card:not([open]) > summary .rv-chevron { transform: rotate(-90deg); }
  .rv-path { color: var(--rv-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rv-dirpart { color: var(--rv-text-dim); }
  .rv-spacer { flex: 1; }
  .rv-tally { font-size: 11px; flex-shrink: 0; }
  .rv-tally .a { color: var(--rv-add-text); }
  .rv-tally .d { color: var(--rv-del-text); }
  .rv-pill { flex-shrink: 0; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; font-family: var(--rv-sans); }
  .rv-pill-added { background: var(--rv-add-bg-strong); color: var(--rv-add-text); }
  .rv-pill-modified { background: rgba(210, 153, 34, 0.25); color: #d29922; }
  .rv-pill-deleted { background: var(--rv-del-bg-strong); color: var(--rv-del-text); }
  .rv-pill-renamed, .rv-pill-copied { background: rgba(88, 166, 255, 0.2); color: var(--rv-accent); }
  .rv-language-tag {
    flex-shrink: 0;
    font-family: var(--rv-sans);
    font-size: 9.5px;
    color: var(--rv-text-dim);
    background: var(--rv-bg);
    border: 1px solid var(--rv-border-muted);
    padding: 1px 6px;
    border-radius: 10px;
  }
  .rv-slice-tag { flex-shrink: 0; font-size: 10px; color: var(--rv-text-dim); border: 1px solid var(--rv-border-muted); padding: 1px 6px; border-radius: 10px; }

  .rv-viewed-toggle {
    flex-shrink: 0; display: flex; align-items: center; gap: 4px; font-family: var(--rv-sans);
    font-size: 11px; color: var(--rv-text-muted); cursor: pointer; margin-left: 8px;
  }
  .rv-viewed-toggle input { cursor: pointer; }

  .rv-diff-scroll { overflow-x: auto; max-width: 100%; }
  .rv-diff-table { border-collapse: collapse; font-family: var(--rv-mono); font-size: 12px; line-height: 1.55; width: max-content; min-width: 100%; }
  .rv-diff-table tr.ctx td.code { color: var(--rv-text-muted); }
  .rv-diff-table tr.hunk td { background: var(--rv-hunk-bg); color: var(--rv-hunk-text); font-style: italic; }
  .rv-diff-table tr.add td { background: var(--rv-add-bg); }
  .rv-diff-table tr.add td.code { color: var(--rv-add-code-text); }
  .rv-diff-table tr.del td { background: var(--rv-del-bg); }
  .rv-diff-table tr.del td.code { color: var(--rv-del-code-text); }
  .rv-diff-table tr.truncated td { color: var(--rv-text-dim); font-style: italic; text-align: center; padding: 6px; }
  /* white-space: pre only on code/line-number cells — a blanket rule here also hits the
