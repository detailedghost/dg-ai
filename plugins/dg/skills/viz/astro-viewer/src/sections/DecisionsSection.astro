---
import DecisionBlock from '../components/DecisionBlock.astro'
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
  inPlanning: boolean
  collapsed?: boolean
}
const { payload, collapsed } = Astro.props
---

<details id='decisions' open={!collapsed} class='group'>
  <summary class='mb-4 flex cursor-pointer list-none items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='bolt' class='h-5 w-5 text-accent' /> Decisions
    {collapsed && <span class='text-xs font-normal text-mid'>· resolved, click to review</span>}
    <Icon name='chevron-down' class='ml-auto h-4 w-4 text-mid transition-transform group-open:rotate-180' />
  </summary>
  {(payload.decisions ?? []).map((d: any) => (
    <DecisionBlock question={d.question} answer={d.answer} rationale={d.rationale} thread={d.thread ?? []} />
  ))}
</details>
