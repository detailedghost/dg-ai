---
// Feature demo assets (/demo output) shown above the diff on a review board, so the
// reviewer sees the thing working before reading how it was built.
import Icon from "../components/Icon.astro"

interface DemoShot {
  /** URL under /demo-assets/<slug>/ — see dg-skills viz review --demo. */
  src: string
  label?: string
}
interface DemoPayload {
  video?: string
  poster?: string
  caption?: string
  screenshots?: DemoShot[]
}
interface Props {
  payload: { demo?: DemoPayload }
}
const { payload } = Astro.props
const demo = payload.demo
const shots = demo?.screenshots ?? []
// Extension drives the <source> type; browsers are strict about a wrong one.
const videoType = demo?.video?.endsWith(".webm") ? "video/webm" : "video/mp4"
---

{demo && (demo.video || shots.length > 0) && (
  <section id="demo" class="rv-demo">
    <h2 class="rv-demo-title">
      <Icon name="play-circle" class="h-5 w-5 text-indigo-500" />
      Demo
      {demo.video && shots.length > 0 && <span class="rv-demo-sub">video + {shots.length} screenshot{shots.length === 1 ? "" : "s"}</span>}
    </h2>

    {demo.caption && <p class="rv-demo-caption">{demo.caption}</p>}

    {demo.video && (
      <div class="rv-demo-videowrap">
        {/* controls only — no autoplay: a reviewer opening the board should not get sound or motion unasked */}
        <video class="rv-demo-video" controls preload="metadata" poster={demo.poster}>
          <source src={demo.video} type={videoType} />
          Your browser cannot play this video. Open it directly: <a href={demo.video}>{demo.video}</a>
        </video>
      </div>
    )}

    {shots.length > 0 && (
      <div class="rv-demo-shots">
        {shots.map(shot => (
          <figure class="rv-demo-shot">
            <a href={shot.src} target="_blank" rel="noopener noreferrer">
              <img src={shot.src} alt={shot.label ?? "demo screenshot"} loading="lazy" />
            </a>
            {shot.label && <figcaption>{shot.label}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </section>
)}

<style>
  .rv-demo {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
  }
  :global(.dark) .rv-demo {
    border-color: #1f2937;
    background: #0b1220;
  }
  .rv-demo-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1f2937;
  }
  :global(.dark) .rv-demo-title {
    color: #e5e7eb;
  }
  .rv-demo-sub {
    font-size: 0.75rem;
    font-weight: 400;
    color: #9ca3af;
  }
  .rv-demo-caption {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #6b7280;
  }
  :global(.dark) .rv-demo-caption {
    color: #9ca3af;
  }
  .rv-demo-videowrap {
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  .rv-demo-video {
    display: block;
    width: 100%;
    max-height: 70vh;
  }
  .rv-demo-shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
    margin-top: 0.875rem;
  }
  .rv-demo-shot {
    margin: 0;
  }
  .rv-demo-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
  }
  :global(.dark) .rv-demo-shot img {
    border-color: #1f2937;
  }
  .rv-demo-shot figcaption {
    margin-top: 0.3rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }
  :global(.dark) .rv-demo-shot figcaption {
    color: #9ca3af;
  }
</style>
