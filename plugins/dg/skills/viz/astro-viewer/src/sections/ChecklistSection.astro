---
import ChecklistItem from '../components/ChecklistItem.astro'
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props
const doneCount = (payload.checklist ?? []).filter((i: any) => i.done).length
const totalCount = (payload.checklist ?? []).length
---

<section id='checklist'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='check-circle' class='h-5 w-5 text-accent' /> Acceptance Criteria
    <span class='ml-auto font-mono text-sm font-normal text-mid'>
      {doneCount} / {totalCount}
    </span>
  </h2>
  <div class='overflow-hidden rounded border border-rule divide-y divide-rule-soft'>
    {(payload.checklist ?? []).map((item: any) => (
      <ChecklistItem id={item.id} text={item.text} done={item.done} />
    ))}
  </div>
</section>
