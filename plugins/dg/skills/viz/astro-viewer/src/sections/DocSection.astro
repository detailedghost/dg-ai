---
import { marked } from 'marked'
import CodeBlock from '../components/CodeBlock.astro'
import Callout from '../components/Callout.astro'
import Icon from '../components/Icon.astro'
import type { DocBlock, DocTableCell, DocTone } from '../types.ts'

interface Props {
  payload: any
}
const { payload } = Astro.props
const blocks: DocBlock[] = Array.isArray(payload.doc) ? payload.doc : []

function escapeHtml(s: string): string {
  return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string))
}
marked.use({ renderer: { html: (t: { text: string }) => escapeHtml(t.text) } })
const md = (s: string) => marked.parse(s ?? '', { async: false }) as string

const toneText: Record<DocTone, string> = {
  good: 'text-accent',
  bad: 'text-risk',
  warn: 'text-signal',
  muted: 'text-mid',
  accent: 'text-accent',
}
const toneBorder: Record<DocTone, string> = {
  good: 'border-accent',
  bad: 'border-risk',
  warn: 'border-signal',
  muted: 'border-rule',
  accent: 'border-accent',
}
const cell = (c: string | DocTableCell): DocTableCell => (typeof c === 'string' ? { value: c } : c)
---

<section id='doc' class='doc-prose space-y-5'>
  {blocks.map((b) => {
    if (b.type === 'heading') {
      return (
        <div class='mt-8 first:mt-0'>
          {b.eyebrow && (
            <div class='mb-1 font-mono text-xs font-bold uppercase tracking-[0.11em] text-accent'>{b.eyebrow}</div>
          )}
          {b.level === 3 ? (
            <h3 class='text-balance font-display text-base font-semibold text-ink'>{b.text}</h3>
          ) : (
            <h2 class='text-balance font-display text-xl font-semibold text-ink'>{b.text}</h2>
          )}
        </div>
      )
    }
    if (b.type === 'prose') {
      return <div class='leading-relaxed text-ink-2' set:html={md(b.text)} />
    }
    if (b.type === 'callout') {
      return (
        <Callout type={b.variant ?? 'info'} title={b.title}>
          <div set:html={md(b.text)} />
        </Callout>
      )
    }
    if (b.type === 'code') {
      return <CodeBlock code={b.code} lang={b.lang} title={b.title} caption={b.caption} />
    }
    if (b.type === 'formula') {
      return (
        <div class='my-4 rounded border border-rule-soft bg-panel-2 px-5 py-4'>
          {b.label && <div class='mb-2 font-mono text-xs font-bold uppercase tracking-[0.11em] text-mid'>{b.label}</div>}
          <div class='flex flex-wrap items-center gap-3 font-mono text-sm text-ink tabular-nums'>
            {b.numerator !== undefined && b.denominator !== undefined ? (
              <span class='inline-flex flex-col text-center leading-tight'>
                <span class='px-2'>{b.numerator}</span>
                <span class='mt-1 border-t border-mid px-2 pt-1'>{b.denominator}</span>
              </span>
            ) : null}
            {b.expression && <span>{b.expression}</span>}
            {b.result && (
              <>
                <span class='text-mid'>=</span>
                <span class='font-semibold text-accent'>{b.result}</span>
              </>
            )}
          </div>
          {b.note && <div class='mt-2 text-xs text-mid'>{b.note}</div>}
        </div>
      )
    }
    if (b.type === 'table') {
      return (
        <div class='my-4 overflow-x-auto rounded border border-rule'>
          <table class='w-full border-collapse text-sm'>
            <thead>
              <tr class='bg-panel-2'>
                {b.columns.map((h) => (
                  <th class='px-3 py-2 text-left font-mono text-xs font-bold uppercase tracking-wide text-mid'>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {b.rows.map((row) => (
                <tr class='border-t border-rule-soft even:bg-panel-2/60'>
                  {row.map((raw) => {
                    const c = cell(raw)
                    return <td class={`px-3 py-2 tabular-nums ${c.tone ? toneText[c.tone] : 'text-ink-2'}`}>{c.value}</td>
                  })}
                </tr>
              ))}
            </tbody>
          </table>
          {b.caption && <div class='border-t border-rule-soft px-3 py-2 text-xs italic text-mid'>{b.caption}</div>}
        </div>
      )
    }
    if (b.type === 'compare') {
      return (
        <div class='my-4 grid gap-4'>
          {b.items.map((it) => (
            <div class={`rounded border-l-[3px] bg-panel-2 p-4 ${it.tone ? toneBorder[it.tone] : 'border-rule'}`}>
              <div class={`mb-2 flex items-center gap-1.5 font-display text-sm font-semibold ${it.tone ? toneText[it.tone] : 'text-ink'}`}>
                <Icon name='document-text' class='h-4 w-4' />{it.title}
              </div>
              <div class='doc-prose text-sm leading-relaxed text-ink-2' set:html={md(it.body)} />
            </div>
          ))}
        </div>
      )
    }
    return null
  })}
</section>

<style>
  .doc-prose :global(p) { margin: 0.5rem 0; }
  .doc-prose :global(ul) { margin: 0.5rem 0; padding-left: 1.25rem; list-style: disc; }
  .doc-prose :global(ol) { margin: 0.5rem 0; padding-left: 1.25rem; list-style: decimal; }
  .doc-prose :global(li) { margin: 0.25rem 0; }
  .doc-prose :global(strong) { font-weight: 600; }
  .doc-prose :global(a) { color: #1f6f6b; text-decoration: underline; }
  :global(html.dark) .doc-prose :global(a) { color: #5cb8b1; }
  /* :not(pre) > code so the inline-code pill never lands on Shiki's <pre><code>, which
     already carries its own background — layering both is the "weird highlight". */
  .doc-prose :global(:not(pre) > code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.06);
  }
  :global(:root[data-theme='dark']) .doc-prose :global(:not(pre) > code),
  :global(html.dark) .doc-prose :global(:not(pre) > code) { background: rgb(255 255 255 / 0.1); }
</style>
