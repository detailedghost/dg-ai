---
import CodeBlock from '../components/CodeBlock.astro'
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props
---

<section id='code-samples'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='code-bracket' class='h-5 w-5 text-accent' /> Code Samples
  </h2>
  {(payload.code_samples ?? []).map((s: any) => (
    <CodeBlock code={s.code} lang={s.lang} title={s.title} caption={s.caption} />
  ))}
</section>
