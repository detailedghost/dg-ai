---
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props
const steps: string[] = payload.next_steps ?? []
const feedback = Array.isArray(payload.next_steps_feedback) ? payload.next_steps_feedback : []
const reviewRequired = !!payload.next_steps_review?.required
const approved = payload.next_steps_approved === true
const feedbackPending = payload.next_steps_feedback_pending === true

type Zone = 'Now' | 'Next' | 'Later'
const zoneOf = (i: number): Zone => (i === 0 ? 'Now' : i < 3 ? 'Next' : 'Later')
const zoneTone: Record<Zone, { ring: string; text: string; rail: string }> = {
  Now: { ring: 'border-accent text-accent', text: 'text-accent', rail: 'border-accent' },
  Next: { ring: 'border-progress text-progress', text: 'text-progress', rail: 'border-progress' },
  Later: { ring: 'border-rule text-mid', text: 'text-mid', rail: 'border-rule' },
}
const numbered = steps.map((text, i) => ({ text, n: i + 1, zone: zoneOf(i) }))
const lanes = (['Now', 'Next', 'Later'] as const)
  .map((zone) => ({ zone, items: numbered.filter((s) => s.zone === zone) }))
  .filter((lane) => lane.items.length > 0)
---

<section id='next-steps'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='arrow-right-circle' class='h-5 w-5 text-accent' /> Next Steps
  </h2>
  <div class='flex flex-col gap-3'>
    {lanes.map((lane, laneIdx) => (
      <div class={`rounded border-l-[3px] px-4 pb-4 pt-3.5 ${zoneTone[lane.zone].rail} ${laneIdx === 0 ? 'bg-accent-soft' : 'bg-panel'}`}>
        <div class='mb-3 flex items-baseline gap-2'>
          <p class={`font-mono text-[0.66rem] font-bold uppercase tracking-[0.14em] ${zoneTone[lane.zone].text}`}>
            {lane.zone}
          </p>
          <span class='font-mono text-[0.62rem] text-mid'>
            {lane.items.length} {lane.items.length === 1 ? 'step' : 'steps'}
          </span>
        </div>
        {lane.items.map((step, i) => (
          <div class='relative flex gap-3 pb-4 last:pb-0'>
            {i < lane.items.length - 1 && (
              <span class='absolute bottom-0 left-[13px] top-8 w-px bg-rule' aria-hidden='true' />
            )}
            <span class={`relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 bg-ground font-mono text-xs font-bold ${zoneTone[lane.zone].ring}`}>
              {step.n}
            </span>
            <p class='min-w-0 flex-1 pt-1 text-sm text-ink-2'>{step.text}</p>
          </div>
        ))}
      </div>
    ))}
  </div>

  {feedback.length > 0 && (
    <div class='mt-5 rounded border-l-[3px] border-signal bg-signal-soft px-4 py-3'>
      <p class='mb-2 font-mono text-xs font-bold uppercase tracking-[0.11em] text-signal'>Feedback</p>
      <ul class='space-y-2 text-sm text-ink-2'>
        {feedback.map((item: any) => (
          <li class={item.resolved ? 'opacity-60' : ''}>{item.comment}</li>
        ))}
      </ul>
    </div>
  )}

  {reviewRequired && (
    <div class='mt-5 rounded border border-rule bg-panel p-4'>
      {approved ? (
        <p class='text-sm font-medium text-accent'>Next steps approved.</p>
      ) : feedbackPending ? (
        <p class='text-sm font-medium text-signal'>Feedback received. Updates will appear here.</p>
      ) : (
        <div id='next-steps-review' class='space-y-3'>
          <textarea
            id='next-steps-comment'
            rows={3}
            placeholder='Add comments or requested edits...'
            class='w-full rounded border border-rule bg-panel px-3 py-2 text-sm text-ink placeholder-mid focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30'
          />
          <div class='flex flex-wrap items-center gap-3'>
            <button
              type='button'
              data-next-steps-action='approved'
              class='rounded bg-accent px-4 py-2 text-sm font-medium text-on-fill hover:bg-accent/90 disabled:opacity-50'
            >
              Approve Next Steps
            </button>
            <button
              type='button'
              data-next-steps-action='comment'
              class='rounded border border-rule bg-panel px-4 py-2 text-sm font-medium text-ink-2 hover:bg-panel-2 disabled:opacity-50'
            >
              Send Comments
            </button>
            <span id='next-steps-status' class='hidden text-sm text-mid' aria-live='polite' />
          </div>
        </div>
      )}
    </div>
  )}
</section>

<script>
  import { readVizMeta, respond, signAnswers } from '../lib/respond-client.ts'

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-next-steps-action]')
    if (!button) return

    const action = button.dataset.nextStepsAction
    const comment = (document.getElementById('next-steps-comment') as HTMLTextAreaElement | null)?.value.trim() ?? ''
    const status = document.getElementById('next-steps-status')
    if (action === 'comment' && !comment) {
      if (status) {
        status.textContent = 'Add a comment first.'
        status.classList.remove('hidden')
      }
      return
    }

    const { slug, nonce } = readVizMeta()
    const answers = [
      {
        type: 'next_steps_review',
        index: 0,
        answer: JSON.stringify({ action, comment }),
      },
    ]

    document.querySelectorAll<HTMLButtonElement>('[data-next-steps-action]').forEach((b) => {
      b.disabled = true
    })
    if (status) {
      status.textContent = 'Saving...'
      status.classList.remove('hidden')
    }

    try {
      const hmac = await signAnswers(slug, answers)
      const res = await respond(slug, nonce, hmac, answers)
      if (!res.ok) throw new Error(`${res.status}`)
      await (window as unknown as { vizRefresh?: (ids?: string[]) => Promise<void> }).vizRefresh?.()
    } catch (err) {
      if (status) status.textContent = `Error saving: ${err}`
      document.querySelectorAll<HTMLButtonElement>('[data-next-steps-action]').forEach((b) => {
        b.disabled = false
      })
    }
  })
</script>
