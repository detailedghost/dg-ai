---
import Icon from '../components/Icon.astro'

interface Props {
  payload: any
  mode: string
}
const { payload } = Astro.props

const errors: any[] = payload.errors ?? []
const blockedPhases: any[] = (payload.phases ?? []).filter((p: any) => p.status === 'blocked')

const severityBorder: Record<string, string> = {
  critical: 'border-risk bg-risk-soft',
  high:     'border-risk bg-risk-soft',
  medium:   'border-signal bg-signal-soft',
  low:      'border-progress bg-progress-soft',
  info:     'border-rule bg-panel-2',
}
const severityBadge: Record<string, string> = {
  critical: 'bg-risk text-on-fill',
  high:     'bg-risk-soft text-risk',
  medium:   'bg-signal-soft text-signal',
  low:      'bg-progress-soft text-progress',
  info:     'bg-panel-2 text-mid',
}
---

<section id='errors'>
  <h2 class='mb-4 flex items-center gap-2 border-b-2 border-ink pb-3 font-display text-lg font-semibold text-ink'>
    <Icon name='exclamation-circle' class='h-5 w-5 text-risk' /> Errors / Blocked
  </h2>

  {blockedPhases.length > 0 && (
    <div class='mb-4 rounded border-l-[3px] border-risk bg-risk-soft p-4'>
      <div class='mb-1 flex items-center gap-1.5'>
        <Icon name='no-symbol' class='h-4 w-4 text-risk' />
        <span class='text-sm font-semibold text-ink'>
          {blockedPhases.length === 1 ? '1 blocked phase' : `${blockedPhases.length} blocked phases`}
        </span>
      </div>
      <ul class='ml-6 list-disc space-y-0.5 text-sm text-ink-2'>
        {blockedPhases.map((p: any) => (
          <li>
            <span class='font-medium'>{p.label}</span>
            {p.description && <span class='text-mid'> — {p.description}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {errors.map((e: any) => (
    <div class={`my-3 rounded border-l-[3px] p-4 ${severityBorder[e.severity] ?? severityBorder.info}`}>
      <div class='mb-1 flex items-center gap-2'>
        <span class={`rounded px-1.5 py-0.5 font-mono text-xs font-bold uppercase ${severityBadge[e.severity] ?? severityBadge.info}`}>
          {e.severity ?? 'info'}
        </span>
        <span class='font-display font-semibold text-ink'>{e.title}</span>
      </div>
      {e.detail && <p class='text-sm text-ink-2'>{e.detail}</p>}
    </div>
  ))}
</section>
