---
import Base from '../layouts/Base.astro'
import { computeBoardStatus, tokenFilePath } from '../lib/respond-core.ts'
import type { BoardSummary } from './api/boards'

// SSR: read boards directly (same logic as /api/boards, no round-trip needed at render time)
import { existsSync, readdirSync, readFileSync } from 'node:fs'

const VIZ_DIR = process.env.VIZ_DIR ?? `${process.env.AI_SCRATCH_DIR ?? '/tmp/ai'}/viz`
const TBD = 'tbd'

const boards: BoardSummary[] = existsSync(VIZ_DIR)
  ? readdirSync(VIZ_DIR)
      .filter(
        (d) =>
          existsSync(`${VIZ_DIR}/${d}/payload.json`) &&
          existsSync(tokenFilePath(`${VIZ_DIR}/${d}`)),
      )
      .map((slug) => {
        const p = JSON.parse(readFileSync(`${VIZ_DIR}/${slug}/payload.json`, 'utf-8')) as {
          title?: string
          subtitle?: string
          template?: string
          date?: string
          session_id?: string
          decisions?: { answer?: string }[]
          open_questions?: unknown[]
        }
        const pending =
          (p.decisions ?? []).filter((d) => !d.answer || d.answer === TBD).length +
          (p.open_questions ?? []).length
        return {
          slug,
          title: p.title ?? slug,
          subtitle: p.subtitle ?? '',
          template: p.template ?? 'unknown',
          status: computeBoardStatus(`${VIZ_DIR}/${slug}`, p as Record<string, unknown>),
          date: p.date ?? '',
          session_id: p.session_id ?? '',
          pending,
        }
      })
      .sort((a, b) => b.slug.localeCompare(a.slug))
  : []

const liveCount = boards.filter((b) => b.status === 'live').length
const awaitingCount = boards.filter((b) => b.status === 'awaiting').length
---

<Base title="viz · boards" template="system">
  <!-- page chrome -->
  <div class="boards-page">
    <div class="boards-eyebrow">
      <span class="boards-signal-dot" aria-hidden="true"></span>
      <span class="boards-eyebrow-label">board browser</span>
      <span class="boards-eyebrow-counts">
        {boards.length} total
        {liveCount > 0 && <span class="boards-count-live">· {liveCount} live</span>}
        {awaitingCount > 0 && <span class="boards-count-awaiting">· {awaitingCount} awaiting</span>}
      </span>
    </div>

    <!-- search bar -->
    <div class="boards-search-wrap">
      <label for="boards-search" class="sr-only">Filter boards by title, description, slug, or session ID</label>
      <svg class="boards-search-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="6.5" cy="6.5" r="4.5"/>
        <path d="m10.5 10.5 3 3"/>
      </svg>
      <input
        id="boards-search"
        type="search"
        placeholder="filter by title, description, slug, session…"
        autocomplete="off"
        spellcheck="false"
        class="boards-search-input"
        aria-label="Filter boards"
      />
      <kbd class="boards-search-kbd" aria-hidden="true">/</kbd>
    </div>

    <!-- column headers -->
    <div class="boards-header boards-grid" aria-hidden="true">
      <span class="col-status">status</span>
      <span class="col-title">title</span>
      <span class="col-template">template</span>
      <span class="col-date">date</span>
      <span class="col-session">session</span>
    </div>

    {boards.length === 0 ? (
      <div class="boards-empty">
        <p class="boards-empty-headline">No boards yet.</p>
        <p class="boards-empty-hint">Run <code>dg-skills viz render &lt;slug&gt;</code> to create one.</p>
      </div>
    ) : (
      <ul class="boards-list" id="boards-list" role="list">
        {boards.map((board) => {
          const resumeCmd = board.session_id ? `claude --resume ${board.session_id}` : ''
          return (
            <li
              class={`boards-row boards-grid status-${board.status}`}
              data-title={board.title.toLowerCase()}
              data-desc={board.subtitle.toLowerCase()}
              data-slug={board.slug.toLowerCase()}
              data-session={board.session_id.toLowerCase()}
            >
              <!-- status glyph -->
              <span class="col-status">
                <span class={`status-badge status-badge--${board.status}`} aria-label={`Status: ${board.status}`}>
                  <span class="status-glyph" aria-hidden="true">{
                    board.status === 'live' ? '◉' :
                    board.status === 'awaiting' ? '◎' :
                    board.status === 'settled' ? '○' :
                    '·'
                  }</span>
                  <span class="status-word">{board.status}</span>
                </span>
              </span>

              <!-- title links to board -->
              <span class="col-title">
                <a href={`/viz/${board.slug}`} class="boards-row-link" tabindex="0">
                  {board.title}
                </a>
                <span class="boards-row-slug">{board.slug}</span>
              </span>

              <!-- template -->
              <span class="col-template">
                <span class="template-chip">{board.template}</span>
              </span>

              <!-- date -->
              <span class="col-date">{board.date || '—'}</span>

              <!-- session resume -->
              <span class="col-session">
                {board.session_id ? (
                  <button
                    type="button"
                    class="session-btn"
                    data-copy-text={resumeCmd}
                    title={`Copy: ${resumeCmd}`}
                    aria-label={`Copy resume command for session ${board.session_id}`}
                  >
                    <span class="session-id-short" aria-hidden="true">{board.session_id.slice(0, 8)}</span>
                    <span class="session-copy-hint" aria-hidden="true">copy</span>
                  </button>
                ) : (
                  <span class="session-none" aria-label="No session ID">—</span>
                )}
              </span>
            </li>
          )
        })}
      </ul>
    )}

    <p class="boards-no-results" id="boards-no-results" aria-live="polite" hidden>
      No boards match your filter.
    </p>
  </div>
</Base>

<style>
  /* ── Layout tokens ─────────────────────────────────────────── */
  .boards-page {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Eyebrow bar ───────────────────────────────────────────── */
  .boards-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.6875rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-mid);
  }
  .boards-signal-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent); /* server is up if you can see this page */
    box-shadow: 0 0 0 2px transparent, 0 0 6px color-mix(in srgb, var(--color-accent) 60%, transparent);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .boards-signal-dot { animation: none; }
  }
  .boards-eyebrow-label {
    color: var(--color-ink-2);
  }
  .boards-eyebrow-counts {
    margin-left: auto;
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }
  .boards-count-live {
    color: var(--color-progress);
  }
  .boards-count-awaiting {
    color: var(--color-signal);
  }

  /* ── Search bar ────────────────────────────────────────────── */
  .boards-search-wrap {
    position: relative;
    margin-bottom: 1.5rem;
  }
  .boards-search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--color-mid);
    pointer-events: none;
  }
  .boards-search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 2.75rem 0.75rem 2.5rem;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-rule);
    border-radius: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9375rem;
    color: var(--color-ink);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .boards-search-input::placeholder {
    color: var(--color-mid);
  }
  .boards-search-input:focus {
    border-bottom-color: var(--color-accent);
  }
  /* remove webkit search cancel button */
  .boards-search-input::-webkit-search-cancel-button { display: none; }
  .boards-search-kbd {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    color: var(--color-mid);
    background: var(--color-panel-2);
    pointer-events: none;
    transition: opacity 0.15s;
  }
  /* hide kbd hint when the input is focused */
  .boards-search-input:focus ~ .boards-search-kbd {
    opacity: 0;
  }

  /* ── Grid columns ──────────────────────────────────────────── */
  .boards-grid {
    display: grid;
    grid-template-columns:
      7.5rem     /* status */
      1fr        /* title */
      6rem       /* template */
      6rem       /* date */
      6.5rem;    /* session */
    gap: 0 1rem;
    align-items: center;
  }

  /* ── Column headers ────────────────────────────────────────── */
  .boards-header {
    padding: 0.25rem 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-mid);
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: 0.25rem;
  }

  /* ── Board rows ────────────────────────────────────────────── */
  .boards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .boards-row {
    padding: 0.5rem 0.75rem;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--color-rule-soft);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    transition: background 0.1s ease, border-left-color 0.1s ease;
    cursor: default;
  }
  .boards-row:hover {
    background: var(--color-panel-2);
  }

  /* Left rail color by status — the structural risk: urgency encoded in border width + hue */
  .boards-row.status-live {
    border-left-color: var(--color-progress);
    border-left-width: 3px;
  }
  .boards-row.status-awaiting {
    border-left-color: var(--color-signal);
    border-left-width: 3px;
  }
  .boards-row.status-settled {
    border-left-color: var(--color-rule); /* deliberately quiet */
    border-left-width: 1px;
  }
  .boards-row.status-stale {
    border-left-color: transparent;
    border-left-width: 1px;
    opacity: 0.55;
  }

  /* ── Status badge ──────────────────────────────────────────── */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
  .status-glyph {
    font-size: 0.625rem;
    line-height: 1;
  }
  .status-badge--live .status-glyph,
  .status-badge--live .status-word  { color: var(--color-progress); }
  .status-badge--awaiting .status-glyph,
  .status-badge--awaiting .status-word { color: var(--color-signal); }
  .status-badge--settled .status-glyph,
  .status-badge--settled .status-word  { color: var(--color-mid); }
  .status-badge--stale .status-glyph,
  .status-badge--stale .status-word    { color: var(--color-mid); }

  /* ── Title + slug ──────────────────────────────────────────── */
  .col-title {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .boards-row-link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.8125rem;
    transition: color 0.1s ease;
  }
  .boards-row-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .boards-row-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .boards-row-slug {
    font-size: 0.625rem;
    color: var(--color-mid);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Template chip ─────────────────────────────────────────── */
  .template-chip {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    color: var(--color-mid);
    white-space: nowrap;
  }

  /* ── Date ──────────────────────────────────────────────────── */
  .col-date {
    font-size: 0.6875rem;
    color: var(--color-mid);
    white-space: nowrap;
  }

  /* ── Session resume button ─────────────────────────────────── */
  .session-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.6875rem;
    color: var(--color-mid);
    transition: color 0.1s ease;
  }
  .session-btn:hover {
    color: var(--color-accent);
  }
  .session-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .session-id-short {
    /* shown by default */
  }
  .session-copy-hint {
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.1s ease;
  }
  .session-btn:hover .session-copy-hint {
    opacity: 0.7;
  }
  .session-none {
    color: var(--color-rule);
  }

  /* ── Empty state ───────────────────────────────────────────── */
  .boards-empty {
    padding: 2.5rem 0.75rem;
    text-align: center;
  }
  .boards-empty-headline {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-2);
    margin: 0 0 0.25rem;
  }
  .boards-empty-hint {
    font-size: 0.8125rem;
    color: var(--color-mid);
    margin: 0;
  }
  .boards-empty-hint code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    background: var(--color-panel-2);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  /* ── No-results notice ─────────────────────────────────────── */
  .boards-no-results {
    padding: 1.5rem 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    color: var(--color-mid);
    text-align: center;
  }

  /* ── Responsive: collapse template/date on small screens ────── */
  @media (max-width: 600px) {
    .boards-grid {
      grid-template-columns: 6rem 1fr 5rem;
    }
    .col-template,
    .col-date {
      display: none;
    }
    /* session column becomes 3rd */
    .col-session {
      /* already last — let it stay */
    }
  }
</style>

<script>
  // ── Keyboard shortcut: / to focus search ────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
      e.preventDefault()
      document.getElementById('boards-search')?.focus()
    }
  })

  // ── Live search / filter ─────────────────────────────────────
  const searchInput = document.getElementById('boards-search') as HTMLInputElement | null
  const list = document.getElementById('boards-list')
  const noResults = document.getElementById('boards-no-results')

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase()
    const rows = list?.querySelectorAll<HTMLElement>('li[data-slug]') ?? []
    let visibleCount = 0
    for (const row of rows) {
      const matches =
        !q ||
        row.dataset.title?.includes(q) ||
        row.dataset.desc?.includes(q) ||
        row.dataset.slug?.includes(q) ||
        row.dataset.session?.includes(q)
      row.hidden = !matches
      if (matches) visibleCount++
    }
    if (noResults) noResults.hidden = visibleCount > 0 || rows.length === 0
  })
</script>
