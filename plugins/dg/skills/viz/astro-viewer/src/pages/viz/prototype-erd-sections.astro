---
// PROTOTYPE — throwaway route, see .agents/prototype/erd-viz-sections/NOTES.md
// Answers: what should the new /erd Mermaid + Evidence /viz sections look like?
// Delete this file (and src/sections/prototype/*) once a variant is picked and
// folded into the real MermaidSection.astro / EvidenceSection.astro.
import Base from '../../layouts/Base.astro'
import PrototypeSwitcher from '../../components/PrototypeSwitcher.astro'
import MermaidSectionPrototype from '../../sections/prototype/MermaidSectionPrototype.astro'
import EvidenceSectionPrototypeA from '../../sections/prototype/EvidenceSectionPrototypeA.astro'
import EvidenceSectionPrototypeB from '../../sections/prototype/EvidenceSectionPrototypeB.astro'
import EvidenceSectionPrototypeC from '../../sections/prototype/EvidenceSectionPrototypeC.astro'
import EvidenceSectionPrototypeD from '../../sections/prototype/EvidenceSectionPrototypeD.astro'
import EvidenceSectionPrototypeE from '../../sections/prototype/EvidenceSectionPrototypeE.astro'

const VARIANTS = ['A', 'B', 'C', 'D', 'E']
const LABELS = {
  A: 'Evidence — flat list',
  B: 'Evidence — grouped table',
  C: 'Evidence — accordion',
  D: 'Evidence — terminal log',
  E: 'Evidence — card grid',
}
const variant = (Astro.url.searchParams.get('variant') ?? 'A').toUpperCase()
const current = VARIANTS.includes(variant) ? variant : 'A'

const sampleDiagram = `erDiagram
  USERS ||--o{ ORDERS : places
  ORDERS ||--|{ LINE_ITEMS : contains
  PRODUCTS ||--o{ LINE_ITEMS : "referenced by"
  USERS {
    int id
    string email
    string name
  }
  ORDERS {
    int id
    int user_id
    string status
    datetime created_at
  }
  LINE_ITEMS {
    int id
    int order_id
    int product_id
    int quantity
  }
  PRODUCTS {
    int id
    string sku
    string title
  }`

// Deliberately malformed — unterminated relationship label, used to preview the error fallback.
const brokenDiagram = `erDiagram
  USERS ||--o{ ORDERS : places
  ORDERS ||--|{ LINE_ITEMS : "unterminated
  `

const sampleEvidence = [
  { type: 'db-table', ref: 'public.users', detail: 'introspected live via `db tables jrp-pg`' },
  { type: 'db-table', ref: 'public.orders', detail: 'introspected live via `db tables jrp-pg`' },
  { type: 'db-column', ref: 'public.orders.user_id', detail: 'FK inferred from naming + join usage in 3 models' },
  { type: 'db-table', ref: 'public.line_items', detail: 'introspected live via `db tables jrp-pg`' },
  { type: 'db-column', ref: 'public.line_items.order_id', detail: 'FK confirmed via information_schema constraint' },
  { type: 'file', ref: 'src/models/order.ts:12-40', detail: 'ORM model — maps to public.orders' },
  { type: 'file', ref: 'src/models/user.ts:8-22', detail: 'ORM model — maps to public.users' },
  { type: 'file', ref: 'src/services/checkout.ts:1-96', detail: '42 files scanned in src/services/**' },
]
---

<Base title="/erd viz sections — prototype" subtitle="Mermaid diagram + evidence tab" template="system">
  <div class="space-y-10">
    <p class="proto-banner">
      🧪 Prototype route — not part of the real board. Comparing 5 evidence-tab
      layouts (A: flat list, B: grouped table, C: accordion, D: terminal log,
      E: card grid). All variants share the same Mermaid diagram section above
      — click "simulate broken diagram" to preview the error-fallback state.
    </p>

    <MermaidSectionPrototype
      diagram={sampleDiagram}
      brokenDiagram={brokenDiagram}
      title="Diagram"
      caption="Generated ER diagram — code ↔ schema mapping for the checkout flow."
    />

    {current === 'A' && <EvidenceSectionPrototypeA evidence={sampleEvidence} />}
    {current === 'B' && <EvidenceSectionPrototypeB evidence={sampleEvidence} />}
    {current === 'C' && <EvidenceSectionPrototypeC evidence={sampleEvidence} />}
    {current === 'D' && <EvidenceSectionPrototypeD evidence={sampleEvidence} />}
    {current === 'E' && <EvidenceSectionPrototypeE evidence={sampleEvidence} />}
  </div>

  <PrototypeSwitcher
    variants={VARIANTS}
    current={current}
    prototypeName="erd-viz-sections"
    labels={LABELS}
    basePath="/api"
  />
</Base>

<style>
  .proto-banner {
    font-size: 0.8125rem;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin: 0;
  }
  :global(.dark) .proto-banner {
    color: #fbbf24;
    background: #422006;
    border-color: #78350f;
  }
</style>

<script>
  // This page is server-rendered per ?variant= (picks EvidenceSection A vs B),
  // so a client-side replaceState from PrototypeSwitcher's arrows won't change
  // what's on screen. Force a real navigation on the popstate it dispatches.
  window.addEventListener('popstate', () => {
    location.reload()
  })
</script>

