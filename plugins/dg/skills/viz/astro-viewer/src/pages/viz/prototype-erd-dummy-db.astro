---
// PROTOTYPE — throwaway demo route, see .agents/prototype/erd-dummy-db/NOTES.md
// Not a decision prototype for the box/connector styling (that's locked — see
// erd-diagram-shapes-schema/NOTES.md variant A). The color theme IS still just
// being browsed here at the user's request — the 5 palettes below are lifted
// straight from erd-diagram-themes/NOTES.md, whose locked answer remains
// adaptive dark-neon (A) / light-indigo (B), NOT a re-opened decision.
import Base from '../../layouts/Base.astro'
import MermaidThemePrototype from '../../sections/prototype/MermaidThemePrototype.astro'

// Dummy e-commerce schema — five tables, mix of confirmed FKs (solid `--`) and
// one naming-convention-inferred FK (dashed `..`) to preview /erd's confidence
// encoding (DbEdge.confidence -> Mermaid's native relationship syntax).
const DIAGRAM = `erDiagram
  direction LR
  USERS ||--o{ ORDERS : places
  ORDERS ||--|{ ORDER_ITEMS : contains
  PRODUCTS ||--o{ ORDER_ITEMS : "line item for"
  CATEGORIES ||--o{ PRODUCTS : groups
  PRODUCTS ||..o{ ORDER_ITEMS : "sku_ref (inferred)"

  USERS {
    int id PK
    string email
    string name
    datetime created_at
  }
  ORDERS {
    int id PK
    int user_id FK
    string status
    numeric total_cents
    datetime created_at
  }
  ORDER_ITEMS {
    int id PK
    int order_id FK
    int product_id FK
    int quantity
    numeric unit_price_cents
  }
  PRODUCTS {
    int id PK
    int category_id FK
    string sku
    string title
    numeric price_cents
  }
  CATEGORIES {
    int id PK
    string name
    string slug
  }`

const VARIANTS = ['A', 'B', 'C', 'D', 'E']
const LABELS: Record<string, string> = {
  A: 'Dark neon (locked — dark mode)',
  B: 'Brand indigo / light (locked — light mode)',
  C: 'Mermaid forest',
  D: 'Mermaid neutral',
  E: 'High-contrast dracula',
}

interface ThemeDef {
  mermaidTheme: string
  themeVariables?: Record<string, string>
  containerBg: string
  containerBorder: string
}

const THEMES: Record<string, ThemeDef> = {
  A: {
    mermaidTheme: 'dark',
    themeVariables: {
      background: '#0a111e',
      primaryColor: '#15263f',
      primaryBorderColor: '#3aa0ff',
      primaryTextColor: '#e6f1ff',
      lineColor: '#4cc9f0',
      secondaryColor: '#0e2138',
      tertiaryColor: '#111c2e',
    },
    containerBg: 'radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%)',
    containerBorder: '#2b3a52',
  },
  B: {
    mermaidTheme: 'base',
    themeVariables: {
      background: '#ffffff',
      primaryColor: '#eef2ff',
      primaryBorderColor: '#6366f1',
      primaryTextColor: '#312e81',
      lineColor: '#6366f1',
      secondaryColor: '#e0e7ff',
      tertiaryColor: '#f5f3ff',
    },
    containerBg: '#ffffff',
    containerBorder: '#e0e7ff',
  },
  C: {
    mermaidTheme: 'forest',
    containerBg: '#f0fdf4',
    containerBorder: '#bbf7d0',
  },
  D: {
    mermaidTheme: 'neutral',
    containerBg: '#fafafa',
    containerBorder: '#e5e7eb',
  },
  E: {
    mermaidTheme: 'dark',
    themeVariables: {
      background: '#1a1025',
      primaryColor: '#2d1b3d',
      primaryBorderColor: '#c084fc',
      primaryTextColor: '#f3e8ff',
      lineColor: '#f472b6',
      secondaryColor: '#3b1f4d',
      tertiaryColor: '#241633',
    },
    containerBg: 'radial-gradient(circle at 28% 18%, #2d1b3d, #1a1025 72%)',
    containerBorder: '#4c2a5e',
  },
}

const requested = (Astro.url.searchParams.get('theme') ?? 'A').toUpperCase()
const current = VARIANTS.includes(requested) ? requested : 'A'
const theme = THEMES[current]
---

<Base title="/erd — dummy DB preview" subtitle="Sample output, DB-schema diagram" template="system">
  <div class="space-y-6">
    <p class="proto-banner">
      🧪 Demo route — box/connector styling is locked (Mermaid default
      erDiagram lines, no CSS override). Color theme below is just for
      browsing at your request; the actual locked answer is adaptive
      dark-neon (A) in dark mode / light-indigo (B) in light mode, not
      whichever one you're previewing here.
    </p>

    <div class="theme-picker">
      {VARIANTS.map((v) => (
        <a href={`?theme=${v}`} class:list={['theme-pill', { active: v === current }]}>
          {v} — {LABELS[v]}
        </a>
      ))}
    </div>

    <h2 class="theme-proto-heading">Dummy schema — 5 tables, 1 inferred FK</h2>

    <MermaidThemePrototype
      diagram={DIAGRAM}
      mermaidTheme={theme.mermaidTheme}
      themeVariables={theme.themeVariables}
      containerBg={theme.containerBg}
      containerBorder={theme.containerBorder}
    />
  </div>
</Base>

<style>
  .proto-banner {
    font-size: 0.8125rem;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin: 0;
  }
  :global(.dark) .proto-banner {
    color: #fbbf24;
    background: #422006;
    border-color: #78350f;
  }
  .theme-proto-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
  }
  :global(.dark) .theme-proto-heading {
    color: #e5e7eb;
  }
  .theme-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .theme-pill {
    font-size: 0.8125rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #d1d5db;
    color: #374151;
    text-decoration: none;
    background: #f9fafb;
  }
  .theme-pill.active {
    border-color: #6366f1;
    color: #4338ca;
    background: #eef2ff;
    font-weight: 600;
  }
  :global(.dark) .theme-pill {
    border-color: #374151;
    color: #d1d5db;
    background: #1f2937;
  }
  :global(.dark) .theme-pill.active {
    border-color: #4cc9f0;
    color: #e6f1ff;
    background: #15263f;
  }
</style>
