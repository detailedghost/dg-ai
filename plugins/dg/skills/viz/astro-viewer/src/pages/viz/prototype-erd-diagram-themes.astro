---
// PROTOTYPE — throwaway route, see .agents/prototype/erd-diagram-themes/NOTES.md
// Answers: what color theme should the /erd Mermaid diagram section use?
import Base from '../../layouts/Base.astro'
import PrototypeSwitcher from '../../components/PrototypeSwitcher.astro'
import MermaidThemePrototype from '../../sections/prototype/MermaidThemePrototype.astro'

const VARIANTS = ['A', 'B', 'C', 'D', 'E']
const LABELS = {
  A: 'Dark neon (current baseline)',
  B: 'Brand indigo / light',
  C: 'Mermaid forest',
  D: 'Mermaid neutral',
  E: 'High-contrast dracula',
}
const variant = (Astro.url.searchParams.get('variant') ?? 'A').toUpperCase()
const current = VARIANTS.includes(variant) ? variant : 'A'

const diagram = `erDiagram
  USERS ||--o{ ORDERS : places
  ORDERS ||--|{ LINE_ITEMS : contains
  PRODUCTS ||--o{ LINE_ITEMS : "referenced by"
  USERS {
    int id
    string email
    string name
  }
  ORDERS {
    int id
    int user_id
    string status
    datetime created_at
  }
  LINE_ITEMS {
    int id
    int order_id
    int product_id
    int quantity
  }
  PRODUCTS {
    int id
    string sku
    string title
  }`

interface ThemeDef {
  mermaidTheme: string
  themeVariables?: Record<string, string>
  containerBg: string
  containerBorder: string
}

const THEMES: Record<string, ThemeDef> = {
  A: {
    mermaidTheme: 'dark',
    themeVariables: {
      background: '#0a111e',
      primaryColor: '#15263f',
      primaryBorderColor: '#3aa0ff',
      primaryTextColor: '#e6f1ff',
      lineColor: '#4cc9f0',
      secondaryColor: '#0e2138',
      tertiaryColor: '#111c2e',
    },
    containerBg: 'radial-gradient(circle at 28% 18%, #15263f, #0a111e 72%)',
    containerBorder: '#2b3a52',
  },
  B: {
    mermaidTheme: 'base',
    themeVariables: {
      background: '#ffffff',
      primaryColor: '#eef2ff',
      primaryBorderColor: '#6366f1',
      primaryTextColor: '#312e81',
      lineColor: '#6366f1',
      secondaryColor: '#e0e7ff',
      tertiaryColor: '#f5f3ff',
    },
    containerBg: '#ffffff',
    containerBorder: '#e0e7ff',
  },
  C: {
    mermaidTheme: 'forest',
    containerBg: '#f0fdf4',
    containerBorder: '#bbf7d0',
  },
  D: {
    mermaidTheme: 'neutral',
    containerBg: '#fafafa',
    containerBorder: '#e5e7eb',
  },
  E: {
    mermaidTheme: 'dark',
    themeVariables: {
      background: '#1a1025',
      primaryColor: '#2d1b3d',
      primaryBorderColor: '#c084fc',
      primaryTextColor: '#f3e8ff',
      lineColor: '#f472b6',
      secondaryColor: '#3b1f4d',
      tertiaryColor: '#241633',
    },
    containerBg: 'radial-gradient(circle at 28% 18%, #2d1b3d, #1a1025 72%)',
    containerBorder: '#4c2a5e',
  },
}

const theme = THEMES[current]
---

<Base title="/erd diagram themes — prototype" subtitle="Mermaid color theme comparison" template="system">
  <div class="space-y-6">
    <p class="proto-banner">
      🧪 Prototype route — follow-up to erd-viz-sections (Evidence tab: B won).
      Comparing 5 Mermaid color themes for the diagram section. Same ER
      diagram, only mermaid.initialize() theme/themeVariables change.
    </p>

    <h2 class="theme-proto-heading">{LABELS[current]}</h2>

    <MermaidThemePrototype
      diagram={diagram}
      mermaidTheme={theme.mermaidTheme}
      themeVariables={theme.themeVariables}
      containerBg={theme.containerBg}
      containerBorder={theme.containerBorder}
    />
  </div>

  <PrototypeSwitcher
    variants={VARIANTS}
    current={current}
    prototypeName="erd-diagram-themes"
    labels={LABELS}
    basePath="/api"
  />
</Base>

<style>
  .proto-banner {
    font-size: 0.8125rem;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin: 0;
  }
  :global(.dark) .proto-banner {
    color: #fbbf24;
    background: #422006;
    border-color: #78350f;
  }
  .theme-proto-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
  }
  :global(.dark) .theme-proto-heading {
    color: #e5e7eb;
  }
</style>

<script>
  window.addEventListener('popstate', () => {
    location.reload()
  })
</script>
