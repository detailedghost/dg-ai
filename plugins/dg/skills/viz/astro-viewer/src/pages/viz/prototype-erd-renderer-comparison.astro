---
// PROTOTYPE — throwaway route, see .agents/prototype/erd-renderer-comparison/NOTES.md
// Answers: should /erd's two diagram types (DB-schema ER diagram + code/import
// flowchart) render via Mermaid (current spec baseline), D2, or
// Cytoscape+dagre? Same fixed sample data renders through all three engines
// so the comparison is about renderer aesthetics + integration cost, not data.
import Base from "../../layouts/Base.astro"
import PrototypeSwitcher from "../../components/PrototypeSwitcher.astro"
import MermaidErConnectorPrototype from "../../sections/prototype/MermaidErConnectorPrototype.astro"
import MermaidRawPrototype from "../../sections/prototype/MermaidRawPrototype.astro"
import D2Prototype from "../../sections/prototype/D2Prototype.astro"
import CytoscapeFlowPrototype from "../../sections/prototype/CytoscapeFlowPrototype.astro"
import CytoscapeErCardsPrototype from "../../sections/prototype/CytoscapeErCardsPrototype.astro"
import { renderD2 } from "../../lib/renderD2.ts"

const VARIANTS = ["1", "2", "3"]
const LABELS = {
  "1": "Mermaid (current spec baseline)",
  "2": "D2",
  "3": "Cytoscape + dagre",
}
const variant = Astro.url.searchParams.get("variant") ?? "1"
const current = VARIANTS.includes(variant) ? variant : "1"

// ── Fixed sample data, shared across all three variants ──────────────────────
const FLOW_NODES = [
  { id: "CLI", label: "CLI" },
  { id: "Resolve", label: "Resolve" },
  { id: "CodeGraph", label: "Code Graph" },
  { id: "ImportGraph", label: "Import Graph" },
  { id: "Render", label: "Render" },
]
const FLOW_EDGES = [
  { from: "CLI", to: "Resolve" },
  { from: "Resolve", to: "CodeGraph" },
  { from: "Resolve", to: "ImportGraph" },
  { from: "CodeGraph", to: "Render" },
  { from: "ImportGraph", to: "Render" },
]

const TABLES = [
  {
    id: "funds",
    name: "FUNDS",
    columns: [
      { name: "id", type: "int", pk: true },
      { name: "name", type: "string" },
      { name: "nav", type: "decimal" },
    ],
  },
  {
    id: "securities",
    name: "SECURITIES",
    columns: [
      { name: "id", type: "int", pk: true },
      { name: "ticker", type: "string" },
      { name: "asset_class", type: "string" },
    ],
  },
  {
    id: "positions",
    name: "POSITIONS",
    columns: [
      { name: "id", type: "int", pk: true },
      { name: "fund_id", type: "int", fk: true },
      { name: "security_id", type: "int", fk: true },
      { name: "quantity", type: "decimal" },
      { name: "as_of_date", type: "date" },
    ],
  },
]
const RELATIONS = [
  { from: "positions", to: "funds" },
  { from: "positions", to: "securities" },
]

// ── Variant 1: Mermaid — locked styling per the current /erd spec baseline ──
// erDiagram default line styling (no CSS override); flowchart uses variant C's
// UML-sharp rectangles + thin labeled arrows.
const MERMAID_SCHEMA = `erDiagram
  FUNDS ||--o{ POSITIONS : has
  SECURITIES ||--o{ POSITIONS : "referenced by"
  FUNDS {
    int id PK
    string name
    decimal nav
  }
  SECURITIES {
    int id PK
    string ticker
    string asset_class
  }
  POSITIONS {
    int id PK
    int fund_id FK
    int security_id FK
    decimal quantity
    date as_of_date
  }`

const MERMAID_FLOW = `graph LR
  CLI[CLI]
  Resolve[Resolve]
  CodeGraph[Code Graph]
  ImportGraph[Import Graph]
  Render[Render]

  CLI -->|invokes| Resolve
  Resolve -->|walks| CodeGraph
  Resolve -->|scans| ImportGraph
  CodeGraph -->|feeds| Render
  ImportGraph -->|feeds| Render`

// ── Variant 2: D2 — server-side render, see ../../lib/renderD2.ts ────────────
const D2_SCHEMA = `
funds: {
  shape: sql_table
  class: node-style
  id: int {constraint: primary_key}
  name: string
  nav: decimal
}
securities: {
  shape: sql_table
  class: node-style
  id: int {constraint: primary_key}
  ticker: string
  asset_class: string
}
positions: {
  shape: sql_table
  class: node-style
  id: int {constraint: primary_key}
  fund_id: int {constraint: foreign_key}
  security_id: int {constraint: foreign_key}
  quantity: decimal
  as_of_date: date
}

positions.fund_id -> funds.id: {class: edge-style}
positions.security_id -> securities.id: {class: edge-style}
`

const D2_FLOW = `
direction: right
CLI: CLI { class: node-style }
Resolve: Resolve { class: node-style }
CodeGraph: Code Graph { class: node-style }
ImportGraph: Import Graph { class: node-style }
Render: Render { class: node-style }

CLI -> Resolve: {class: edge-style}
Resolve -> CodeGraph: {class: edge-style}
Resolve -> ImportGraph: {class: edge-style}
CodeGraph -> Render: {class: edge-style}
ImportGraph -> Render: {class: edge-style}
`

// Only compile D2 when it's the variant actually being viewed — the WASM
// engine boot + compile isn't free, no need to pay it on every request.
let d2SchemaSvg = ""
let d2FlowSvg = ""
if (current === "2") {
  ;[d2SchemaSvg, d2FlowSvg] = await Promise.all([renderD2(D2_SCHEMA), renderD2(D2_FLOW)])
}
---

<Base title="/erd renderer comparison" subtitle="Mermaid vs D2 vs Cytoscape+dagre" template="system">
  <div class="space-y-6">
    <p class="proto-banner">
      🧪 Prototype route — same fixed sample data (3-table DB schema + 5-node
      code/import graph) rendered through three different diagram engines, to
      decide which /erd should use. This compares renderer aesthetics and
      integration cost, not colors — palette is held as consistent as each
      library's API allows.
    </p>

    <h2 class="theme-proto-heading">{LABELS[current as keyof typeof LABELS]}</h2>

    {
      current === "1" && (
        <div class="space-y-4">
          <div>
            <h3 class="theme-proto-subheading">DB schema</h3>
            <MermaidErConnectorPrototype diagram={MERMAID_SCHEMA} />
          </div>
          <div>
            <h3 class="theme-proto-subheading">Code / import graph</h3>
            <MermaidRawPrototype diagram={MERMAID_FLOW} />
          </div>
        </div>
      )
    }

    {current === "2" && <D2Prototype schemaSvg={d2SchemaSvg} flowSvg={d2FlowSvg} />}

    {
      current === "3" && (
        <div class="space-y-4">
          <div>
            <h3 class="theme-proto-subheading">DB schema (half-solution — see NOTES.md)</h3>
            <CytoscapeErCardsPrototype tables={TABLES} relations={RELATIONS} />
          </div>
          <div>
            <h3 class="theme-proto-subheading">Code / import graph</h3>
            <CytoscapeFlowPrototype nodes={FLOW_NODES} edges={FLOW_EDGES} />
          </div>
        </div>
      )
    }
  </div>

  <PrototypeSwitcher
    variants={VARIANTS}
    current={current}
    prototypeName="erd-renderer-comparison"
    labels={LABELS}
    basePath="/api"
  />
</Base>

<style>
  .proto-banner {
    font-size: 0.8125rem;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin: 0;
  }
  :global(.dark) .proto-banner {
    color: #fbbf24;
    background: #422006;
    border-color: #78350f;
  }
  .theme-proto-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
  }
  :global(.dark) .theme-proto-heading {
    color: #e5e7eb;
  }
  .theme-proto-subheading {
    margin: 0 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #6b7280;
  }
  :global(.dark) .theme-proto-subheading {
    color: #9ca3af;
  }
</style>

<script>
  window.addEventListener("popstate", () => {
    location.reload()
  })
</script>
