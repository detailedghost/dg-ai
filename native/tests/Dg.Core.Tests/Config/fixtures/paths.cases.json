[
  {
    "name": "linux-default",
    "platform": "linux",
    "home": "/home/u",
    "env": {}
  },
  {
    "name": "linux-xdg",
    "platform": "linux",
    "home": "/home/u",
    "env": {
      "XDG_CONFIG_HOME": "/xdg/config",
      "XDG_DATA_HOME": "/xdg/data",
      "XDG_STATE_HOME": "/xdg/state",
      "XDG_CACHE_HOME": "/xdg/cache"
    }
  },
  {
    "name": "linux-xdg-relative-ignored",
    "platform": "linux",
    "home": "/home/u",
    "env": {
      "XDG_CONFIG_HOME": "rel/config",
      "XDG_STATE_HOME": ""
    }
  },
  {
    "name": "linux-dg-home",
    "platform": "linux",
    "home": "/home/u",
    "env": {
      "DG_HOME": "/srv/dg",
      "XDG_CONFIG_HOME": "/xdg/config"
    }
  },
  {
    "name": "linux-dg-home-dots",
    "platform": "linux",
    "home": "/home/u",
    "env": {
      "DG_HOME": "/srv/x/../dg/./home/"
    }
  },
  {
    "name": "darwin-default",
    "platform": "darwin",
    "home": "/Users/u",
    "env": {
      "XDG_CONFIG_HOME": "/ignored"
    }
  },
  {
    "name": "darwin-dg-home",
    "platform": "darwin",
    "home": "/Users/u",
