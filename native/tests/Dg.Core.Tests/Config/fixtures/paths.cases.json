    "name": "win32-appdata",
    "platform": "win32",
    "home": "C:\\Users\\u",
    "env": {
      "LOCALAPPDATA": "D:\\Local",
      "APPDATA": "D:\\Roam",
      "USERPROFILE": "D:\\Profile"
    }
  },
  {
    "name": "win32-dg-home",
    "platform": "win32",
    "home": "C:\\Users\\u",
    "env": {
      "DG_HOME": "E:\\dg"
    }
  },
