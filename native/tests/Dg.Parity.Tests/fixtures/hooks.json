[
	{
		"name": "spelling-write-findings",
		"hook": "spelling",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "src/a.ts",
				"content": "analyse the colour\nColour colour COLOUR\nbehaviour\n"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "spelling-multiedit",
		"hook": "spelling",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "MultiEdit",
			"tool_input": {
				"file_path": "src/m.ts",
				"edits": [
					{
						"old_string": "a",
						"new_string": "first colour"
					},
					{
						"old_string": "b",
						"new_string": "second\nthird behaviour"
					}
				]
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "spelling-clean",
		"hook": "spelling",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "src/a.ts",
				"content": "color center\n"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "spelling-locale-gb",
		"hook": "spelling",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "src/a.ts",
				"content": "color analyze among amongst\n"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		},
		"config": "[hooks.spelling]\nlocale = \"en-GB\"\n"
	},
	{
		"name": "spelling-max-two",
		"hook": "spelling",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "src/a.ts",
				"content": "colour behaviour analyse neighbour favour honour\n"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		},
		"env": {
			"HOOK_SPELLING_MAX_FINDINGS": "2"
		}
	},
	{
		"name": "spelling-bad-json",
		"hook": "spelling",
		"stdin": "not json"
	},
	{
		"name": "spelling-empty-stdin",
		"hook": "spelling",
		"stdin": ""
	},
	{
		"name": "format-unknown-extension",
		"hook": "format",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "notes.unknownext",
				"content": "x"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "format-missing-file",
		"hook": "format",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Edit",
			"tool_input": {
				"file_path": "$CWD/work/missing.py",
				"old_string": "a",
				"new_string": "b"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "pr-confirm-gh-pr-create",
		"hook": "pr-confirm",
		"event": {
			"hook_event_name": "PreToolUse",
			"tool_name": "Bash",
			"tool_input": {
				"command": "gh pr create --fill"
			},
			"cwd": "$CWD/work"
		}
	},
	{
		"name": "pr-confirm-not-a-pr",
		"hook": "pr-confirm",
		"event": {
			"hook_event_name": "PreToolUse",
			"tool_name": "Bash",
			"tool_input": {
				"command": "git status"
			},
			"cwd": "$CWD/work"
		}
	},
	{
		"name": "pr-confirm-not-json",
		"hook": "pr-confirm",
		"stdin": "{not json"
	},
	{
		"name": "strip-needs-file",
		"hook": "strip-ai-coauthors"
	},
	{
		"name": "daily-prune-dry-run-needs-now",
		"hook": "daily-prune",
		"args": [
			"--dry-run"
		],
		"stdin": ""
	},
	{
		"name": "spec-plan-lint-not-a-plan",
		"hook": "spec-plan-lint",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "$CWD/work/README.md",
				"content": "x"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		}
	},
	{
		"name": "spec-plan-lint-plan-path",
		"hook": "spec-plan-lint",
		"event": {
			"hook_event_name": "PostToolUse",
			"tool_name": "Write",
			"tool_input": {
				"file_path": "$CWD/repo/.agents/spec/027_x/plan.md",
				"content": "x"
			},
			"cwd": "$CWD/work",
			"session_id": "evsess"
		},
		"files": {
			"repo/.agents/spec/027_x/plan.md": "# plan\n"
		},
		"viaCore": true
	},
	{
		"name": "unknown-hook-id",
		"argv": [
			"hooks",
			"run",
			"no-such-hook"
		],
		"stdin": "{}",
		"viaCore": true
	},
	{
		"name": "hooks-run-without-id",
		"argv": [
			"hooks",
			"run"
		],
		"stdin": "",
		"viaCore": true
	},
	{
		"name": "hooks-list",
		"argv": [
			"hooks",
			"list"
		],
		"viaCore": true
	}
]
