== log 644
biome format --write <ROOT>/work/a.ts | cwd=-

== work/.git/HEAD 644

== work/a.ts 644
x

== work/node_modules/.bin/biome 755
#!/bin/sh
case "$PWD" in "$FIXTURE_ROOT"*) c=${PWD#"$FIXTURE_ROOT"};; *) c=-;; esac
printf '%s %s | cwd=%s\n' "${0##*/}" "$*" "$c" >> "$FIXTURE_ROOT/log"
case "$1" in format) echo broken >&2; exit 2;; esac

