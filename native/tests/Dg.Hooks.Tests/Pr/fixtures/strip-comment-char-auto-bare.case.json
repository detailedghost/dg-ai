{
	"hook": "strip-ai-coauthors",
	"posixOnly": true,
	"args": [
		"$CWD/repo/COMMIT_EDITMSG"
	],
	"cwd": "repo",
	"env": {
		"PATH": "$CWD/bin:/usr/bin:/bin",
		"GIT_CONFIG_GLOBAL": "/dev/null",
		"GIT_CONFIG_NOSYSTEM": "1"
	},
	"config": "[hooks.strip-ai-coauthors]\nenabled = \"on\"\n",
	"files": {
		"repo/.git/HEAD": "ref: refs/heads/main\n",
		"repo/.git/objects/": "",
		"repo/.git/refs/": "",
		"repo/.git/config": "[core]\n\tcommentChar = auto\n",
		"repo/COMMIT_EDITMSG": "subject\n\n#hash line\nCo-Authored-By: Claude <noreply@anthropic.com>\n"
	}
}
