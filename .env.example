DG_HOME=/absolute/path/to/a/dg/home
DG_SKILLS=/absolute/path/to/a/dg/home/bin/dg-skills
CR_ENV=dev
# Fallbacks only: channel-review reads these secrets from the dg credential store first.
# Store them with: dg-skills channel-review connect <relay|datadog|sentry>, or migrate-env.
CHANNEL_REVIEW_RELAY_SECRET_DEV=
DATADOG_ACCESS_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_BASE_URL=
